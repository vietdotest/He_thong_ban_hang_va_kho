<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="vi"><head><meta name="viewport" content="width=device-width,initial-scale=1"><title>Nhà cung cấp</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/app.css"></head><body class="app-page"><%@ include file="../fragments/sidebar.jspf" %><main class="page-body app-content"><h1>Nhà cung cấp</h1><form method="get"><label>Tìm mã/tên <input name="q" value="<c:out value='${param.q}'/>"></label><button class="button">Tìm</button></form><c:if test="${access.allows('WAREHOUSE_MANAGE')}"><section class="content-panel"><h2>${empty edit ? 'Thêm nhà cung cấp' : 'Sửa nhà cung cấp'}</h2><form method="post" class="account-form"><input type="hidden" name="_csrf" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="id" value="${edit.id}"><input type="hidden" name="version" value="${edit.version}"><label class="field">Mã <input name="code" required maxlength="50" value="<c:out value='${edit.code}'/>"></label><label class="field">Tên <input name="name" required maxlength="200" value="<c:out value='${edit.name}'/>"></label><label class="field">Mã số thuế <input name="taxCode" required maxlength="14" value="<c:out value='${edit.tax_code}'/>"></label><label class="field">Người liên hệ <input name="contact" required maxlength="150" value="<c:out value='${edit.contact_name}'/>"></label><label class="field">Điện thoại <input name="phone" required maxlength="20" value="<c:out value='${edit.contact_phone}'/>"></label><label class="field">Điều khoản thanh toán <input name="terms" required maxlength="250" value="<c:out value='${edit.payment_terms}'/>"></label><label class="field">Kho <select name="warehouse" required><c:forEach items="${warehouses}" var="w"><option value="${w.id}" ${edit.warehouse_id == w.id ? 'selected' : ''}><c:out value="${w.name}"/></option></c:forEach></select></label><label class="field">Trạng thái <select name="status"><option value="ACTIVE">Đang giao dịch</option><option value="DISCONTINUED" ${edit.status == 'DISCONTINUED' ? 'selected' : ''}>Ngừng giao dịch</option></select></label><button class="button button-primary">Lưu nhà cung cấp</button></form></section></c:if><div class="table-wrap"><table><thead><tr><th>Mã</th><th>Tên</th><th>Mã số thuế</th><th>Liên hệ</th><th>Thanh toán</th><th>Kho</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody><c:forEach items="${suppliers}" var="p"><tr><td><c:out value="${p.code}"/></td><td><c:out value="${p.name}"/></td><td><c:out value="${p.tax_code}"/></td><td><c:out value="${p.contact_name}"/> — <c:out value="${p.contact_phone}"/></td><td><c:out value="${p.payment_terms}"/></td><td><c:out value="${p.warehouse_name}"/></td><td>${p.status == 'ACTIVE' ? 'Đang giao dịch' : 'Ngừng giao dịch'}</td><td><c:if test="${access.allows('WAREHOUSE_MANAGE')}"><a href="?id=${p.id}">Sửa / ngừng giao dịch</a><form method="post"><input type="hidden" name="_csrf" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="id" value="${p.id}"><input type="hidden" name="action" value="delete"><button class="button">Xóa</button></form></c:if></td></tr></c:forEach></tbody></table></div></main></body></html>
