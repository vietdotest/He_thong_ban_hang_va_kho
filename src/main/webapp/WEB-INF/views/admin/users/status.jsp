<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="vi"><head><meta name="viewport" content="width=device-width,initial-scale=1"><title>Khóa và mở tài khoản</title><%@ include file="../../fragments/assets.jspf" %></head><body class="app-page" data-view="admin/users/status" data-ui-css=""><%@ include file="../../fragments/sidebar.jspf" %>
<%@ include file="../../fragments/topbar.jspf" %><main class="page-body app-content"><h1>Khóa và mở tài khoản</h1><c:if test="${param.notice == 'saved'}"><div class="alert alert-success" role="status">Đã cập nhật trạng thái tài khoản.</div></c:if><c:if test="${not empty formError}"><div class="alert alert-error" role="alert"><c:out value="${formError}"/></div></c:if><section class="content-panel padded-panel"><h2><c:out value="${target.full_name}"/></h2><p>Tài khoản: <c:out value="${target.username}"/></p><p>Trạng thái: <span class="badge ${target.status == 'ACTIVE' ? 'badge-success' : 'badge-neutral'}">${target.status == 'ACTIVE' ? 'Hoạt động' : target.status == 'ADMIN_LOCKED' ? 'Bị khóa' : target.status == 'PENDING_ACTIVATION' ? 'Chờ kích hoạt' : 'Vô hiệu hóa'}</span></p><p>Lý do khóa: <c:out value="${target.lock_reason}"/></p><c:if test="${assignmentCount > 0}"><section class="alert alert-warning" aria-label="Cảnh báo bàn giao"><h2>${target.status == 'ADMIN_LOCKED' ? 'Cần bàn giao đại lý sau khi khóa' : 'Cần xem xét bàn giao trước khi khóa'}</h2><p>Nhân viên đang phụ trách <strong>${assignmentCount}</strong> đại lý. ${assignmentCount > 20?'Hiển thị 20 đại lý đầu tiên.':''}</p><c:choose><c:when test="${canHandover}"><a class="button button-primary" href="${pageContext.request.contextPath}/dealers/handover?fromStaff=${target.id}">Bàn giao ngay</a></c:when><c:otherwise><button type="button" class="button" disabled>Bàn giao ngay</button><p>Chỉ Quản lý kinh doanh có quyền bàn giao được thực hiện. Liên hệ người phụ trách để bàn giao.</p></c:otherwise></c:choose><c:forEach var="w" items="${warnings}"><p><strong><c:out value="${w.code}"/></strong> — <c:out value="${w.name}"/>: <c:out value="${w.reason}"/><c:if test="${canHandover}"> <a href="${pageContext.request.contextPath}/dealers/handover?fromStaff=${target.id}&amp;dealerId=${w.id}">Bàn giao đại lý này</a></c:if></p></c:forEach></section></c:if><form method="post" class="form-stack"><input type="hidden" name="_csrf" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="id" value="${target.id}"><c:choose><c:when test="${target.status == 'ADMIN_LOCKED'}"><input type="hidden" name="action" value="unlock"><button class="button button-primary">Mở khóa</button></c:when><c:otherwise><input type="hidden" name="action" value="lock"><label class="field">Lý do khóa <textarea name="reason" required maxlength="1000"><c:out value="${reason}"/></textarea></label><button class="button button-primary">Khóa và kết thúc mọi phiên</button></c:otherwise></c:choose></form><a class="button button-secondary" href="${pageContext.request.contextPath}/admin/users">Về danh sách</a></section></main></body></html>
