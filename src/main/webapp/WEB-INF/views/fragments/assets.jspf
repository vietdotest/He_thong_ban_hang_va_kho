<c:if test="${empty csrfToken}"><c:set var="csrfToken" value="${sessionScope['security.csrfToken']}" scope="request"/></c:if>
<link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/ui.css?v=${applicationScope.assetVersion}">
<script src="${pageContext.request.contextPath}/assets/js/navigation.js?v=${applicationScope.assetVersion}" defer></script>
<script src="${pageContext.request.contextPath}/assets/js/forms.js?v=${applicationScope.assetVersion}" data-app-context="${pageContext.request.contextPath}" defer></script>
