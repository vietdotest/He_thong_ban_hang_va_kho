<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="vi"><head><meta name="viewport" content="width=device-width,initial-scale=1"><title>Đơn vị quy đổi</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/app.css?v=sprint2-20261001"></head><body class="app-page"><%@ include file="../fragments/sidebar.jspf" %><main class="page-body app-content"><h1>Đơn vị quy đổi</h1><form method="get"><label>Tìm SKU <input name="q" value="<c:out value='${param.q}'/>"></label><button class="button">Tìm</button></form><form method="get"><label>Sản phẩm <select name="product"><c:forEach items="${products}" var="p"><option value="${p.id}" ${p.id == productId ? 'selected' : ''}><c:out value="${p.sku}"/> — <c:out value="${p.name}"/></option></c:forEach></select></label><button class="button">Xem đơn vị</button></form><c:if test="${not empty conversion}"><div class="alert"><c:out value="${conversion}"/></div></c:if><c:if test="${productId > 0 and access.allows('WAREHOUSE_MANAGE')}"><h2>Thêm đơn vị</h2><form method="post" class="account-form"><input type="hidden" name="_csrf" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="product" value="${productId}"><label class="field">Tên đơn vị <input name="name" maxlength="50" required></label><label class="field">Hệ số <input name="factor" type="number" min="0.000001" step="0.000001" required></label><label class="field">Kho phụ trách <select name="warehouse" required><c:forEach items="${warehouses}" var="w"><option value="${w.id}"><c:out value="${w.name}"/></option></c:forEach></select></label><button class="button button-primary">Thêm đơn vị</button></form></c:if><div class="table-wrap"><table><thead><tr><th>Đơn vị</th><th>Hệ số</th><th>Phiên bản</th><th>Kho</th><th>Thao tác</th></tr></thead><tbody><c:forEach items="${units}" var="u"><tr><td><c:out value="${u.name}"/></td><td><c:out value="${u.factor}"/></td><td><c:out value="${u.version}"/></td><td><c:out value="${u.warehouse_name}"/></td><td><c:if test="${not empty u.warehouse_id and access.allows('WAREHOUSE_MANAGE')}"><form method="post"><input type="hidden" name="_csrf" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="id" value="${u.id}"><input type="hidden" name="product" value="${productId}"><input type="hidden" name="version" value="${u.version}"><input type="hidden" name="warehouse" value="${u.warehouse_id}"><label>Đơn vị <input name="name" value="<c:out value='${u.name}'/>" required></label><label>Hệ số <input name="factor" type="number" step="0.000001" min="0.000001" value="${u.factor}" required></label><button class="button">Cập nhật</button><button class="button" name="action" value="delete">Xóa</button></form></c:if><form method="get"><input type="hidden" name="id" value="${u.id}"><input type="hidden" name="product" value="${productId}"><input type="hidden" name="action" value="convert"><label>Số lượng <input name="quantity" type="number" min="0" step="0.000001" required></label><button class="button">Quy đổi</button></form></td></tr></c:forEach></tbody></table></div></main></body></html>

