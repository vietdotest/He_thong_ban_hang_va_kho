<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %><fmt:setLocale value="vi_VN"/>
<!doctype html><html lang="vi"><head><meta name="viewport" content="width=device-width,initial-scale=1"><title>Đơn hàng | Quản lý bán hàng</title><%@ include file="../fragments/assets.jspf" %></head><body class="app-page"><%@ include file="../fragments/sidebar.jspf" %><%@ include file="../fragments/topbar.jspf" %>
<main class="page-body app-content catalog-page"><div class="page-heading"><div><h1>Đơn hàng</h1><p>Nháp → xác nhận hoặc duyệt ngoại lệ → giữ hàng → xuất/giao từng phần → hóa đơn. Đơn cổng chỉ giữ sau người tiếp nhận cuối cùng.</p></div><c:if test="${access.allows(portalMode?'PORTAL_ORDER_WRITE':'ORDER_WRITE')}"><a class="button button-primary" href="${pageContext.request.contextPath}${orderPath}?action=new">Tạo đơn nháp</a></c:if></div>
<form method="get" class="filter-form"><label class="filter-search">Tìm số đơn / mã / tên đại lý <input name="q" maxlength="150" value="<c:out value='${param.q}'/>"></label><label>Trạng thái <select name="status"><option value="">Tất cả</option><option value="DRAFT" ${param.status=='DRAFT'?'selected':''}>Nháp</option><option value="SUBMITTED" ${param.status=='SUBMITTED'?'selected':''}>Đã gửi tiếp nhận</option><option value="PENDING_APPROVAL" ${param.status=='PENDING_APPROVAL'?'selected':''}>Chờ xác nhận / duyệt ngoại lệ</option><option value="CANCELLED" ${param.status=='CANCELLED'?'selected':''}>Đã hủy</option><option value="REJECTED" ${param.status=='REJECTED'?'selected':''}>Bị từ chối</option></select></label><c:if test="${not empty param.dealer}"><input type="hidden" name="dealer" value="<c:out value='${param.dealer}'/>"></c:if><input type="hidden" name="pageSize" value="${pagination.pageSize}"><button class="button button-primary">Tìm kiếm</button><a class="button button-secondary" href="${pageContext.request.contextPath}${orderPath}">Bỏ lọc</a></form>
<div class="table-wrap"><table><thead><tr><th>Số đơn</th><th>Đại lý</th><th>Ngày giao mong muốn</th><th>Trạng thái</th><th>Phải thu (đ)</th><th>Chi tiết</th></tr></thead><tbody><c:forEach items="${orders}" var="o"><tr><td>ĐH-${o.id}<br>${o.source=='PORTAL'?'Cổng đại lý':'Nội bộ'}</td><td><c:out value="${o.dealer_code}"/><br><c:out value="${o.dealer_name}"/><c:if test="${o.transaction_locked}"><br><span class="field-error">Đại lý hiện bị khóa</span></c:if></td><td>${o.desired_delivery}</td><td>${o.status=='DRAFT'?'Nháp':o.status=='CANCELLED'?'Đã hủy':o.status=='PENDING_APPROVAL'?(o.pending_reason=='STAFF_CONFIRMATION'?'Chờ NVKD xác nhận':'Chờ duyệt ngoại lệ'):o.status=='REJECTED'?'Bị từ chối':'Đã tiếp nhận'}</td><td><c:choose><c:when test="${o.status=='DRAFT'}">Tính lại khi mở / gửi</c:when><c:otherwise><c:out value="${o.net_formatted}"/></c:otherwise></c:choose></td><td><c:url var="detail" value="${orderPath}"><c:param name="id" value="${o.id}"/><c:param name="q" value="${param.q}"/><c:param name="status" value="${param.status}"/><c:param name="page" value="${pagination.page}"/><c:param name="pageSize" value="${pagination.pageSize}"/><c:param name="dealer" value="${param.dealer}"/></c:url><a class="button button-secondary" href="<c:out value='${detail}'/>">Mở đơn</a></td></tr></c:forEach><c:if test="${empty orders}"><tr><td colspan="6" class="empty-state">Không có đơn phù hợp trong phạm vi của bạn.</td></tr></c:if></tbody></table></div><%@ include file="../fragments/pagination.jspf" %></main></body></html>
