<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="vi"><head><meta name="viewport" content="width=device-width,initial-scale=1"><title>Cổng đại lý</title><%@ include file="../fragments/assets.jspf" %></head><body class="app-page"><%@ include file="../fragments/sidebar.jspf" %><%@ include file="../fragments/topbar.jspf" %><main class="page-body app-content catalog-page"><div class="page-heading"><div><h1>Cổng đại lý</h1><p><c:out value="${dealer.code}"/> — <c:out value="${dealer.name}"/></p></div><a class="button button-primary" href="${pageContext.request.contextPath}/portal/orders?action=new">Tạo đơn nháp</a></div><c:if test="${dealer.locked}"><p class="alert" role="note">Đại lý hiện bị khóa giao dịch: không tạo đơn mới; đơn đã tồn tại vẫn được xem và xử lý với cảnh báo.</p></c:if><p>Chỉ hiển thị dữ liệu thuộc đại lý đang liên kết và sản phẩm có giá áp dụng cho nhóm của đại lý. Chưa xử lý duyệt đơn, xuất kho hoặc ghi công nợ.</p><form method="get" class="filter-form"><label class="filter-search">Tìm SKU / tên <input name="q" maxlength="150" value="<c:out value='${param.q}'/>" data-lookup="products" data-lookup-endpoint="/api/portal/products"></label><button class="button button-primary">Tìm đầy đủ</button><input type="hidden" name="pageSize" value="${pagination.pageSize}"></form><div class="table-wrap"><table><thead><tr><th>SKU</th><th>Sản phẩm</th><th>Đơn vị cơ sở</th></tr></thead><tbody><c:forEach items="${products}" var="p"><tr><td><c:out value="${p.sku}"/></td><td><c:out value="${p.name}"/></td><td><c:out value="${p.base_unit}"/></td></tr></c:forEach><c:if test="${empty products}"><tr><td colspan="3" class="empty-state">Chưa có sản phẩm phù hợp với nhóm giá hiện tại.</td></tr></c:if></tbody></table></div><%@ include file="../fragments/pagination.jspf" %></main></body></html>
