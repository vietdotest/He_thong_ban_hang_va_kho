<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="vi"><head><meta name="viewport" content="width=device-width,initial-scale=1"><title>Phân công và bàn giao đại lý</title><%@ include file="../fragments/assets.jspf" %></head><body class="app-page"><%@ include file="../fragments/sidebar.jspf" %><%@ include file="../fragments/topbar.jspf" %><main class="page-body app-content catalog-page"><div class="page-heading"><div><h1>Phân công và bàn giao</h1><p>Xem trước toàn bộ phạm vi; xác nhận kiểm tra lại từng đại lý và ghi lịch sử.</p></div><a class="button button-secondary" href="${pageContext.request.contextPath}/dealers">Danh sách đại lý</a></div><c:if test="${not empty error}"><p class="alert alert-error" role="alert"><c:out value="${error}"/></p></c:if>
<c:choose><c:when test="${not empty batch}"><section class="content-panel padded-panel"><h2>${batch.status == 'CONFIRMED' ? 'Đã bàn giao thành công' : 'Xem trước bàn giao'}</h2><p><c:out value="${batch.from_name}"/> → <c:out value="${batch.to_name}"/> · <strong>${batch.total_items}</strong> đại lý</p><p>Lý do: <c:out value="${batch.reason}"/></p><c:if test="${batch.status=='PREVIEW'}"><p class="muted">Xác nhận áp dụng cho toàn bộ ${batch.total_items} đại lý, không chỉ trang đang mở. Bản xem trước hết hạn sau 30 phút.</p><form method="post" data-confirm="Xác nhận bàn giao toàn bộ đại lý trong bản xem trước?"><input type="hidden" name="_csrf" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="batch" value="<c:out value='${batch.batch_key}'/>"><input type="hidden" name="action" value="confirm"><button class="button button-primary">Xác nhận bàn giao</button></form></c:if><a class="button button-secondary" href="${pageContext.request.contextPath}/dealers/handover">Tạo bản bàn giao khác / lịch sử</a></section>
<div class="table-wrap"><table><thead><tr><th>Mã đại lý</th><th>Tên</th><th>Phiên bản xem trước</th><th>Phiên bản hiện tại</th><th>Kết quả</th></tr></thead><tbody><c:forEach items="${rows}" var="d"><tr><td><c:out value="${d.code}"/></td><td><c:out value="${d.name}"/></td><td>${d.before_version}</td><td>${d.version}</td><td>${not empty d.after_version ? 'Đã bàn giao' : d.version != d.before_version ? 'Đã thay đổi — cần xem trước lại' : 'Chờ xác nhận'}</td></tr></c:forEach></tbody></table></div></c:when><c:otherwise>
<section class="content-panel"><h2 class="panel-heading">Lập bản xem trước</h2><form method="post" class="account-form dealer-profile-form"><input type="hidden" name="_csrf" value="<c:out value='${csrfToken}'/>"><label class="field">Người đang phụ trách <select name="fromStaff" required><option value="">Chọn người bàn giao</option><c:forEach items="${fromStaff}" var="u"><option value="${u.id}" ${form.fromStaff==u.id.toString() ? 'selected' : ''}><c:out value="${u.code}"/> — <c:out value="${u.name}"/></option></c:forEach></select></label><label class="field">Người nhận bàn giao <select name="toStaff" required><option value="">Chọn nhân viên đang hoạt động</option><c:forEach items="${toStaff}" var="u"><option value="${u.id}" ${form.toStaff==u.id.toString() ? 'selected' : ''}><c:out value="${u.code}"/> — <c:out value="${u.name}"/></option></c:forEach></select></label><label class="field">Khu vực <select name="territory"><option value="">Tất cả khu vực của người bàn giao</option><c:forEach items="${territories}" var="t"><option value="${t.id}" ${form.territory==t.id.toString() ? 'selected' : ''}><c:out value="${t.name}"/></option></c:forEach></select></label><label class="field">Một đại lý cụ thể (để trống = toàn bộ phạm vi) <select name="dealerId" data-lookup="dealers"><option value="">Toàn bộ đại lý phù hợp</option><c:if test="${not empty form.dealerId}"><option selected value="<c:out value='${form.dealerId}'/>">Đại lý #<c:out value="${form.dealerId}"/></option></c:if></select></label><label class="field">Lý do <input name="reason" required maxlength="1000" value="<c:out value='${form.reason}'/>"></label><div class="form-actions"><button class="button button-primary">Xem trước bàn giao</button></div></form></section>
<h2>Lịch sử bàn giao</h2><div class="table-wrap"><table><thead><tr><th>Từ người</th><th>Sang người</th><th>Số đại lý</th><th>Lý do</th><th>Người thực hiện</th><th>Chi tiết</th></tr></thead><tbody><c:forEach items="${history}" var="h"><tr><td><c:out value="${h.from_name}"/></td><td><c:out value="${h.to_name}"/></td><td>${h.total_items}</td><td><c:out value="${h.reason}"/></td><td><c:out value="${h.actor_name}"/></td><td><a href="?batch=<c:out value='${h.batch_key}'/>">Lịch sử từng đại lý</a></td></tr></c:forEach><c:if test="${empty history}"><tr><td colspan="6" class="empty-state">Chưa có bàn giao đã xác nhận.</td></tr></c:if></tbody></table></div></c:otherwise></c:choose><%@ include file="../fragments/pagination.jspf" %></main></body></html>
