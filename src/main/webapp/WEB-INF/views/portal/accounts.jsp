<%@ taglib prefix="display" uri="urn:codegym:display" %>
<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<layout:page title="Tài khoản cổng đại lý" view="portal/accounts" bodyClass="app-page" css="" bare="false">
<jsp:body>
<main class="page-body app-content catalog-page"><div class="page-heading"><div><h1>Tài khoản cổng đại lý</h1><p>Mỗi tài khoản liên kết một đại lý. Không cấp quyền quản trị người dùng nội bộ.</p></div></div><c:if test="${param.notice=='saved' and empty errors}"><p class="alert alert-success" role="status">Đã hoàn tất thao tác và ghi audit.</p></c:if><c:if test="${not empty errors}"><div class="alert alert-error" role="alert"><c:forEach items="${errors}" var="e"><p><c:out value="${e.value}"/></p></c:forEach></div></c:if><section class="content-panel"><h2 class="panel-heading">Cấp tài khoản mới</h2><form method="post" action="${pageContext.request.contextPath}/dealers/accounts" class="account-form dealer-profile-form"><input type="hidden" name="_csrf" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="action" value="create"><label class="field">Đại lý <select name="dealer" data-lookup="dealers" required><option value="">Gõ mã / tên đại lý</option><c:if test="${not empty selectedDealer}"><option value="${selectedDealer.id}" selected><c:out value="${selectedDealer.code}"/> — <c:out value="${selectedDealer.name}"/></option></c:if></select></label><label class="field">Tên đăng nhập <input name="username" required maxlength="64" value="<c:out value='${form.username}'/>"><span class="field-error"><c:out value="${errors.username}"/></span></label><label class="field">Email kích hoạt <input name="email" type="email" required maxlength="254" value="<c:out value='${form.email}'/>"><span class="field-error"><c:out value="${errors.email}"/></span></label><label class="field">Họ tên <input name="fullName" required maxlength="150" value="<c:out value='${form.fullName}'/>"><span class="field-error"><c:out value="${errors.fullName}"/></span></label><label class="field">Điện thoại <input name="phone" required maxlength="30" value="<c:out value='${form.phone}'/>"><span class="field-error"><c:out value="${errors.phone}"/></span></label><div class="form-actions"><ui:button variant="primary">Cấp và gửi kích hoạt</ui:button></div></form></section><p class="alert" role="note">Email timeout chưa rõ kết quả sẽ giữ dấu lần thử và chặn gửi lại tự động. Kiểm tra SMTP trước khi xử lý; không lưu mật khẩu hoặc token rõ trong báo cáo.</p><form method="get" class="filter-form"><label class="filter-search">Tìm tài khoản / đại lý <input name="q" maxlength="150" value="<c:out value='${param.q}'/>"></label><input type="hidden" name="pageSize" value="${pagination.pageSize}"><ui:button variant="primary">Tìm kiếm</ui:button></form><div class="table-wrap"><table><thead><tr><th>Tài khoản</th><th>Đại lý</th><th>Trạng thái</th><th>Quản lý</th></tr></thead><tbody><c:forEach items="${accounts}" var="u"><tr><td><c:out value="${u.username}"/><br><c:out value="${u.full_name}"/><br><c:out value="${u.email}"/></td><td><c:out value="${u.dealer_code}"/> — <c:out value="${u.dealer_name}"/></td><td><c:out value="${u.status=='PENDING_ACTIVATION'?'Chờ kích hoạt':u.status=='ACTIVE'?'Hoạt động':u.status=='ADMIN_LOCKED'?'Bị khóa':u.status=='DISABLED'?'Vô hiệu hóa':'Không xác định'}"/></td><td><details><summary>Thao tác tài khoản</summary><form method="post" action="${pageContext.request.contextPath}/dealers/accounts"><input type="hidden" name="_csrf" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="userId" value="${u.id}"><input type="hidden" name="version" value="${not empty form and form.userId==u.id.toString()?form.version:u.version}"><label class="field">Lý do khóa / mở <input name="reason" required maxlength="1000" value="<c:out value='${not empty form and form.userId==u.id.toString()?form.reason:""}'/>"></label><button class="button button-secondary" name="action" value="${u.status=='ADMIN_LOCKED'?'unlock':'lock'}">${u.status=='ADMIN_LOCKED'?'Mở tài khoản':'Khóa tài khoản'}</button></form><c:if test="${u.status=='PENDING_ACTIVATION'}"><form method="post" action="${pageContext.request.contextPath}/dealers/accounts"><input type="hidden" name="_csrf" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="action" value="resend"><input type="hidden" name="userId" value="${u.id}"><input type="hidden" name="version" value="${not empty form and form.userId==u.id.toString()?form.version:u.version}"><p class="helper-text">Gửi lại sẽ thay mật khẩu tạm và liên kết kích hoạt cũ.</p><ui:button variant="secondary">Gửi lại kích hoạt</ui:button></form></c:if><form method="post" action="${pageContext.request.contextPath}/dealers/accounts"><input type="hidden" name="_csrf" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="action" value="relink"><input type="hidden" name="userId" value="${u.id}"><input type="hidden" name="version" value="${not empty form and form.userId==u.id.toString()?form.version:u.version}"><label class="field">Đại lý mới <select name="dealer" data-lookup="dealers" required><option value="">Tìm đại lý mới</option></select></label><label class="field">Lý do đổi liên kết <input name="reason" required maxlength="1000" value="<c:out value='${not empty form and form.userId==u.id.toString()?form.reason:""}'/>"></label><ui:button variant="secondary">Đổi liên kết và thu hồi phiên</ui:button></form><a class="button button-secondary button-small" href="${pageContext.request.contextPath}/dealers/accounts?userId=${u.id}">Lịch sử liên kết</a></details></td></tr></c:forEach><c:if test="${empty accounts}"><tr><td colspan="4" class="empty-state">Không có tài khoản đại lý phù hợp.</td></tr></c:if></tbody></table></div><ui:pagination page="${pagination}" path="${paginationPath}" pageParameter="${paginationPageParameter}" sizeParameter="${paginationSizeParameter}" filterValues="${paginationFilterValues}" extraParameters="${paginationExtraParameters}"/><c:if test="${not empty param.userId}"><h2>Lịch sử đổi liên kết</h2><c:forEach items="${linkHistory}" var="h"><p><c:out value="${h.old_code}"/> → <c:out value="${h.new_code}"/> · <c:out value="${h.reason}"/> · <c:out value="${h.actor_name}"/> · ${display:time(h.changed_at)}</p></c:forEach><c:if test="${empty linkHistory}"><p>Chưa có thay đổi liên kết.</p></c:if><ui:pagination page="${linkHistoryPagination}" path="/dealers/accounts" pageParameter="historyPage" sizeParameter="historyPageSize" filterNames="${['userId']}" label="Lịch sử" sizeLabel="Số dòng lịch sử" ariaLabel="Phân trang lịch sử liên kết"/></c:if></main>
</jsp:body>
</layout:page>
