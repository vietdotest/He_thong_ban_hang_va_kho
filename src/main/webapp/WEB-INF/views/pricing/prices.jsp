<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="vi"><head><meta name="viewport" content="width=device-width,initial-scale=1"><title>Bảng giá</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/app.css?v=sprint2-20261001"></head><body class="app-page"><%@ include file="../fragments/sidebar.jspf" %><main class="page-body app-content"><h1>Bảng giá theo nhóm khách hàng</h1><p>Hiệu lực theo ngày Việt Nam, bao gồm ngày bắt đầu và ngày kết thúc. Phiên bản đã dùng được giữ nguyên.</p><c:if test="${access.allows('PRICE_MANAGE')}"><section class="content-panel"><h2>Tạo / kế thừa phiên bản</h2><form method="post" class="account-form"><input type="hidden" name="_csrf" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="action" value="create"><label class="field">Tên <input name="name" required maxlength="150"></label><label class="field">Nhóm khách <select name="group"><c:forEach items="${groups}" var="g"><option value="${g.id}"><c:out value="${g.name}"/></option></c:forEach></select></label><label class="field">Từ ngày <input name="from" type="date" value="${today}" required></label><label class="field">Đến ngày <input name="to" type="date" required></label><label class="field">Kế thừa <select name="parent"><option value="">Bảng giá trống</option><c:forEach items="${versions}" var="v"><option value="${v.id}"><c:out value="${v.group_name}"/> — <c:out value="${v.name}"/> (#${v.id})</option></c:forEach></select></label><button class="button button-primary">Tạo phiên bản</button></form></section></c:if><div class="table-wrap"><table><thead><tr><th>Phiên bản</th><th>Nhóm</th><th>Hiệu lực</th><th>Trạng thái</th></tr></thead><tbody><c:forEach items="${versions}" var="v"><tr><td><a href="?id=${v.id}"><c:out value="${v.name}"/> (#${v.id})</a></td><td><c:out value="${v.group_name}"/></td><td>${v.valid_from} → ${v.valid_to}</td><td>${v.used ? 'Đã dùng — chỉ kế thừa' : 'Có thể sửa'}</td></tr></c:forEach></tbody></table></div><c:if test="${not empty edit}"><h2><c:out value="${edit.name}"/></h2><c:if test="${access.allows('PRICE_MANAGE') and not edit.used}"><form method="post" class="account-form"><input type="hidden" name="_csrf" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="action" value="edit"><input type="hidden" name="id" value="${edit.id}"><input type="hidden" name="revision" value="${edit.revision}"><label class="field">Tên <input name="name" value="<c:out value='${edit.name}'/>" required></label><label class="field">Từ <input name="from" type="date" value="${edit.valid_from}" required></label><label class="field">Đến <input name="to" type="date" value="${edit.valid_to}" required></label><button class="button">Sửa hiệu lực</button></form><form method="get"><input type="hidden" name="id" value="${edit.id}"><label>Tìm SKU <input name="q" value="<c:out value='${param.q}'/>"></label><button class="button">Tìm sản phẩm</button></form><form method="post" class="account-form"><input type="hidden" name="_csrf" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="action" value="item"><input type="hidden" name="id" value="${edit.id}"><label class="field">SKU <select name="product"><c:forEach items="${products}" var="p"><option value="${p.id}"><c:out value="${p.sku}"/> — <c:out value="${p.name}"/></option></c:forEach></select></label><label class="field">Giá bán <input name="selling" type="number" step="0.0001" min="0" required></label><label class="field">Giá sàn <input name="floor" type="number" step="0.0001" min="0" required></label><button class="button button-primary">Thêm / cập nhật giá SKU</button></form></c:if><div class="table-wrap"><table><thead><tr><th>SKU</th><th>Tên</th><th>Giá bán</th><th>Giá sàn</th><th>Thao tác</th></tr></thead><tbody><c:forEach items="${items}" var="i"><tr><td><c:out value="${i.sku}"/></td><td><c:out value="${i.name}"/></td><td><c:out value="${i.selling_price}"/></td><td><c:out value="${i.floor_price}"/></td><td><c:if test="${access.allows('PRICE_MANAGE') and not edit.used}"><form method="post"><input type="hidden" name="_csrf" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="action" value="deleteItem"><input type="hidden" name="id" value="${edit.id}"><input type="hidden" name="item" value="${i.id}"><button class="button">Xóa giá SKU</button></form></c:if></td></tr></c:forEach></tbody></table></div></c:if><h2>Tra giá theo ngày</h2><c:if test="${not empty quote}"><div class="alert"><c:out value="${quote}"/></div></c:if><form method="get" class="account-form"><input type="hidden" name="action" value="quote"><label class="field">Nhóm khách <select name="group"><c:forEach items="${groups}" var="g"><option value="${g.id}"><c:out value="${g.name}"/></option></c:forEach></select></label><label class="field">SKU <select name="product"><c:forEach items="${products}" var="p"><option value="${p.id}"><c:out value="${p.sku}"/></option></c:forEach></select></label><label class="field">Ngày <input name="date" type="date" value="${today}" required></label><button class="button">Tra giá</button></form></main></body></html>

