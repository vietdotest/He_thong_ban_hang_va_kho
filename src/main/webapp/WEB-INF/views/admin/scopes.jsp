<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="vi"><head><meta name="viewport" content="width=device-width,initial-scale=1"><title>Kho và địa bàn</title><%@ include file="../fragments/assets.jspf" %></head><body><%@ include file="../fragments/sidebar.jspf" %>
<%@ include file="../fragments/topbar.jspf" %><main class="page-body app-content"><h1>Kho và địa bàn</h1><form class="content-panel" method="post"><input type="hidden" name="_csrf" value="<c:out value='${csrfToken}'/>"><label>Loại <select name="kind"><option value="warehouse">Kho</option><option value="territory">Địa bàn</option></select></label><label>Mã <input name="code" required maxlength="50"></label><label>Tên <input name="name" required maxlength="150"></label><button class="button button-primary">Thêm</button></form><h2>Kho</h2><c:forEach var="w" items="${warehouses}"><p><c:out value="${w.code}"/> — <c:out value="${w.name}"/></p></c:forEach><h2>Địa bàn</h2><c:forEach var="w" items="${territories}"><p><c:out value="${w.code}"/> — <c:out value="${w.name}"/></p></c:forEach><a href="${pageContext.request.contextPath}/admin/users">Về người dùng</a></main></body></html>

