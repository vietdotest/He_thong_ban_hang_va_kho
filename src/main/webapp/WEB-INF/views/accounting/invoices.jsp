<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %><fmt:setLocale value="vi_VN"/>
<!doctype html><html lang="vi"><head><meta name="viewport" content="width=device-width,initial-scale=1"><title>Hóa đơn nội bộ</title><%@ include file="../fragments/assets.jspf" %><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/mvp.css"><script defer src="${pageContext.request.contextPath}/assets/js/mvp-receipts.js"></script></head><body class="app-page"><%@ include file="../fragments/sidebar.jspf" %><%@ include file="../fragments/topbar.jspf" %><main class="page-body app-content catalog-page">
<div class="page-heading no-print"><div><h1>Hóa đơn nội bộ</h1><p>Mỗi lần giao có một hóa đơn theo lượng thực nhận. Dư có được áp dụng ngay khi phát hành.</p></div></div>
<c:if test="${param.notice=='issued'}"><p class="alert alert-success no-print" role="status">Đã phát hành hóa đơn và áp dụng dư có hiện có.</p></c:if><c:forEach items="${errors}" var="error"><p class="alert alert-error no-print" role="alert"><c:out value="${error.value}"/></p></c:forEach>
<c:if test="${not empty invoice}"><section class="content-panel padded-panel"><h2>Hóa đơn <c:out value="${invoice.number}"/></h2><p>Đại lý: <c:out value="${invoice.delivery.dealer_code_snapshot}"/> — <c:out value="${invoice.delivery.dealer_name_snapshot}"/></p><p>Địa chỉ: <c:out value="${invoice.delivery.address_snapshot}"/></p><p>Người nhận: <c:out value="${invoice.delivery.recipient_snapshot}"/> · <c:out value="${invoice.delivery.phone_snapshot}"/></p><p>Ngày hóa đơn: ${invoice.invoice_date} · Hạn thanh toán: ${invoice.due_date} · Nguồn giao: <c:out value="${invoice.delivery.shipment_number}"/> · Đơn: <c:out value="${invoice.delivery.order_number}"/></p>
<div class="table-wrap"><table><thead><tr><th>SKU / sản phẩm</th><th>Lượng thực giao</th><th>Đơn vị cơ sở</th><th>Thành tiền</th></tr></thead><tbody><c:forEach items="${invoice.lines}" var="line"><tr><td><c:out value="${line.sku_snapshot}"/> — <c:out value="${line.name_snapshot}"/></td><td><fmt:formatNumber value="${line.quantity}" pattern="#,##0.############"/></td><td><c:out value="${line.unit_snapshot}"/></td><td><fmt:formatNumber value="${line.net_amount}" pattern="#,##0.####"/> đ</td></tr></c:forEach></tbody></table></div>
<p>Tổng hóa đơn: <strong><fmt:formatNumber value="${invoice.net_amount}" pattern="#,##0.####"/> đ</strong></p><p>Dư có đã áp dụng khi phát hành: <fmt:formatNumber value="${invoice.applied_credit_at_issue}" pattern="#,##0.####"/> đ (dùng nguồn đã ghi nhận; không tạo phiếu thu mới).</p><p>Giảm trừ: <fmt:formatNumber value="${invoice.credited}" pattern="#,##0.####"/> đ · Tiền đã phân bổ: <fmt:formatNumber value="${invoice.allocated}" pattern="#,##0.####"/> đ</p><p>Còn phải thu: <strong><fmt:formatNumber value="${invoice.outstanding}" pattern="#,##0.####"/> đ</strong> · ${invoice.outstanding le 0?'Đã thanh toán':'Còn nợ'}</p><p>Hóa đơn nội bộ — số tiền chưa gồm thuế hoặc vận chuyển.</p><button type="button" class="button button-secondary no-print" data-print>In hóa đơn</button></section>
<c:if test="${not empty invoice.allocations}"><section class="content-panel padded-panel no-print"><h2>Lịch sử phân bổ tiền</h2><c:forEach items="${invoice.allocations}" var="allocation"><p><c:out value="${allocation.occurred_at}"/> · Phiếu thu <a href="${pageContext.request.contextPath}/accounting/payments?id=${allocation.payment_id}"><c:out value="${allocation.payment_number}"/></a> · <c:out value="${allocation.reason_label}"/> <c:if test="${not empty allocation.credit_number and access.allows('RETURN_READ')}"> · <a href="${pageContext.request.contextPath}/accounting/returns?id=${allocation.credit_return_id}"><c:out value="${allocation.credit_number}"/></a></c:if> · Điều chỉnh <fmt:formatNumber value="${allocation.signed_amount}" pattern="#,##0.####"/> đ</p></c:forEach></section></c:if></c:if>
<c:if test="${access.allows('INVOICE_ISSUE')}"><section class="content-panel padded-panel no-print"><h2>Giao đã xác nhận chưa có hóa đơn</h2><c:forEach items="${deliveries}" var="delivery"><form method="post" class="mvp-line"><input type="hidden" name="_csrf" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="action" value="issue"><input type="hidden" name="shipment" value="${delivery.id}"><input type="hidden" name="version" value="${delivery.version}"><input type="hidden" name="requestKey" value="${delivery.request_key}"><p>PX-${delivery.id} · <c:out value="${delivery.dealer_name_snapshot}"/> · Giao ngày <c:out value="${delivery.delivered_at}"/> · <fmt:formatNumber value="${delivery.amount}" pattern="#,##0.####"/> đ</p><button class="button button-primary">Phát hành hóa đơn cho lần giao này</button></form></c:forEach><c:if test="${empty deliveries}"><p>Không có lần giao đủ điều kiện chờ lập hóa đơn.</p></c:if></section></c:if>
<section class="content-panel padded-panel no-print"><h2>Danh sách hóa đơn trong phạm vi</h2><div class="table-wrap"><table><thead><tr><th>Hóa đơn</th><th>Đại lý</th><th>Ngày / hạn</th><th>Tiền hóa đơn</th><th>Còn nợ</th></tr></thead><tbody><c:forEach items="${invoices}" var="item"><tr><td><a href="${pageContext.request.contextPath}/accounting/invoices?id=${item.id}"><c:out value="${item.number}"/></a></td><td><c:out value="${item.dealer_name}"/></td><td>${item.invoice_date} / ${item.due_date}</td><td><fmt:formatNumber value="${item.net_amount}" pattern="#,##0.####"/> đ</td><td><fmt:formatNumber value="${item.outstanding}" pattern="#,##0.####"/> đ</td></tr></c:forEach><c:if test="${empty invoices}"><tr><td colspan="5">Chưa có hóa đơn trong phạm vi.</td></tr></c:if></tbody></table></div></section>
</main></body></html>
