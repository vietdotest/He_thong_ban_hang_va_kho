<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="vi"><head><meta name="viewport" content="width=device-width,initial-scale=1"><title>Gán vai trò và phạm vi</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/app.css"></head><body><main class="page-body"><h1>Gán vai trò và phạm vi</h1><p><c:out value="${target.full_name}"/> — <c:out value="${target.username}"/></p><a href="${pageContext.request.contextPath}/admin/scopes">Danh mục kho và địa bàn</a><form class="content-panel" method="post"><input type="hidden" name="id" value="${target.id}"><input type="hidden" name="_csrf" value="<c:out value='${csrfToken}'/>"><h2>Vai trò</h2><c:forEach var="item" items="${roles}"><label><input type="checkbox" name="role" value="${item.code}" ${item.selected == 1 ? 'checked' : ''}> <c:out value="${item.name}"/></label><br></c:forEach><h2>Kho phụ trách</h2><c:forEach var="item" items="${warehouses}"><label><input type="checkbox" name="warehouse" value="${item.id}" ${item.selected == 1 ? 'checked' : ''}> <c:out value="${item.name}"/></label><br></c:forEach><h2>Địa bàn phụ trách</h2><c:forEach var="item" items="${territories}"><label><input type="checkbox" name="territory" value="${item.id}" ${item.selected == 1 ? 'checked' : ''}> <c:out value="${item.name}"/></label><br></c:forEach><button class="button button-primary">Lưu phân công</button><a href="${pageContext.request.contextPath}/admin/users">Về danh sách</a></form></main></body></html>
