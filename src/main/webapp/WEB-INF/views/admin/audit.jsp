<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="vi"><head><meta name="viewport" content="width=device-width,initial-scale=1"><title>Nhật ký thao tác</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/app.css?v=sprint2-20261001"></head><body class="app-page"><%@ include file="../fragments/sidebar.jspf" %><main class="page-body app-content"><h1>Nhật ký thao tác</h1><form method="get" class="content-panel"><label>Người thực hiện <select name="userId"><option value="">Tất cả</option><c:forEach var="u" items="${users}"><option value="${u.id}" ${param.userId == u.id ? 'selected' : ''}><c:out value="${u.full_name}"/></option></c:forEach></select></label><label>Loại đối tượng <select name="type"><option value="">Tất cả</option><c:forEach var="t" items="${types}"><option value="${t.object_type}" ${param.type == t.object_type ? 'selected' : ''}><c:out value="${t.object_type}"/></option></c:forEach></select></label><label>Từ ngày <input type="date" name="from" value="<c:out value='${param.from}'/>"></label><label>Đến ngày <input type="date" name="to" value="<c:out value='${param.to}'/>"></label><label>Trang <input type="number" name="page" min="1" value="${pageNumber}"></label><button class="button button-primary">Lọc nhật ký</button></form><div class="content-panel table-wrap"><table class="data-table"><thead><tr><th>Thời điểm</th><th>Người thực hiện</th><th>Thao tác</th><th>Đối tượng</th><th>Trước thay đổi</th><th>Sau thay đổi</th></tr></thead><tbody><c:forEach var="log" items="${logs}"><tr><td><c:out value="${log.display_time}"/></td><td><c:out value="${log.full_name}"/></td><td><c:out value="${log.event_type}"/></td><td><c:out value="${log.object_type}"/> #<c:out value="${log.object_id}"/></td><td><pre><c:out value="${log.before_values}"/></pre><c:if test="${canCost}"><pre><c:out value="${log.before_cost}"/></pre></c:if></td><td><pre><c:out value="${log.after_values}"/></pre><c:if test="${canCost}"><pre><c:out value="${log.after_cost}"/></pre></c:if></td></tr></c:forEach></tbody></table></div></main></body></html>

