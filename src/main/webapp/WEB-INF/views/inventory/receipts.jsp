<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="vi"><head><meta name="viewport" content="width=device-width,initial-scale=1"><title>Nhập kho | NVDO</title><%@ include file="../fragments/assets.jspf" %><script src="${pageContext.request.contextPath}/assets/js/mvp-receipts.js" defer></script><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/mvp.css"></head><body class="app-page"><%@ include file="../fragments/sidebar.jspf" %><%@ include file="../fragments/topbar.jspf" %>
<main class="page-body app-content catalog-page"><div class="page-heading"><div><h1>Nhập kho</h1><p>Ghi nhận hàng về từ nhà cung cấp; phiếu nháp chưa ảnh hưởng tồn.</p></div><c:if test="${access.allows('STOCK_RECEIPT_WRITE')}"><a class="button button-primary no-print" href="${pageContext.request.contextPath}/inventory/receipts?action=new">＋ Lập phiếu</a></c:if></div>
<c:if test="${not empty errors}"><div class="alert alert-error" role="alert"><c:forEach var="e" items="${errors}"><p><c:out value="${e.value}"/></p></c:forEach></div></c:if>
<c:if test="${param.notice == 'saved'}"><p class="alert alert-success no-print">Đã ghi nhận thao tác.</p></c:if>
<c:choose><c:when test="${receipt.status == 'CONFIRMED'}"><section class="content-panel"><h2>Phiếu nhập <c:out value="${receipt.number}"/></h2><p>Kho: <c:out value="${receipt.warehouse_name}"/> — <c:out value="${receipt.warehouse_address}"/></p><p>Nhà cung cấp: <c:out value="${receipt.supplier_name}"/> · Chứng từ: <c:out value="${receipt.document_ref}"/> · Ngày: <c:out value="${receipt.receipt_date}"/></p><div class="table-scroll"><table><thead><tr><th>SKU / sản phẩm</th><th>Lô</th><th>Đơn vị</th><th>Số lượng</th><th>Lượng cơ sở</th><th>HSD</th></tr></thead><tbody><c:forEach var="l" items="${receipt.lines}"><tr><td><c:out value="${l.sku}"/> — <c:out value="${l.name}"/></td><td><c:out value="${l.lot_code}"/></td><td><c:out value="${l.unit_name_snapshot}"/></td><td><c:out value="${l.quantity}"/></td><td><c:out value="${l.base_quantity}"/></td><td><c:out value="${l.expires_on}"/></td></tr></c:forEach></tbody></table></div><button type="button" class="button button-secondary no-print" data-print>In phiếu</button><p>Đã xác nhận; chứng từ giữ nguyên để đối chiếu.</p></section></c:when><c:otherwise>
<c:if test="${access.allows('STOCK_RECEIPT_WRITE') and (param.action == 'new' or not empty receipt or not empty errors)}"><section class="content-panel no-print"><h2>${empty receipt ? 'Lập phiếu nhập' : 'Phiếu nhập nháp'}</h2><form method="post" class="account-form" data-mvp-receipt>
<input type="hidden" name="_csrf" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="action" value="save"><input type="hidden" name="id" value="<c:out value='${form.id}'/>"><input type="hidden" name="version" value="<c:out value='${form.version}'/>"><input type="hidden" name="requestKey" value="<c:out value='${requestKey}'/>">
<label class="field">Kho nhập<select name="warehouse" required><option value="">Chọn kho</option><c:forEach var="w" items="${warehouses}"><option value="${w.id}" ${form.warehouse_id == w.id ? 'selected' : ''}><c:out value="${w.code}"/> — <c:out value="${w.name}"/> — <c:out value="${w.address}"/></option></c:forEach></select></label>
<label class="field">Nhà cung cấp<select name="supplier" required><option value="">Chọn nhà cung cấp</option><c:forEach var="s" items="${suppliers}"><option value="${s.id}" data-warehouse="${s.warehouse_id}" ${form.supplier_id == s.id ? 'selected' : ''}><c:out value="${s.code}"/> — <c:out value="${s.name}"/></option></c:forEach></select></label>
<label class="field">Số chứng từ nhà cung cấp<input name="reference" required maxlength="100" value="<c:out value='${form.document_ref}'/>"></label><label class="field">Ngày nhập<input type="date" name="date" required value="<c:out value='${form.receipt_date}'/>"></label>
<div data-receipt-lines><c:forEach var="l" items="${lineForms}"><fieldset class="content-panel" data-receipt-line><legend>Dòng hàng</legend><label class="field">Sản phẩm<select name="product" required><option value="">Chọn sản phẩm</option><c:forEach var="p" items="${products}"><option value="${p.id}" ${l.product_id == p.id ? 'selected' : ''}><c:out value="${p.sku}"/> — <c:out value="${p.name}"/></option></c:forEach></select></label><label class="field">Đơn vị<select name="unit" required><option value="">Chọn đơn vị</option><c:forEach var="u" items="${units}"><option value="${u.id}" data-product="${u.product_id}" data-warehouse="${u.warehouse_id}" ${l.unit_id == u.id ? 'selected' : ''}><c:out value="${u.name}"/></option></c:forEach></select></label><label class="field">Số lượng<input name="quantity" type="number" min="0.000001" step="0.000001" required value="<c:out value='${l.quantity}'/>"></label><label class="field">Số lô<input name="lot" required maxlength="100" value="<c:out value='${l.lot_code}'/>"></label><label class="field">Hạn sử dụng<input type="date" name="expiry" value="<c:out value='${l.expires_on}'/>"></label><button type="button" class="button button-plain" data-remove-line>Bỏ dòng</button></fieldset></c:forEach></div><button type="button" class="button button-secondary" data-add-line>＋ Thêm dòng</button><button class="button button-primary">Lưu nháp</button></form>
<c:if test="${receipt.status == 'DRAFT'}"><form method="post" class="account-form"><input type="hidden" name="_csrf" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="id" value="${receipt.id}"><input type="hidden" name="version" value="${receipt.version}"><input type="hidden" name="requestKey" value="${requestKey}"><input type="hidden" name="action" value="confirm"><p>Xác nhận phiếu sẽ cộng tồn theo quy đổi đã lưu và giữ nguyên chứng từ.</p><button class="button button-primary">Xác nhận nhập kho</button></form></c:if></section></c:if>
</c:otherwise></c:choose>
<section class="content-panel no-print"><h2>Danh sách phiếu nhập</h2><div class="table-scroll"><table><thead><tr><th>Phiếu</th><th>Kho</th><th>Nhà cung cấp</th><th>Ngày</th><th>Trạng thái</th></tr></thead><tbody><c:forEach var="r" items="${receipts}"><tr><td><a href="${pageContext.request.contextPath}/inventory/receipts?id=${r.id}"><c:out value="${empty r.number ? 'Nháp PN-'.concat(r.id) : r.number}"/></a></td><td><c:out value="${r.warehouse_name}"/></td><td><c:out value="${r.supplier_name}"/></td><td><c:out value="${r.receipt_date}"/></td><td>${r.status == 'CONFIRMED' ? 'Đã xác nhận' : 'Nháp'}</td></tr></c:forEach></tbody></table></div></section><c:if test="${receipt.status=='DRAFT' and not access.allows('STOCK_RECEIPT_WRITE')}"><section class="content-panel padded-panel"><h2>Phiếu nhập nháp PN-${receipt.id}</h2><p>Nháp chưa cộng tồn. Kho <c:out value="${receipt.warehouse_name}"/> · Nhà cung cấp <c:out value="${receipt.supplier_name}"/> · Chứng từ <c:out value="${receipt.document_ref}"/></p><c:forEach items="${receipt.lines}" var="line"><p><c:out value="${line.sku}"/> — <c:out value="${line.name}"/> · ${line.quantity} <c:out value="${line.unit_name_snapshot}"/> · Lô <c:out value="${line.lot_code}"/></p></c:forEach></section></c:if></main></body></html>
