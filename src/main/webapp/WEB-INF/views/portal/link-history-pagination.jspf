<%@ page pageEncoding="UTF-8" %>
<c:set var="historyPaging" value="${linkHistoryPagination}"/>
<p class="table-summary">Lịch sử: ${historyPaging.firstItem}–${historyPaging.lastItem} / ${historyPaging.totalItems} bản ghi</p>
<form method="get" class="page-size-form"><input type="hidden" name="userId" value="<c:out value='${param.userId}'/>"><label>Số dòng lịch sử <select name="historyPageSize"><c:forEach var="size" items="${[20,50,100]}"><option value="${size}" ${historyPaging.pageSize==size?'selected':''}>${size}</option></c:forEach></select></label><button class="button button-secondary">Đổi</button></form>
<nav class="pagination" aria-label="Phân trang lịch sử liên kết"><c:forEach var="target" items="${[1,historyPaging.page-1]}" varStatus="direction"><c:set var="label" value="${direction.index==0?'Đầu':'Trước'}"/><c:url var="historyUrl" value="/dealers/accounts"><c:param name="userId" value="${param.userId}"/><c:param name="historyPage" value="${target}"/><c:param name="historyPageSize" value="${historyPaging.pageSize}"/></c:url><c:choose><c:when test="${historyPaging.page>1}"><a class="button button-secondary" href="<c:out value='${historyUrl}'/>"><c:out value="${label}"/></a></c:when><c:otherwise><button class="button" disabled><c:out value="${label}"/></button></c:otherwise></c:choose></c:forEach>
<c:forEach var="target" begin="${historyPaging.windowStart}" end="${historyPaging.windowEnd}"><c:url var="historyUrl" value="/dealers/accounts"><c:param name="userId" value="${param.userId}"/><c:param name="historyPage" value="${target}"/><c:param name="historyPageSize" value="${historyPaging.pageSize}"/></c:url><a class="button button-secondary ${target==historyPaging.page?'active':''}" aria-current="${target==historyPaging.page?'page':'false'}" href="<c:out value='${historyUrl}'/>">${target}</a></c:forEach>
<c:forEach var="target" items="${[historyPaging.page+1,historyPaging.totalPages]}" varStatus="direction"><c:set var="label" value="${direction.index==0?'Tiếp':'Cuối'}"/><c:url var="historyUrl" value="/dealers/accounts"><c:param name="userId" value="${param.userId}"/><c:param name="historyPage" value="${target}"/><c:param name="historyPageSize" value="${historyPaging.pageSize}"/></c:url><c:choose><c:when test="${historyPaging.page<historyPaging.totalPages}"><a class="button button-secondary" href="<c:out value='${historyUrl}'/>"><c:out value="${label}"/></a></c:when><c:otherwise><button class="button" disabled><c:out value="${label}"/></button></c:otherwise></c:choose></c:forEach></nav>
