<%@ tag body-content="empty" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="ui" tagdir="/WEB-INF/tags/ui" %>

<details class="navigation-shell" id="navigation-shell" open><summary class="navigation-toggle icon-button" aria-label="Menu chức năng"><ui:icon name="bars"/></summary>
<aside class="sidebar" id="nvdo-menu" aria-label="Menu chức năng">
<div class="sidebar-heading"><a class="sidebar-brand" href="${pageContext.request.contextPath}/dashboard"><span class="wordmark-symbol" aria-hidden="true">BH</span><span>Quản lý bán hàng</span></a><button class="icon-button mobile-menu-close" type="button" data-menu-close aria-label="Đóng menu"><ui:icon name="xmark"/></button></div>
<nav class="sidebar-nav" aria-label="Điều hướng chính">
<c:if test="${access.roles().contains('DEALER')}"><a class="nav-item" href="${pageContext.request.contextPath}/portal">Cổng đại lý / sản phẩm</a><a class="nav-item" href="${pageContext.request.contextPath}/portal/orders">Đơn của đại lý</a></c:if>
<c:if test="${access.allows('PORTAL_ACCOUNT_MANAGE') and access.roles().contains('SALES_MANAGER')}"><a class="nav-item" href="${pageContext.request.contextPath}/dealers/accounts">Tài khoản cổng đại lý</a></c:if>
<a class="nav-item" href="${pageContext.request.contextPath}/dashboard"><ui:icon name="house"/>Tổng quan</a>
<c:if test="${access.allows('DEALER_READ')}"><p class="nav-group">Khách hàng và đơn hàng</p><a class="nav-item" href="${pageContext.request.contextPath}/dealers"><ui:icon name="users"/>Đại lý</a><c:if test="${access.allows('DEALER_HANDOVER')}"><a class="nav-item" href="${pageContext.request.contextPath}/dealers/handover"><ui:icon name="users"/>Phân công / bàn giao</a></c:if></c:if>
<c:if test="${access.allows('ORDER_READ')}"><a class="nav-item" href="${pageContext.request.contextPath}/orders"><ui:icon name="box"/>Đơn hàng</a></c:if>
<c:if test="${access.allows('USER_MANAGE') or access.allows('ROLE_MANAGE') or access.allows('AUDIT_READ')}"><p class="nav-group">Quản trị</p></c:if>
<c:if test="${access.allows('USER_MANAGE')}"><a class="nav-item" href="${pageContext.request.contextPath}/admin/users"><ui:icon name="users"/>Người dùng</a><a class="nav-item" href="${pageContext.request.contextPath}/admin/scopes"><ui:icon name="location-dot"/>Kho và địa bàn</a></c:if>
<c:if test="${access.allows('ROLE_MANAGE')}"><a class="nav-item" href="${pageContext.request.contextPath}/admin/roles"><ui:icon name="shield-halved"/>Phân quyền</a></c:if>
<c:if test="${access.allows('AUDIT_READ')}"><a class="nav-item" href="${pageContext.request.contextPath}/admin/audit"><ui:icon name="clock"/>Nhật ký thao tác</a></c:if>
<c:if test="${access.allows('CATALOG_READ') or access.allows('PRICE_READ')}"><p class="nav-group">Danh mục và giá</p></c:if>
<c:if test="${access.allows('CATALOG_READ')}"><a class="nav-item" href="${pageContext.request.contextPath}/catalog/products"><ui:icon name="box"/>Sản phẩm</a><a class="nav-item" href="${pageContext.request.contextPath}/catalog/categories"><ui:icon name="folder-tree"/>Nhóm hàng</a><a class="nav-item" href="${pageContext.request.contextPath}/catalog/units"><ui:icon name="ruler-combined"/>Đơn vị quy đổi</a><a class="nav-item" href="${pageContext.request.contextPath}/catalog/suppliers"><ui:icon name="truck"/>Nhà cung cấp</a></c:if>
<c:if test="${access.allows('PRICE_READ')}"><a class="nav-item" href="${pageContext.request.contextPath}/pricing/lists"><ui:icon name="tag"/>Bảng giá</a></c:if>
<c:if test="${access.allows('PRICE_READ')}"><a class="nav-item" href="${pageContext.request.contextPath}/pricing/history"><ui:icon name="clock"/>Lịch sử giá</a></c:if>
<c:if test="${access.allows('DISCOUNT_READ')}"><a class="nav-item" href="${pageContext.request.contextPath}/pricing/discounts"><ui:icon name="tag"/>Chiết khấu sản lượng</a></c:if>
<c:if test="${access.allows('STOCK_RECEIPT_WRITE') or (access.allows('STOCK_READ') and (access.roles().contains('WAREHOUSE') or access.roles().contains('WAREHOUSE_MANAGER')))}"><a class="nav-item" href="${pageContext.request.contextPath}/inventory/receipts"><ui:icon name="box"/>Nhập kho</a></c:if>
<c:if test="${access.allows('STOCK_READ')}"><a class="nav-item" href="${pageContext.request.contextPath}/inventory/stock"><ui:icon name="box"/>Tồn kho / khả dụng</a></c:if>
<c:if test="${access.allows('FULFILLMENT_READ')}"><a class="nav-item" href="${pageContext.request.contextPath}/fulfillment/shipments"><ui:icon name="box"/>Soạn và xuất/giao</a></c:if>
<c:if test="${access.allows('INVOICE_READ')}"><a class="nav-item" href="${pageContext.request.contextPath}/accounting/invoices"><ui:icon name="box"/>Hóa đơn nội bộ</a><a class="nav-item" href="${pageContext.request.contextPath}/accounting/payments"><ui:icon name="box"/>Phiếu thu</a></c:if>
<c:if test="${access.allows('RETURN_READ')}"><a class="nav-item" href="${pageContext.request.contextPath}/accounting/returns"><ui:icon name="box"/>Trả hàng</a></c:if>
<c:if test="${access.allows('SALES_DEBT_REPORT_READ')}"><a class="nav-item" href="${pageContext.request.contextPath}/accounting/debt"><ui:icon name="box"/>Công nợ</a><a class="nav-item" href="${pageContext.request.contextPath}/reports/sales"><ui:icon name="box"/>Doanh số</a></c:if>
</nav>
<div class="sidebar-user"><div class="sidebar-identity"><c:choose><c:when test="${not empty access.avatarKey()}"><img class="sidebar-avatar" alt="Ảnh đại diện của bạn" src="${pageContext.request.contextPath}/account/avatar?v=<c:out value='${access.avatarKey()}'/>"></c:when><c:otherwise><span class="account-mark" aria-hidden="true">BH</span></c:otherwise></c:choose><div class="sidebar-user-name"><strong><c:out value="${currentUser.fullName()}"/></strong><div class="sidebar-role"><small><c:out value="${access.primaryRole().name}"/></small><c:if test="${access.displayRoles().size()>1}"><details class="role-menu"><summary aria-label="Xem tất cả vai trò">+${access.displayRoles().size()-1}</summary><ul class="role-popover"><c:forEach var="assignedRole" items="${access.displayRoles()}"><li><c:out value="${assignedRole.name}"/></li></c:forEach></ul></details></c:if></div></div></div>
<div class="sidebar-scope" tabindex="0" role="region" aria-label="Kho và địa bàn được giao"><c:choose><c:when test="${empty access.warehouses() and empty access.territories()}">Chưa gán kho / địa bàn</c:when><c:otherwise><c:forEach var="w" items="${access.warehouses()}"><span>Kho: <c:out value="${w.name}"/></span></c:forEach><c:forEach var="t" items="${access.territories()}"><span>Địa bàn: <c:out value="${t.name}"/></span></c:forEach></c:otherwise></c:choose></div>
<details class="account-menu"><summary class="button button-secondary">Tài khoản <ui:icon name="chevron-down"/></summary><nav class="account-popover" aria-label="Tài khoản"><a class="button button-plain" href="${pageContext.request.contextPath}/account/profile">Hồ sơ cá nhân</a><a class="button button-plain" href="${pageContext.request.contextPath}/account/change-password">Đổi mật khẩu</a><form method="post" action="${pageContext.request.contextPath}/logout"><input type="hidden" name="_csrf" value="<c:out value='${csrfToken}'/>"><button class="button button-plain">Đăng xuất</button></form></nav></details></div>
</aside></details>
