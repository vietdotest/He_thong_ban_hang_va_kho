<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %><fmt:setLocale value="vi_VN"/>
<!doctype html><html lang="vi"><head><meta name="viewport" content="width=device-width,initial-scale=1"><title>Đơn nháp / tiếp nhận</title><%@ include file="../fragments/assets.jspf" %><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/orders.css?v=s3-1"><script defer src="${pageContext.request.contextPath}/assets/js/orders.js?v=s3-1"></script></head><body class="app-page"><%@ include file="../fragments/sidebar.jspf" %><%@ include file="../fragments/topbar.jspf" %>
<main class="page-body app-content catalog-page"><div class="page-heading"><div><h1>${empty order ? 'Tạo đơn nháp' : order.status=='DRAFT'?'Đơn nháp':'Đơn đã gửi tiếp nhận'} <c:if test="${not empty order}">ĐH-${order.id}</c:if></h1><p>Giá theo ngày gửi tại Việt Nam · tiền theo đơn vị cơ sở · chưa thuế / vận chuyển.</p></div><c:url var="back" value="${orderPath}"><c:param name="q" value="${param.q}"/><c:param name="status" value="${param.status}"/><c:param name="page" value="${param.page}"/><c:param name="pageSize" value="${param.pageSize}"/><c:param name="dealer" value="${param.dealer}"/></c:url><a class="button button-secondary" href="<c:out value='${back}'/>">Danh sách đơn</a></div>
<c:if test="${param.notice=='saved'}"><p class="alert alert-success" role="status">Đã lưu nháp. Kiểm tra báo giá trước khi gửi.</p></c:if><c:if test="${param.notice=='submitted'}"><p class="alert alert-success" role="status">Đã gửi tiếp nhận. Đơn chỉ được xem, chưa được duyệt hoặc xuất kho.</p></c:if>
<c:if test="${not empty errors}"><div class="alert alert-error" role="alert"><c:forEach items="${errors}" var="e"><p><c:out value="${e.value}"/></p></c:forEach></div></c:if><c:if test="${order.transaction_locked}"><p class="alert" role="note">Đại lý hiện bị khóa. Đây là đơn đã tồn tại; không thể tạo đơn mới.</p></c:if>
<c:choose><c:when test="${editing}">
<form id="order-editor" method="post" action="${pageContext.request.contextPath}${orderPath}" data-context="${pageContext.request.contextPath}" data-options-path="${optionsPath}" class="order-form"><input type="hidden" name="_csrf" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="action" value="save"><input type="hidden" name="id" value="<c:out value='${form.id}'/>"><input type="hidden" name="version" value="<c:out value='${form.version}'/>"><input type="hidden" name="creationKey" value="<c:out value='${form.creationKey}'/>">
<c:forEach var="key" items="${['q','status','page','pageSize']}"><input type="hidden" name="${key}" value="<c:out value='${param[key]}'/>"></c:forEach><input type="hidden" name="filterDealer" value="<c:out value='${param.dealer}'/>">
<section class="content-panel padded-panel"><h2>Thông tin giao hàng</h2><div class="dealer-profile-form order-header-fields"><label class="field">Đại lý<c:choose><c:when test="${empty order and not portalMode}"><select name="dealer" data-lookup="dealers" required><option value="">Gõ mã hoặc tên đại lý</option><c:if test="${not empty selectedDealer}"><option value="${selectedDealer.id}" selected><c:out value="${selectedDealer.code}"/> — <c:out value="${selectedDealer.name}"/></option></c:if></select></c:when><c:otherwise><input type="hidden" name="dealer" value="${form.dealer}"><input readonly value="<c:out value='${selectedDealer.code}'/> — <c:out value='${selectedDealer.name}'/>"></c:otherwise></c:choose><span class="field-error"><c:out value="${errors.dealer}"/></span></label>
<label class="field">Điểm giao <select name="address" required><option value="">Chọn điểm giao thuộc đại lý</option><c:forEach items="${addresses}" var="a"><option value="${a.id}" ${form.address.toString()==a.id.toString()?'selected':''}><c:out value="${a.address}"/> — <c:out value="${a.recipient}"/></option></c:forEach></select><span class="field-error"><c:out value="${errors.address}"/></span></label><label class="field">Ngày giao mong muốn <input name="delivery" type="date" required value="<c:out value='${form.delivery}'/>"><span class="field-error"><c:out value="${errors.delivery}"/></span></label></div></section>
<section class="content-panel padded-panel"><h2>Dòng hàng</h2><p class="helper-text">Gõ ít nhất 2 ký tự để tìm SKU ngoài trang đầu. Các dòng cùng SKU cộng sản lượng cơ sở để xét bậc.</p><div data-order-lines>
<c:forEach items="${lineForms}" var="line" varStatus="idx"><div class="order-line" data-order-line><p class="order-line-title">Dòng <span data-line-number>${idx.index+1}</span></p><label class="field">SKU / tên sản phẩm <select name="product" required data-lookup="products" data-lookup-endpoint="${portalMode?'/api/portal/products':'/api/lookups/products'}"><option value="">Chọn sản phẩm</option><c:if test="${not empty line.product_id}"><option value="<c:out value='${line.product_id}'/>" selected><c:out value="${line.sku}"/> — <c:out value="${line.name}" default="SKU đã chọn"/></option></c:if><c:forEach items="${products}" var="p"><option value="${p.id}"><c:out value="${p.sku}"/> — <c:out value="${p.name}"/></option></c:forEach></select></label><label class="field">Đơn vị <select name="unit" required><option value="">Chọn SKU và kho phục vụ</option><c:if test="${not empty line.unit_id}"><option value="<c:out value='${line.unit_id}'/>" selected><c:out value="${line.unit_name}" default="Đơn vị đã chọn"/></option></c:if></select></label><label class="field">Số lượng <input name="quantity" type="number" required min="0.000001" step="0.000001" value="<c:out value='${line.quantity}'/>"></label><button type="button" class="button button-secondary" data-remove-line>Xóa dòng</button><p class="field-error order-line-error" data-line-error><c:out value="${errors['line'.concat(idx.index)]}"/><c:out value="${errors['quantity'.concat(idx.index)]}"/></p><p class="helper-text order-line-money" data-line-money></p></div></c:forEach></div><button type="button" class="button button-secondary" data-add-line>Thêm dòng hàng</button></section>
<div class="form-actions"><button class="button button-primary">Lưu nháp và tính lại</button><button class="button button-secondary" type="button" data-refresh-quote>Tính lại báo giá</button><span class="helper-text" data-save-reminder>Phải lưu các thay đổi trước khi gửi.</span></div></form>
<template id="order-line-template"><div class="order-line" data-order-line><p class="order-line-title">Dòng <span data-line-number></span></p><label class="field">SKU / tên sản phẩm <select name="product" required data-lookup="products" data-lookup-endpoint="${portalMode?'/api/portal/products':'/api/lookups/products'}"><option value="">Chọn sản phẩm</option></select></label><label class="field">Đơn vị <select name="unit" required><option value="">Chọn SKU và kho phục vụ</option></select></label><label class="field">Số lượng <input name="quantity" type="number" required min="0.000001" step="0.000001" value="1"></label><button type="button" class="button button-secondary" data-remove-line>Xóa dòng</button><p class="field-error order-line-error" data-line-error></p><p class="helper-text order-line-money" data-line-money></p></div></template>
<section class="content-panel padded-panel order-totals" aria-live="polite"><h2>Báo giá</h2><p data-quote-status>Giá sẽ được kiểm tra lại ngay khi gửi.</p><p data-quote-warning><c:out value="${quote.warning}"/></p><dl><dt>Tiền hàng</dt><dd data-total="gross"><fmt:formatNumber value="${quote.gross}" pattern="#,##0.####"/> đ</dd><dt>Chiết khấu</dt><dd data-total="discount"><fmt:formatNumber value="${quote.discount}" pattern="#,##0.####"/> đ</dd><dt>Tổng phải thu</dt><dd data-total="net"><fmt:formatNumber value="${quote.net}" pattern="#,##0.####"/> đ</dd></dl>
<c:if test="${not empty quote.errors}"><div class="alert alert-error" role="alert"><c:forEach items="${quote.errors}" var="e"><p><c:out value="${e.value}"/></p></c:forEach></div></c:if>
<c:if test="${not empty order and order.can_edit}"><form id="order-submit" method="post" action="${pageContext.request.contextPath}${orderPath}" data-confirm="Gửi đơn để tiếp nhận? Đơn gửi thành công sẽ chỉ được xem."><input type="hidden" name="_csrf" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="action" value="submit"><input type="hidden" name="id" value="${order.id}"><input type="hidden" name="version" value="${form.version}"><input type="hidden" name="quoteToken" value="<c:out value='${quote.token}'/>"><input type="hidden" name="submitKey" value="${submitKey}"><c:if test="${quote.confirmation}"><p class="alert" role="alert">Giá hoặc điều kiện đã thay đổi / báo giá đã hết hạn. Kiểm tra số tiền mới trước khi xác nhận.</p><label class="checkbox-field"><input name="confirmed" value="true" type="checkbox" required>Tôi đồng ý với báo giá và điều kiện vừa hiển thị.</label></c:if><button class="button button-primary" ${empty quote.token or not empty quote.errors or unsaved?'disabled':''}>Gửi tiếp nhận</button></form></c:if></section>
</c:when><c:otherwise><section class="content-panel padded-panel"><h2>Thông tin đơn</h2><p>Đại lý: <c:out value="${order.status=='SUBMITTED'?order.dealer_name_snapshot:order.dealer_name}"/></p><p>Ngày giao mong muốn: ${order.desired_delivery}</p><c:if test="${order.status=='SUBMITTED'}"><p>Điểm giao: <c:out value="${order.address_snapshot}"/> — <c:out value="${order.recipient_snapshot}"/> · <c:out value="${order.phone_snapshot}"/></p><p>Ghi chú: <c:out value="${order.directions_snapshot}"/></p><p>Nhóm giá: <c:out value="${order.group_name_snapshot}"/> · Kho: <c:out value="${order.warehouse_name_snapshot}"/> · Ngày giá: ${order.pricing_date}</p><p>Tiền hàng: <fmt:formatNumber value="${order.gross_total}" pattern="#,##0.####"/> đ · Giảm: <fmt:formatNumber value="${order.discount_total}" pattern="#,##0.####"/> đ</p><p>Tổng phải thu: <strong><fmt:formatNumber value="${order.net_total}" pattern="#,##0.####"/> đ</strong></p></c:if></section><div class="order-read-lines"><c:forEach items="${order.lines}" var="l"><section class="content-panel padded-panel"><h2><c:out value="${order.status=='SUBMITTED'?l.sku_snapshot:l.sku}"/> — <c:out value="${order.status=='SUBMITTED'?l.name_snapshot:l.name}"/></h2><p><fmt:formatNumber value="${l.quantity}" pattern="#,##0.######"/> <c:out value="${order.status=='SUBMITTED'?l.unit_name_snapshot:l.unit_name}"/></p><c:if test="${order.status=='SUBMITTED'}"><p>Hệ số ${l.factor_snapshot} · giá cơ sở <fmt:formatNumber value="${l.selling_price}" pattern="#,##0.####"/> đ</p><p>Phải thu dòng: <fmt:formatNumber value="${l.net}" pattern="#,##0.####"/> đ · <c:out value="${l.policy_name_snapshot}" default="Không chiết khấu"/></p></c:if></section></c:forEach></div><c:if test="${order.can_takeover}"><form method="post" class="content-panel padded-panel"><input type="hidden" name="_csrf" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="action" value="takeover"><input type="hidden" name="id" value="${order.id}"><input type="hidden" name="version" value="${order.version}"><label class="field">Lý do tiếp quản nháp <input name="reason" required maxlength="1000"></label><button class="button button-primary">Tiếp quản có audit</button></form></c:if></c:otherwise></c:choose>
<c:if test="${not editing and order.status=='DRAFT'}"><section class="content-panel padded-panel"><h2>Thông tin nháp chỉ đọc</h2><p>Điểm giao: <c:out value="${order.delivery_address.address}"/> — <c:out value="${order.delivery_address.recipient}"/> · <c:out value="${order.delivery_address.phone}"/></p><p>Báo giá tham khảo ngày <c:out value="${readQuote.date}"/>: <fmt:formatNumber value="${readQuote.net}" pattern="#,##0.####"/> đ. Tính lại trước khi chủ nháp gửi.</p><c:forEach items="${readQuote.errors}" var="e"><p class="field-error"><c:out value="${e.value}"/></p></c:forEach></section></c:if>
</main></body></html>
