        <mxCell id="p14-n135" value="QUY TẮC NGHIỆM THU&#10;Mỗi case lưu precondition, steps, expected, actual, evidence và defect. Chưa đánh dấu Passed nếu chưa chạy ứng dụng. Không release khi còn Critical/High. Thiết kế được kiểm cấu trúc riêng với kiểm thử runtime." style="rounded=1;arcSize=8;html=0;whiteSpace=wrap;overflow=hidden;fillColor=#E8F6F1;strokeColor=#CBD8E2;fontColor=#183247;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=12;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="50" y="1750" width="2100" height="95" as="geometry" />
        </mxCell>
        <mxCell id="p14-n136" value="NGUỒN&#10;AC do người dùng cung cấp (Sprint 1 ưu tiên); SPRINT_1_KHOI_DONG_CHI_TIET.md; V001 schema; AuthenticationService, LoginServlet, AuthenticationFilter và web.xml. Story S2-S8 chỉ dùng xác định 7 vai trò / phụ thuộc tương lai." style="rounded=1;arcSize=8;html=0;whiteSpace=wrap;overflow=hidden;fillColor=#F2F7FA;strokeColor=#CBD8E2;fontColor=#183247;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=12;strokeWidth=1.2;" vertex="1" parent="1">
