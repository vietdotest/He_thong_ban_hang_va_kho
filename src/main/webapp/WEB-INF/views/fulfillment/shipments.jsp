<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %><fmt:setLocale value="vi_VN"/>
<!doctype html><html lang="vi"><head><meta name="viewport" content="width=device-width,initial-scale=1"><title>Soạn và xuất kho</title><%@ include file="../fragments/assets.jspf" %><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/mvp.css"></head>
<body class="app-page"><%@ include file="../fragments/sidebar.jspf" %><%@ include file="../fragments/topbar.jspf" %><main class="page-body app-content catalog-page">
<div class="page-heading"><div><h1>Soạn và xuất kho</h1><p>Chỉ đơn đã tiếp nhận thuộc kho được giao. Xuất theo lượng cơ sở đã giữ; lô được chọn từ ngày nhập cũ nhất.</p></div></div>
<c:if test="${param.notice=='saved'}"><p class="alert alert-success" role="status">Đã ghi nhận chứng từ.</p></c:if>
<c:forEach items="${errors}" var="error"><p class="alert alert-error" role="alert"><c:out value="${error.value}"/></p></c:forEach>
<c:if test="${not empty order}"><section class="content-panel padded-panel"><h2>ĐH-${order.id} · <c:out value="${order.dealer_name_snapshot}"/></h2><p>Kho: <c:out value="${order.warehouse_name_snapshot}"/> · Ngày giao: <c:out value="${order.desired_delivery}"/></p>
<p>Địa chỉ: <c:out value="${order.address_snapshot}"/> · <c:out value="${order.recipient_snapshot}"/> · <c:out value="${order.phone_snapshot}"/></p>
<c:choose><c:when test="${order.fulfillment_state=='RESERVED'}"><form method="post"><input type="hidden" name="_csrf" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="action" value="pick"><input type="hidden" name="order" value="${order.id}"><input type="hidden" name="version" value="${order.version}"><input type="hidden" name="requestKey" value="${requestKey}"><p>Bắt đầu soạn sẽ bảo vệ phần giữ hàng khỏi tự hết hạn.</p><button class="button button-primary">Bắt đầu soạn</button></form></c:when>
<c:when test="${order.fulfillment_state=='IN_PROGRESS'}"><form method="post"><input type="hidden" name="_csrf" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="action" value="dispatch"><input type="hidden" name="order" value="${order.id}"><input type="hidden" name="version" value="${order.version}"><input type="hidden" name="requestKey" value="${requestKey}">
<div class="mvp-lines"><c:forEach items="${order.lines}" var="line"><div class="mvp-line"><h3><c:out value="${line.sku_snapshot}"/> — <c:out value="${line.name_snapshot}"/></h3><p>Đã đặt: <fmt:formatNumber value="${line.base_quantity}" pattern="#,##0.############"/> · còn giữ: <fmt:formatNumber value="${line.held}" pattern="#,##0.############"/> đơn vị cơ sở.</p><input type="hidden" name="line" value="${line.id}"><label class="field">Số lượng xuất (đơn vị cơ sở)<input name="quantity" type="number" min="0" max="${line.held}" step="0.000000000001" required value="<c:out value='${empty lineValues ? line.held : lineValues[line.id.toString()]}'/>"></label></div></c:forEach></div>
<label class="field">Lý do xuất thiếu <textarea name="reason" maxlength="1000"><c:out value="${reason}"/></textarea></label><p>Để 0 cho dòng chưa xuất. Phiếu xác nhận không sửa trực tiếp.</p><button class="button button-primary">Xác nhận xuất kho</button></form></c:when>
<c:otherwise><p>Đơn chưa có giữ hàng hợp lệ để soạn. Liên hệ NVKD phụ trách kiểm lại tồn và hạn mức.</p></c:otherwise></c:choose>
<c:if test="${not empty order.shipments}"><h3>Phiếu xuất của đơn</h3><c:forEach items="${order.shipments}" var="shipment"><p>PX-${shipment.id} · <c:out value="${shipment.dispatched_at}"/> · ${shipment.status=='DELIVERED'?'Đã xác nhận giao':'Đang giao'} · <c:out value="${shipment.shortage_reason}"/></p></c:forEach></c:if></section></c:if>
<section class="content-panel padded-panel"><h2>Đơn tại kho được giao</h2><div class="table-wrap"><table><thead><tr><th>Đơn</th><th>Đại lý</th><th>Kho</th><th>Ngày giao</th><th>Xử lý</th></tr></thead><tbody><c:forEach items="${orders}" var="item"><tr><td><a href="${pageContext.request.contextPath}/fulfillment/shipments?order=${item.id}">ĐH-${item.id}</a></td><td><c:out value="${item.dealer_name_snapshot}"/></td><td><c:out value="${item.warehouse_name_snapshot}"/></td><td><c:out value="${item.desired_delivery}"/></td><td>${item.fulfillment_state=='RESERVED'?'Chờ soạn':item.fulfillment_state=='IN_PROGRESS'?'Đang xử lý':item.fulfillment_state=='EXPIRED'?'Giữ hàng hết hạn':'Chưa giữ hàng / đã hoàn tất'}</td></tr></c:forEach><c:if test="${empty orders}"><tr><td colspan="5">Chưa có đơn đã tiếp nhận tại kho được giao.</td></tr></c:if></tbody></table></div></section>
</main></body></html>
