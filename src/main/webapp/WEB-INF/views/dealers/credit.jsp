<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<fmt:setLocale value="vi_VN"/>
<!doctype html><html lang="vi"><head><meta name="viewport" content="width=device-width,initial-scale=1"><title>Cấu hình tín dụng đại lý</title><%@ include file="../fragments/assets.jspf" %></head><body class="app-page"><%@ include file="../fragments/sidebar.jspf" %><%@ include file="../fragments/topbar.jspf" %><main class="page-body app-content catalog-page"><div class="page-heading"><div><h1>Cấu hình tín dụng đại lý</h1><p><c:out value="${dealer.code}"/> — <c:out value="${dealer.name}"/></p></div><a class="button button-secondary" href="${pageContext.request.contextPath}/dealers">Danh sách đại lý</a></div><p class="alert" role="note">Hạn mức và ngày nợ là dữ liệu cấu hình. Sprint 3 chưa ghi sổ hoặc kiểm soát dư nợ thực tế. Giá trị 0 biểu thị chưa cho phép bán chịu.</p><c:if test="${param.notice=='saved'}"><p class="alert alert-success" role="status">Đã lưu hạn mức và lịch sử thay đổi.</p></c:if><c:if test="${not empty errors.form}"><p class="alert alert-error" role="alert"><c:out value="${errors.form}"/></p></c:if>
<section class="content-panel padded-panel"><h2>Hạn mức hiện tại</h2><p><strong><fmt:formatNumber value="${dealer.credit_limit}" minFractionDigits="0" maxFractionDigits="4"/> đ</strong> · tối đa ${dealer.debt_days} ngày nợ</p></section>
<c:if test="${access.allows('DEALER_CREDIT_MANAGE')}"><section class="content-panel"><h2 class="panel-heading">Thay đổi cấu hình tín dụng</h2><form method="post" class="account-form dealer-profile-form"><input type="hidden" name="_csrf" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="dealer" value="${dealer.id}"><input type="hidden" name="version" value="${dealer.version}"><label class="field">Hạn mức tiền tối đa (đ) <input name="limit" type="number" min="0" step="0.0001" required value="<c:out value='${not empty form ? form.limit : dealer.credit_limit}'/>" aria-invalid="${not empty errors.limit}"><span class="field-error"><c:out value="${errors.limit}"/></span></label><label class="field">Số ngày nợ tối đa <input name="days" type="number" min="0" max="2147483647" step="1" required value="<c:out value='${not empty form ? form.days : dealer.debt_days}'/>" aria-invalid="${not empty errors.days}"><span class="field-error"><c:out value="${errors.days}"/></span></label><label class="field">Lý do thay đổi <input name="reason" required maxlength="1000" value="<c:out value='${form.reason}'/>" aria-invalid="${not empty errors.reason}"><span class="field-error"><c:out value="${errors.reason}"/></span></label><div class="form-actions"><button class="button button-primary">Lưu cấu hình tín dụng</button></div></form></section></c:if>
<h2>Lịch sử thay đổi</h2><div class="table-wrap"><table><thead><tr><th>Hạn mức trước → sau</th><th>Ngày nợ trước → sau</th><th>Lý do</th><th>Người sửa</th><th>Phiên bản</th></tr></thead><tbody><c:forEach items="${history}" var="h"><tr><td><fmt:formatNumber value="${h.old_limit}" maxFractionDigits="4"/> → <fmt:formatNumber value="${h.new_limit}" maxFractionDigits="4"/></td><td>${h.old_days} → ${h.new_days}</td><td><c:out value="${h.reason}"/></td><td><c:out value="${h.actor_name}"/></td><td>${h.dealer_version}</td></tr></c:forEach><c:if test="${empty history}"><tr><td colspan="5" class="empty-state">Chưa có thay đổi tín dụng được ghi nhận.</td></tr></c:if></tbody></table></div><%@ include file="../fragments/pagination.jspf" %></main></body></html>
