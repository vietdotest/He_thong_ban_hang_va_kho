<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="vi"><head><meta name="viewport" content="width=device-width,initial-scale=1"><title>Khóa và mở tài khoản</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/app.css"></head><body class="app-page"><%@ include file="../../fragments/sidebar.jspf" %><main class="page-body app-content"><h1>Khóa và mở tài khoản</h1><section class="content-panel"><h2><c:out value="${target.full_name}"/></h2><p>Tài khoản: <c:out value="${target.username}"/></p><p>Trạng thái: <c:out value="${target.status}"/></p><p>Lý do khóa: <c:out value="${target.lock_reason}"/></p><form method="post"><input type="hidden" name="_csrf" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="id" value="${target.id}"><c:choose><c:when test="${target.status == 'ADMIN_LOCKED'}"><input type="hidden" name="action" value="unlock"><button class="button button-primary">Mở khóa</button></c:when><c:otherwise><input type="hidden" name="action" value="lock"><label>Lý do khóa <textarea name="reason" required maxlength="1000"></textarea></label><button class="button button-primary">Khóa và kết thúc mọi phiên</button></c:otherwise></c:choose></form><c:forEach var="w" items="${warnings}"><div class="alert alert-error">Đại lý <c:out value="${w.dealer_reference}"/> cần bàn giao: <c:out value="${w.reason}"/></div></c:forEach><a href="${pageContext.request.contextPath}/admin/users">Về danh sách</a></section></main></body></html>
