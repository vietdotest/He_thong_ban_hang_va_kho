<%@ page pageEncoding="UTF-8" %>
<c:if test="${not empty pagination}">
<div class="results-footer pagination-footer">
    <p class="table-summary">Hiển thị <c:out value="${pagination.firstItem}"/>–<c:out value="${pagination.lastItem}"/> / <strong><c:out value="${pagination.totalItems}"/></strong> bản ghi</p>
    <form method="get" class="page-size-form">
        <c:forEach var="filterName" items="${['territory','staff','dealer','q','role','status','category','group','from','to','userId','type','product']}"><c:if test="${not empty paginationFilterValues ? not empty paginationFilterValues[filterName] : not empty param[filterName]}"><input type="hidden" name="<c:out value='${filterName}'/>" value="<c:out value='${not empty paginationFilterValues ? paginationFilterValues[filterName] : param[filterName]}'/>"></c:if></c:forEach>
        <label>Số dòng <select name="pageSize" aria-label="Số dòng mỗi trang"><c:forEach var="size" items="${[20,50,100]}"><option value="${size}" ${pagination.pageSize == size ? 'selected' : ''}>${size}</option></c:forEach></select></label>
        <button class="button button-secondary" type="submit">Đổi</button>
    </form>
    <nav class="pagination" aria-label="Phân trang">
        <c:forEach var="target" items="${[1,pagination.page-1]}" varStatus="direction"><c:set var="pageLabel" value="${direction.index == 0 ? 'Đầu' : 'Trước'}"/>
            <c:url var="pageUrl" value="${paginationPath}"><c:forEach var="filterName" items="${['territory','staff','dealer','q','role','status','category','group','from','to','userId','type','product']}"><c:param name="${filterName}" value="${not empty paginationFilterValues ? paginationFilterValues[filterName] : param[filterName]}"/></c:forEach><c:param name="pageSize" value="${pagination.pageSize}"/><c:param name="page" value="${target}"/></c:url>
            <c:choose><c:when test="${pagination.page > 1}"><a class="button button-secondary" href="<c:out value='${pageUrl}'/>"><c:out value="${pageLabel}"/></a></c:when><c:otherwise><button class="button" disabled><c:out value="${pageLabel}"/></button></c:otherwise></c:choose>
        </c:forEach>
        <c:forEach begin="${pagination.windowStart}" end="${pagination.windowEnd}" var="target">
            <c:url var="pageUrl" value="${paginationPath}"><c:forEach var="filterName" items="${['territory','staff','dealer','q','role','status','category','group','from','to','userId','type','product']}"><c:param name="${filterName}" value="${not empty paginationFilterValues ? paginationFilterValues[filterName] : param[filterName]}"/></c:forEach><c:param name="pageSize" value="${pagination.pageSize}"/><c:param name="page" value="${target}"/></c:url>
            <a class="button button-secondary ${target == pagination.page ? 'active' : ''}" aria-current="${target == pagination.page ? 'page' : 'false'}" href="<c:out value='${pageUrl}'/>">${target}</a>
        </c:forEach>
        <c:forEach var="target" items="${[pagination.page+1,pagination.totalPages]}" varStatus="direction"><c:set var="pageLabel" value="${direction.index == 0 ? 'Tiếp' : 'Cuối'}"/>
            <c:url var="pageUrl" value="${paginationPath}"><c:forEach var="filterName" items="${['territory','staff','dealer','q','role','status','category','group','from','to','userId','type','product']}"><c:param name="${filterName}" value="${not empty paginationFilterValues ? paginationFilterValues[filterName] : param[filterName]}"/></c:forEach><c:param name="pageSize" value="${pagination.pageSize}"/><c:param name="page" value="${target}"/></c:url>
            <c:choose><c:when test="${pagination.page < pagination.totalPages}"><a class="button button-secondary" href="<c:out value='${pageUrl}'/>"><c:out value="${pageLabel}"/></a></c:when><c:otherwise><button class="button" disabled><c:out value="${pageLabel}"/></button></c:otherwise></c:choose>
        </c:forEach>
    </nav>
</div>
</c:if>
