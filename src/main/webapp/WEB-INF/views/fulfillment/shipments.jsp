<%@ taglib prefix="display" uri="urn:codegym:display" %>
<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %><fmt:setLocale value="vi_VN"/>
<layout:page title="Soạn và xuất kho" view="fulfillment/shipments" bodyClass="app-page" css="mvp" bare="false">
<jsp:body>
<main class="page-body app-content catalog-page">
<div class="page-heading"><div><h1>Soạn và xuất kho</h1><p>Chỉ đơn đã tiếp nhận thuộc kho được giao. Xuất theo lượng cơ sở đã giữ; lô được chọn từ ngày nhập cũ nhất.</p></div></div>
<c:if test="${param.notice=='saved' and empty errors}"><p class="alert alert-success" role="status">Đã ghi nhận chứng từ.</p></c:if>
<c:forEach items="${errors}" var="error"><p class="alert alert-error" role="alert"><c:out value="${error.value}"/></p></c:forEach>
<c:if test="${not empty order}"><section class="content-panel padded-panel"><h2><c:out value="${order.number}"/> · <c:out value="${order.dealer_name_snapshot}"/></h2><p>Kho: <c:out value="${order.warehouse_name_snapshot}"/> · Ngày giao: <c:out value="${order.desired_delivery}"/></p>
<p>Địa chỉ: <c:out value="${order.address_snapshot}"/> · <c:out value="${order.recipient_snapshot}"/> · <c:out value="${order.phone_snapshot}"/></p>
<c:choose><c:when test="${order.fulfillment_state=='RESERVED' and order.holds.hasActive and access.allows('FULFILLMENT_WRITE')}"><form method="post" action="${pageContext.request.contextPath}/fulfillment/shipments"><input type="hidden" name="_csrf" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="action" value="pick"><input type="hidden" name="order" value="${order.id}"><input type="hidden" name="version" value="${order.version}"><input type="hidden" name="requestKey" value="${requestKey}"><p>Bắt đầu soạn sẽ bảo vệ phần giữ hàng khỏi tự hết hạn.</p><ui:button variant="primary">Bắt đầu soạn</ui:button></form></c:when>
<c:when test="${order.fulfillment_state=='IN_PROGRESS' and access.allows('FULFILLMENT_WRITE')}"><form method="post" action="${pageContext.request.contextPath}/fulfillment/shipments"><input type="hidden" name="_csrf" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="action" value="dispatch"><input type="hidden" name="order" value="${order.id}"><input type="hidden" name="version" value="${order.version}"><input type="hidden" name="requestKey" value="${requestKey}">
<div class="mvp-lines"><c:forEach items="${order.lines}" var="line"><div class="mvp-line"><h3><c:out value="${line.sku_snapshot}"/> — <c:out value="${line.name_snapshot}"/></h3><p>Đã đặt: <fmt:formatNumber value="${line.base_quantity}" pattern="#,##0.############"/> · còn giữ: <fmt:formatNumber value="${line.held}" pattern="#,##0.############"/> đơn vị cơ sở.</p><input type="hidden" name="line" value="${line.id}"><label class="field">Số lượng xuất (đơn vị cơ sở)<input name="quantity" type="number" min="0" max="${line.held}" step="0.000000000001" required value="<c:out value='${empty lineValues ? line.held : lineValues[line.id.toString()]}'/>"></label></div></c:forEach></div>
<label class="field">Lý do xuất thiếu <textarea name="reason" maxlength="1000"><c:out value="${reason}"/></textarea></label><p>Để 0 cho dòng chưa xuất. Phiếu xác nhận không sửa trực tiếp.</p><ui:button variant="primary">Xác nhận xuất kho</ui:button></form></c:when>
<c:otherwise><p><c:out value="${order.fulfillment_state=='COMPLETE'?'Đơn đã hoàn tất giao hàng.':order.holds.status}"/>. Liên hệ NVKD phụ trách khi cần giữ lại phần chưa giao.</p></c:otherwise></c:choose>
<c:if test="${not empty order.shipments}"><h3>Phiếu xuất của đơn</h3><c:forEach items="${order.shipments}" var="shipment"><p><a href="${pageContext.request.contextPath}/fulfillment/shipments?id=${shipment.id}"><c:out value="${shipment.number}"/></a> · <c:out value="${display:time(shipment.dispatched_at)}"/> · ${shipment.status=='DELIVERED'?'Đã xác nhận giao':'Chờ xác nhận giao'} · <c:out value="${shipment.shortage_reason}"/></p></c:forEach></c:if></section></c:if>
<section class="content-panel padded-panel"><h2>Đơn tại kho được giao</h2><div class="table-wrap" tabindex="0"><table><thead><tr><th>Đơn</th><th>Đại lý</th><th>Kho</th><th>Ngày giao</th><th>Xử lý</th></tr></thead><tbody><c:forEach items="${orders}" var="item"><tr><td><a href="${pageContext.request.contextPath}/fulfillment/shipments?order=${item.id}"><c:out value="${item.number}"/></a></td><td><c:out value="${item.dealer_name_snapshot}"/></td><td><c:out value="${item.warehouse_name_snapshot}"/></td><td><c:out value="${item.desired_delivery}"/></td><td><c:out value="${item.fulfillment_state=='COMPLETE'?'Đã hoàn tất giao hàng':item.holds.status}"/></td></tr></c:forEach><c:if test="${empty orders}"><tr><td colspan="5">Chưa có đơn đã tiếp nhận tại kho được giao.</td></tr></c:if></tbody></table></div></section>
<c:if test="${not empty shipment}"><section class="content-panel padded-panel"><h2><c:out value="${shipment.number}"/> · ${shipment.status=='DELIVERED'?'Đã xác nhận giao':'Xác nhận giao'}</h2><p>Đại lý: <c:out value="${shipment.order.dealer_name_snapshot}"/> · Kho: <c:out value="${shipment.order.warehouse_name_snapshot}"/></p><p>Địa chỉ: <c:out value="${shipment.order.address_snapshot}"/> · <c:out value="${shipment.order.phone_snapshot}"/></p>
<c:choose><c:when test="${shipment.status=='DISPATCHED' and access.allows('FULFILLMENT_WRITE')}"><form method="post" action="${pageContext.request.contextPath}/fulfillment/shipments"><input type="hidden" name="_csrf" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="action" value="deliver"><input type="hidden" name="id" value="${shipment.id}"><input type="hidden" name="version" value="${shipment.version}"><input type="hidden" name="requestKey" value="${requestKey}"><c:forEach items="${shipment.lines}" var="line"><div class="mvp-line"><h3><c:out value="${line.sku_snapshot}"/> — <c:out value="${line.name_snapshot}"/></h3><p>Lô <c:out value="${line.lot_code}"/> · đã xuất <fmt:formatNumber value="${line.quantity}" pattern="#,##0.############"/> đơn vị cơ sở.</p><input type="hidden" name="shipmentLine" value="${line.id}"><label class="field">Khách thực nhận (đơn vị cơ sở)<input name="received" type="number" min="0" max="${line.quantity}" step="0.000000000001" required value="<c:out value='${empty receivedValues ? line.quantity : receivedValues[line.id.toString()]}'/>"></label></div></c:forEach><label class="field">Người nhận <input name="recipient" maxlength="200" required value="<c:out value='${empty recipient ? shipment.order.recipient_snapshot : recipient}'/>"></label><label class="field">Lý do giao thiếu / thất bại <textarea name="reason" maxlength="1000"><c:out value="${deliveryReason}"/></textarea></label><p>Phần chưa giao được chờ quay về kho và tiếp tục tính vào cam kết. Chỉ lượng thực nhận được lập hóa đơn.</p><ui:button variant="primary">Xác nhận giao</ui:button></form></c:when>
<c:when test="${shipment.status=='DISPATCHED'}"><p>Phiếu đang chờ xác nhận giao.</p><c:forEach items="${shipment.lines}" var="line"><p><c:out value="${line.sku_snapshot}"/> · đã xuất <fmt:formatNumber value="${line.quantity}" pattern="#,##0.############"/> đơn vị cơ sở.</p></c:forEach></c:when><c:otherwise><p>Người nhận: <c:out value="${shipment.recipient}"/> · thời điểm: <c:out value="${display:time(shipment.delivered_at)}"/>. Chứng từ đã xác nhận chỉ đọc.</p><div class="table-wrap" tabindex="0"><table><thead><tr><th>SKU / lô</th><th>Xuất</th><th>Thực nhận</th><th>Chờ quay về</th><th>Lý do</th></tr></thead><tbody><c:forEach items="${shipment.lines}" var="line"><tr><td><c:out value="${line.sku_snapshot}"/> / <c:out value="${line.lot_code}"/></td><td><fmt:formatNumber value="${line.quantity}" pattern="#,##0.############"/></td><td><fmt:formatNumber value="${line.received_quantity}" pattern="#,##0.############"/></td><td><fmt:formatNumber value="${line.quantity-line.received_quantity-line.returned_quantity}" pattern="#,##0.############"/></td><td><c:out value="${line.delivery_reason}"/></td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose></section></c:if>
<section class="content-panel padded-panel"><h2>Phiếu xuất và giao tại kho được giao</h2><div class="table-wrap" tabindex="0"><table><thead><tr><th>Phiếu</th><th>Đại lý</th><th>Kho</th><th>Trạng thái</th></tr></thead><tbody><c:forEach items="${shipments}" var="item"><tr><td><a href="${pageContext.request.contextPath}/fulfillment/shipments?id=${item.id}"><c:out value="${item.number}"/></a></td><td><c:out value="${item.dealer_name_snapshot}"/></td><td><c:out value="${item.warehouse_name_snapshot}"/></td><td>${item.status=='DELIVERED'?'Đã xác nhận giao':'Chờ xác nhận giao'}</td></tr></c:forEach><c:if test="${empty shipments}"><tr><td colspan="4">Chưa có phiếu xuất.</td></tr></c:if></tbody></table></div></section>
<c:if test="${shipment.status=='DELIVERED' and shipment.pending_total>0 and access.allows('STOCK_RETURN_RECEIVE')}"><section class="content-panel padded-panel"><h2>Nhận hàng giao thất bại quay về</h2><p>Xác nhận lượng thực về kho nguồn. Hàng tốt nhập lại lô nguồn; hàng hỏng không tăng tồn bán được. Cam kết của lượng này chỉ kết thúc khi xác nhận nhận lại.</p><form method="post" action="${pageContext.request.contextPath}/fulfillment/shipments"><input type="hidden" name="_csrf" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="action" value="recover"><input type="hidden" name="id" value="${shipment.id}"><input type="hidden" name="version" value="${shipment.version}"><input type="hidden" name="requestKey" value="${requestKey}"><c:forEach items="${shipment.lines}" var="line"><c:if test="${line.quantity-line.received_quantity-line.returned_quantity>0}"><div class="mvp-line"><h3><c:out value="${line.sku_snapshot}"/> · lô <c:out value="${line.lot_code}"/></h3><p>Còn chờ quay về: <fmt:formatNumber value="${line.quantity-line.received_quantity-line.returned_quantity}" pattern="#,##0.############"/> đơn vị cơ sở.</p><input type="hidden" name="recoveryLine" value="${line.id}"><label class="field">Lượng tốt thực nhận <input name="sellable" type="number" min="0" step="0.000000000001" required value="<c:out value='${empty recoveryValues ? 0 : recoveryValues[line.id.toString()].sellable}'/>"></label><label class="field">Lượng hỏng thực nhận <input name="damaged" type="number" min="0" step="0.000000000001" required value="<c:out value='${empty recoveryValues ? 0 : recoveryValues[line.id.toString()].damaged}'/>"></label></div></c:if></c:forEach><label class="field">Lý do / tình trạng thực nhận <textarea name="reason" required maxlength="1000"><c:out value="${recoveryReason}"/></textarea></label><ui:button variant="primary">Xác nhận đã nhận hàng quay về</ui:button></form></section></c:if>
<c:if test="${not empty shipment.recoveries}"><section class="content-panel padded-panel"><h2>Lịch sử nhận hàng quay về</h2><c:forEach items="${shipment.recoveries}" var="recovery"><p>NV-${recovery.id} · <c:out value="${display:time(recovery.recorded_at)}"/> · <fmt:formatNumber value="${recovery.quantity}" pattern="#,##0.############"/> đơn vị cơ sở · ${recovery.condition_code=='SELLABLE'?'Hàng tốt':'Hàng hỏng'} · <c:out value="${recovery.reason}"/></p></c:forEach></section></c:if>
</main>
</jsp:body>
</layout:page>
