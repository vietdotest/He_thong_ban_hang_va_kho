<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Phân quyền theo vai trò</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/app.css"></head><body class="app-page"><%@ include file="../fragments/sidebar.jspf" %><main class="page-body app-content"><h1>Phân quyền theo vai trò</h1><a href="${pageContext.request.contextPath}/dashboard">Về tổng quan</a>
<c:forEach var="role" items="${roles}"><section class="content-panel"><h2><c:out value="${role.name}"/></h2><form method="post"><input type="hidden" name="_csrf" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="roleId" value="${role.id}">
<c:forEach var="p" items="${permissions}"><c:set var="checked" value="false"/><c:forEach var="g" items="${grants}"><c:if test="${g.role_id == role.id and g.permission_id == p.id}"><c:set var="checked" value="true"/></c:if></c:forEach>
<label><input type="checkbox" name="permission" value="${p.code}" ${checked ? 'checked' : ''}> <c:out value="${p.name}"/></label><br></c:forEach><button class="button button-primary">Lưu quyền</button></form></section></c:forEach></main></body></html>
