<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %><fmt:setLocale value="vi_VN"/>
<!doctype html><html lang="vi"><head><meta name="viewport" content="width=device-width,initial-scale=1"><title>Chiết khấu sản lượng</title><%@ include file="../fragments/assets.jspf" %><script src="${pageContext.request.contextPath}/assets/js/discounts.js" defer></script></head><body class="app-page"><%@ include file="../fragments/sidebar.jspf" %><%@ include file="../fragments/topbar.jspf" %><main class="page-body app-content catalog-page"><div class="page-heading"><div><h1>Chiết khấu sản lượng</h1><p>Chính sách theo SKU hoặc nhóm hàng và các nhóm con.</p></div></div><p class="alert" role="note">Giá và tiền giảm cố định tính theo đơn vị cơ sở. Tổng sản lượng cùng SKU trong đơn quyết định bậc; không cộng giữa các SKU. Mỗi chính sách chọn bậc đạt điều kiện, lấy tổng tiền giảm lợi nhất, không cộng dồn; bằng nhau chọn ID thấp nhất. Tiền làm tròn HALF_UP đến 4 chữ số ở từng dòng.</p><c:if test="${param.notice=='saved'}"><p class="alert alert-success" role="status">Đã lưu chính sách chiết khấu.</p></c:if><c:if test="${not empty errors.form}"><p class="alert alert-error" role="alert"><c:out value="${errors.form}"/></p></c:if>
<form method="get" class="filter-form"><label>Tìm chính sách <input name="q" maxlength="150" value="<c:out value='${param.q}'/>"></label><button class="button button-primary">Tìm</button></form>
<c:if test="${access.allows('DISCOUNT_MANAGE')}"><details class="content-panel disclosure" id="editor" ${not empty edit or not empty errors or param['new']=='1' ? 'open' : ''}><summary>${empty edit.id ? 'Thêm chính sách' : 'Sửa / ngừng áp dụng chính sách'}</summary><form method="post" class="account-form dealer-profile-form" data-discount-form><input type="hidden" name="_csrf" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="id" value="<c:out value='${edit.id}'/>"><input type="hidden" name="revision" value="<c:out value='${edit.revision}'/>"><label class="field">Tên chính sách <input name="name" required maxlength="150" value="<c:out value='${edit.name}'/>" aria-invalid="${not empty errors.name}"><span class="field-error"><c:out value="${errors.name}"/></span></label><label class="field">Đối tượng <select name="targetType"><option value="SKU">Một SKU</option><option value="CATEGORY" ${edit.targetType=='CATEGORY' ? 'selected' : ''}>Nhóm hàng và nhóm con</option></select><span class="field-error"><c:out value="${errors.target}"/></span></label>
<label class="field" data-discount-sku>SKU <select name="product" data-lookup="products"><option value="">Gõ mã hoặc tên để tìm</option><c:if test="${not empty edit.product_id}"><option selected value="<c:out value='${edit.product_id}'/>"><c:out value="${selectedProduct.sku}" default="SKU đã chọn"/> — <c:out value="${selectedProduct.name}" default="kiểm tra lại khi lưu"/></option></c:if></select></label><label class="field" data-discount-category>Nhóm hàng <select name="category"><option value="">Chọn nhóm</option><c:forEach items="${categories}" var="c"><option value="${c.id}" ${edit.category_id==c.id.toString() ? 'selected' : ''}><c:out value="${c.label}"/></option></c:forEach></select></label>
<label class="field">Nhóm khách áp dụng <select name="group"><option value="">Tất cả nhóm khách</option><c:forEach items="${groups}" var="g"><option value="${g.id}" ${edit.customer_group_id==g.id.toString() ? 'selected' : ''}><c:out value="${g.name}"/></option></c:forEach></select><span class="field-error"><c:out value="${errors.group}"/></span></label><label class="field">Loại giảm <select name="mode"><option value="PERCENT">Phần trăm (%)</option><option value="FIXED" ${edit.mode=='FIXED' ? 'selected' : ''}>Tiền / đơn vị cơ sở (đ)</option></select><span class="field-error"><c:out value="${errors.mode}"/></span></label><label class="field">Từ ngày <input name="from" type="date" required value="<c:out value='${edit.valid_from}'/>"><span class="field-error"><c:out value="${errors.from}"/></span></label><label class="field">Đến ngày <input name="to" type="date" required value="<c:out value='${edit.valid_to}'/>"><span class="field-error"><c:out value="${errors.to}"/></span></label><label class="field">Trạng thái <select name="status"><option value="ACTIVE">Đang áp dụng</option><option value="DISABLED" ${edit.status=='DISABLED' ? 'selected' : ''}>Ngừng áp dụng</option></select></label>
<fieldset class="form-full discount-tiers"><legend>Bậc theo sản lượng cơ sở</legend><p class="field-error"><c:out value="${errors.tiers}"/></p><div data-tier-rows><c:choose><c:when test="${not empty edit.tiers}"><c:forEach items="${edit.tiers}" var="tier" varStatus="loop"><div class="form-grid discount-tier"><label class="field">Từ lượng cơ sở <input name="minimum" type="number" min="0" step="0.000001" required value="<c:out value='${tier.minimum_quantity}'/>"><span class="field-error"><c:out value="${errors['minimum'.concat(loop.index.toString())]}"/></span></label><label class="field">Giá trị giảm <input name="discountValue" type="number" min="0" step="0.000001" required value="<c:out value='${tier.discount_value}'/>"><span class="field-error"><c:out value="${errors['value'.concat(loop.index.toString())]}"/></span></label><button type="button" class="button button-secondary" data-remove-tier>Xóa bậc</button></div></c:forEach></c:when><c:otherwise><div class="form-grid discount-tier"><label class="field">Từ lượng cơ sở <input name="minimum" type="number" min="0" step="0.000001" required value="0"></label><label class="field">Giá trị giảm <input name="discountValue" type="number" min="0" step="0.000001" required value="0"></label><button type="button" class="button button-secondary" data-remove-tier>Xóa bậc</button></div></c:otherwise></c:choose></div><button type="button" class="button button-secondary" data-add-tier>Thêm bậc</button></fieldset><div class="form-actions"><button class="button button-primary">Lưu chính sách</button><a class="button button-secondary" href="${pageContext.request.contextPath}/pricing/discounts">Hủy</a></div></form></details></c:if>
<div class="table-wrap"><table><thead><tr><th>Chính sách</th><th>Đối tượng</th><th>Nhóm khách</th><th>Loại giảm</th><th>Áp dụng</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody><c:forEach items="${policies}" var="p"><tr><td><c:out value="${p.name}"/></td><td><c:out value="${not empty p.product_id ? p.sku : p.category_name}"/></td><td><c:out value="${p.group_name}" default="Tất cả nhóm"/></td><td>${p.mode=='PERCENT' ? 'Phần trăm' : 'Tiền / đơn vị cơ sở'}</td><td>${p.valid_from} → ${p.valid_to}</td><td>${p.status=='ACTIVE' ? 'Đang áp dụng' : 'Ngừng áp dụng'}</td><td><c:if test="${access.allows('DISCOUNT_MANAGE')}"><a href="?id=${p.id}#editor">Sửa / ngừng áp dụng</a></c:if></td></tr></c:forEach><c:if test="${empty policies}"><tr><td colspan="7" class="empty-state">Chưa có chính sách phù hợp.</td></tr></c:if></tbody></table></div><%@ include file="../fragments/pagination.jspf" %></main></body></html>
