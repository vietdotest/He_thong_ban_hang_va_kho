<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="vi"><head><meta name="viewport" content="width=device-width,initial-scale=1"><title>Tài khoản cổng đại lý</title><%@ include file="../fragments/assets.jspf" %></head><body class="app-page"><%@ include file="../fragments/sidebar.jspf" %><%@ include file="../fragments/topbar.jspf" %><main class="page-body app-content catalog-page"><div class="page-heading"><div><h1>Tài khoản cổng đại lý</h1><p>Mỗi tài khoản liên kết một đại lý. Không cấp quyền quản trị người dùng nội bộ.</p></div></div><c:if test="${param.notice=='saved'}"><p class="alert alert-success" role="status">Đã hoàn tất thao tác và ghi audit.</p></c:if><c:if test="${not empty errors}"><div class="alert alert-error" role="alert"><c:forEach items="${errors}" var="e"><p><c:out value="${e.value}"/></p></c:forEach></div></c:if><section class="content-panel"><h2 class="panel-heading">Cấp tài khoản mới</h2><form method="post" class="account-form dealer-profile-form"><input type="hidden" name="_csrf" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="action" value="create"><label class="field">Đại lý <select name="dealer" data-lookup="dealers" required><option value="">Gõ mã / tên đại lý</option><c:if test="${not empty selectedDealer}"><option value="${selectedDealer.id}" selected><c:out value="${selectedDealer.code}"/> — <c:out value="${selectedDealer.name}"/></option></c:if></select></label><label class="field">Tên đăng nhập <input name="username" required maxlength="64" value="<c:out value='${form.username}'/>"><span class="field-error"><c:out value="${errors.username}"/></span></label><label class="field">Email kích hoạt <input name="email" type="email" required maxlength="254" value="<c:out value='${form.email}'/>"><span class="field-error"><c:out value="${errors.email}"/></span></label><label class="field">Họ tên <input name="fullName" required maxlength="150" value="<c:out value='${form.fullName}'/>"><span class="field-error"><c:out value="${errors.fullName}"/></span></label><label class="field">Điện thoại <input name="phone" required maxlength="30" value="<c:out value='${form.phone}'/>"><span class="field-error"><c:out value="${errors.phone}"/></span></label><div class="form-actions"><button class="button button-primary">Cấp và gửi kích hoạt</button></div></form></section><p class="alert" role="note">Email timeout chưa rõ kết quả sẽ giữ dấu lần thử và chặn gửi lại tự động. Kiểm tra SMTP trước khi xử lý; không lưu mật khẩu hoặc token rõ trong báo cáo.</p><form method="get" class="filter-form"><label class="filter-search">Tìm tài khoản / đại lý <input name="q" maxlength="150" value="<c:out value='${param.q}'/>"></label><input type="hidden" name="pageSize" value="${pagination.pageSize}"><button class="button button-primary">Tìm kiếm</button></form><div class="table-wrap"><table><thead><tr><th>Tài khoản</th><th>Đại lý</th><th>Trạng thái</th><th>Quản lý</th></tr></thead><tbody><c:forEach items="${accounts}" var="u"><tr><td><c:out value="${u.username}"/><br><c:out value="${u.full_name}"/><br><c:out value="${u.email}"/></td><td><c:out value="${u.dealer_code}"/> — <c:out value="${u.dealer_name}"/></td><td><c:out value="${u.status}"/></td><td><details><summary>Thao tác tài khoản</summary><form method="post"><input type="hidden" name="_csrf" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="userId" value="${u.id}"><input type="hidden" name="version" value="${not empty form and form.userId==u.id.toString()?form.version:u.version}"><label class="field">Lý do khóa / mở <input name="reason" required maxlength="1000" value="<c:out value='${not empty form and form.userId==u.id.toString()?form.reason:""}'/>"></label><button class="button button-secondary" name="action" value="${u.status=='ADMIN_LOCKED'?'unlock':'lock'}">${u.status=='ADMIN_LOCKED'?'Mở tài khoản':'Khóa tài khoản'}</button></form><c:if test="${u.status=='PENDING_ACTIVATION'}"><form method="post"><input type="hidden" name="_csrf" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="action" value="resend"><input type="hidden" name="userId" value="${u.id}"><input type="hidden" name="version" value="${not empty form and form.userId==u.id.toString()?form.version:u.version}"><button class="button button-secondary">Gửi lại kích hoạt</button></form></c:if><form method="post"><input type="hidden" name="_csrf" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="action" value="relink"><input type="hidden" name="userId" value="${u.id}"><input type="hidden" name="version" value="${not empty form and form.userId==u.id.toString()?form.version:u.version}"><label class="field">Đại lý mới <select name="dealer" data-lookup="dealers" required><option value="">Tìm đại lý mới</option></select></label><label class="field">Lý do đổi liên kết <input name="reason" required maxlength="1000" value="<c:out value='${not empty form and form.userId==u.id.toString()?form.reason:""}'/>"></label><button class="button button-secondary">Đổi liên kết và thu hồi phiên</button></form><a href="${pageContext.request.contextPath}/dealers/accounts?userId=${u.id}">Lịch sử liên kết</a></details></td></tr></c:forEach><c:if test="${empty accounts}"><tr><td colspan="4" class="empty-state">Không có tài khoản đại lý phù hợp.</td></tr></c:if></tbody></table></div><%@ include file="../fragments/pagination.jspf" %><c:if test="${not empty param.userId}"><h2>Lịch sử đổi liên kết</h2><c:forEach items="${linkHistory}" var="h"><p><c:out value="${h.old_code}"/> → <c:out value="${h.new_code}"/> · <c:out value="${h.reason}"/> · <c:out value="${h.actor_name}"/> · ${h.changed_at}</p></c:forEach><c:if test="${empty linkHistory}"><p>Chưa có thay đổi liên kết.</p></c:if><%@ include file="link-history-pagination.jspf" %></c:if></main></body></html>
