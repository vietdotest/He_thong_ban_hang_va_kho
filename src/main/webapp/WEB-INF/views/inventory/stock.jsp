<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %><fmt:setLocale value="vi_VN"/>
<layout:page title="Tồn kho và khả dụng" view="inventory/stock" bodyClass="app-page" css="mvp" bare="false">
<jsp:body>
<main class="page-body app-content catalog-page">
<div class="page-heading"><div><h1>Tồn kho và khả dụng</h1><p>Khả dụng = tồn thực trừ giữ chỗ còn hiệu lực. Các lượng hiển thị theo đơn vị cơ sở.</p></div></div><form method="get" class="content-panel padded-panel"><label class="field">Kho <select name="warehouse"><option value="">Tất cả kho trong phạm vi</option><c:forEach items="${warehouses}" var="warehouse"><option value="${warehouse.id}" ${param.warehouse==warehouse.id.toString()?'selected':''}><c:out value="${warehouse.code}"/> — <c:out value="${warehouse.name}"/> · <c:out value="${warehouse.address}"/></option></c:forEach></select></label><label class="field">SKU / tên hàng <input name="q" maxlength="150" value="<c:out value='${param.q}'/>"></label><label class="field">Nhóm hàng và nhóm con <select name="category"><option value="">Tất cả nhóm</option><c:forEach items="${categories}" var="category"><option value="${category.id}" ${param.category==category.id.toString()?'selected':''}><c:out value="${category.name}"/></option></c:forEach></select></label><label class="field">Trạng thái khả dụng <select name="state"><option value="">Tất cả</option><option value="AVAILABLE" ${param.state=='AVAILABLE'?'selected':''}>Còn khả dụng</option><option value="UNAVAILABLE" ${param.state=='UNAVAILABLE'?'selected':''}>Hết khả dụng</option></select></label><ui:button variant="primary">Xem tồn</ui:button><a class="button button-secondary" href="${pageContext.request.contextPath}/inventory/stock">Bỏ lọc</a></form>
<section class="content-panel padded-panel"><h2>Tồn trong phạm vi</h2><div class="table-wrap"><table><thead><tr><th>Kho / địa chỉ</th><th>SKU / sản phẩm</th><th>Đơn vị cơ sở</th><th>Thực tế</th><th>Giữ chỗ</th><th>Khả dụng</th><th>Thẻ kho</th></tr></thead><tbody><c:forEach items="${stock}" var="row"><tr><td><c:out value="${row.warehouse_code}"/> — <c:out value="${row.warehouse_name}"/><br><c:out value="${row.address}"/></td><td><c:out value="${row.sku}"/> — <c:out value="${row.name}"/><c:if test="${row.status!='ACTIVE'}"><br>Ngừng kinh doanh</c:if></td><td><c:out value="${row.base_unit}"/></td><td><c:choose><c:when test="${row.physical}"><fmt:formatNumber value="${row.onHand}" pattern="#,##0.############"/></c:when><c:otherwise>—</c:otherwise></c:choose></td><td><c:choose><c:when test="${row.physical}"><fmt:formatNumber value="${row.reserved}" pattern="#,##0.############"/></c:when><c:otherwise>—</c:otherwise></c:choose></td><td><strong><fmt:formatNumber value="${row.available}" pattern="#,##0.############"/></strong></td><td><c:if test="${row.can_card}"><a href="${pageContext.request.contextPath}/inventory/card?warehouse=${row.warehouse_id}&amp;product=${row.product_id}">Thẻ kho</a></c:if></td></tr></c:forEach><c:if test="${empty stock}"><tr><td colspan="7">Chưa có tồn phù hợp trong phạm vi.</td></tr></c:if></tbody></table></div></section>
</main>
</jsp:body>
</layout:page>
