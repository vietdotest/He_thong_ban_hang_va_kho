        <mxCell id="p04-n86" value="D" style="rounded=0;html=0;whiteSpace=wrap;overflow=hidden;fillColor=#F2F7FA;strokeColor=#CBD8E2;fontColor=#183247;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=12;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="1590" y="678" width="160" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p04-n87" value="BẢY VAI TRÒ&#10;ADMIN: Quản trị hệ thống; SALES_MANAGER: Quản lý kinh doanh; SALES_STAFF: Nhân viên kinh doanh; WAREHOUSE_MANAGER: Quản lý kho; WAREHOUSE_STAFF: Nhân viên kho; AR_ACCOUNTANT: Kế toán công nợ; DEALER: Đại lý.&#10;Chỉ ADMIN đã có trong seed. Quyền nhập/xuất kho, đơn hàng, hóa đơn ở sprint sau không tự động được cấp ở đây." style="rounded=1;arcSize=8;html=0;whiteSpace=wrap;overflow=hidden;fillColor=#F2F7FA;strokeColor=#CBD8E2;fontColor=#183247;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=12;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="50" y="770" width="1700" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p04-n88" value="ĐA VAI TRÒ VÀ PHẠM VI&#10;Hợp quyền của các vai trò, sau đó kiểm tra kho/địa bàn. COST_PRICE_VIEW và PROFIT_MARGIN_VIEW còn yêu cầu có SALES_MANAGER; ADMIN đơn lẻ không được bypass. Người mang vai trò kho mà chưa gán kho bị chặn thao tác kho. Menu chỉ hiện quyền đã cấp; server vẫn kiểm tra từng request." style="rounded=1;arcSize=8;html=0;whiteSpace=wrap;overflow=hidden;fillColor=#E8F6F1;strokeColor=#CBD8E2;fontColor=#183247;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=12;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="50" y="930" width="1700" height="125" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
