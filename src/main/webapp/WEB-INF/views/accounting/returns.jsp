<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %><fmt:setLocale value="vi_VN"/>
<!doctype html><html lang="vi"><head><meta name="viewport" content="width=device-width,initial-scale=1"><title>Trả hàng theo hóa đơn</title><%@ include file="../fragments/assets.jspf" %><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/mvp.css"></head><body class="app-page"><%@ include file="../fragments/sidebar.jspf" %><%@ include file="../fragments/topbar.jspf" %><main class="page-body app-content catalog-page">
<div class="page-heading"><div><h1>Trả hàng theo hóa đơn</h1><p>Hàng tốt về đúng lô nguồn; hàng hỏng không tăng tồn bán được. Giảm trừ chỉ được phát hành sau khi kho xác nhận nhận hàng.</p></div></div><c:if test="${param.notice=='saved'}"><p class="alert alert-success" role="status">Đã ghi nhận phiếu trả.</p></c:if><c:forEach items="${errors}" var="error"><p class="alert alert-error" role="alert"><c:out value="${error.value}"/></p></c:forEach>
<c:if test="${not empty document}"><section class="content-panel padded-panel"><h2><c:out value="${document.number}"/> · ${document.status=='DRAFT'?'Chờ nhận hàng':document.status=='RECEIVED'?'Kho đã nhận':'Đã hủy'}</h2><p>Đại lý: <c:out value="${document.dealer_name}"/> · Kho nguồn: <c:out value="${document.warehouse_name}"/></p><p>Hóa đơn gốc: <c:choose><c:when test="${access.allows('INVOICE_READ')}"><a href="${pageContext.request.contextPath}/accounting/invoices?id=${document.invoice_id}"><c:out value="${document.invoice_number}"/></a></c:when><c:otherwise><c:out value="${document.invoice_number}"/></c:otherwise></c:choose></p><p>Lý do: <c:out value="${document.reason}"/></p><div class="table-wrap"><table><thead><tr><th>SKU / sản phẩm</th><th>Lô nguồn</th><th>Lượng trả</th><th>Đơn vị cơ sở</th><th>Tình trạng</th></tr></thead><tbody><c:forEach items="${document.lines}" var="line"><tr><td><c:out value="${line.sku_snapshot}"/> — <c:out value="${line.name_snapshot}"/></td><td><c:out value="${line.lot_code}"/></td><td><fmt:formatNumber value="${line.quantity}" pattern="#,##0.############"/></td><td><c:out value="${line.unit_snapshot}"/></td><td>${line.condition_code=='SELLABLE'?'Còn bán được':'Hàng hỏng'}</td></tr></c:forEach></tbody></table></div>
<c:if test="${document.can_receive}"><form method="post"><input type="hidden" name="_csrf" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="action" value="receive"><input type="hidden" name="id" value="${document.id}"><input type="hidden" name="version" value="${document.version}"><input type="hidden" name="requestKey" value="${requestKey}"><p>Nếu lượng hoặc tình trạng thực về khác phiếu, NVKD cần sửa phiếu nháp trước khi kho nhận.</p><label class="checkbox-field"><input name="physicallyConfirmed" type="checkbox" required value="true">Tôi xác nhận đã thực nhận đúng lượng và tình trạng từng dòng.</label><button class="button button-primary">Xác nhận kho nhận hàng trả</button></form></c:if><c:if test="${document.status=='RECEIVED'}"><p>${document.credited?'Đã phát hành giảm trừ':'Chờ kế toán phát hành giảm trừ'}. Phiếu đã nhận chỉ đọc.</p></c:if></section></c:if>
<c:if test="${not empty sourceInvoice}"><section class="content-panel padded-panel"><h2>${empty document?'Lập phiếu trả':'Sửa phiếu chưa nhận'} · <c:out value="${sourceInvoice.number}"/></h2><p><c:out value="${sourceInvoice.dealer_name_snapshot}"/> · <c:out value="${sourceInvoice.address_snapshot}"/></p><form method="post"><input type="hidden" name="_csrf" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="action" value="save"><input type="hidden" name="id" value="${empty document?0:document.id}"><input type="hidden" name="invoice" value="${sourceInvoice.id}"><input type="hidden" name="version" value="${empty document?0:document.version}"><input type="hidden" name="requestKey" value="${requestKey}"><c:forEach items="${sourceInvoice.lines}" var="line"><div class="mvp-line"><h3><c:out value="${line.sku_snapshot}"/> — <c:out value="${line.name_snapshot}"/></h3><p>Tối đa chưa trả: <fmt:formatNumber value="${line.remaining}" pattern="#,##0.############"/> <c:out value="${line.unit_snapshot}"/> (tính cả phiếu đang chờ khác).</p><input type="hidden" name="invoiceLine" value="${line.id}"><label class="field">Lượng tốt <input name="sellable" type="number" min="0" max="${line.remaining}" step="0.000000000001" required value="<c:out value='${lineValues[line.id.toString()].sellable}'/>"></label><label class="field">Lượng hỏng <input name="damaged" type="number" min="0" max="${line.remaining}" step="0.000000000001" required value="<c:out value='${lineValues[line.id.toString()].damaged}'/>"></label></div></c:forEach><label class="field">Lý do trả <textarea name="reason" required maxlength="1000"><c:out value="${reason}"/></textarea></label><button class="button button-primary">Lưu phiếu trả chờ kho nhận</button></form></section></c:if>
<c:if test="${document.can_edit}"><section class="content-panel padded-panel"><h2>Hủy phiếu chưa nhận</h2><form method="post"><input type="hidden" name="_csrf" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="action" value="cancel"><input type="hidden" name="id" value="${document.id}"><input type="hidden" name="version" value="${document.version}"><input type="hidden" name="requestKey" value="${requestKey}"><label class="field">Lý do hủy <textarea name="reason" required maxlength="1000"></textarea></label><button class="button button-secondary">Hủy phiếu trả nháp</button></form></section></c:if>
<c:if test="${not empty invoices}"><section class="content-panel padded-panel"><h2>Chọn hóa đơn gốc để lập phiếu</h2><c:forEach items="${invoices}" var="invoice"><p><a href="${pageContext.request.contextPath}/accounting/returns?invoice=${invoice.id}"><c:out value="${invoice.number}"/></a> · <c:out value="${invoice.dealer_name}"/> · ${invoice.invoice_date}</p></c:forEach></section></c:if>
<section class="content-panel padded-panel"><h2>Phiếu trả trong phạm vi</h2><div class="table-wrap"><table><thead><tr><th>Phiếu</th><th>Đại lý</th><th>Kho nguồn</th><th>Hóa đơn gốc</th><th>Trạng thái</th></tr></thead><tbody><c:forEach items="${returns}" var="item"><tr><td><a href="${pageContext.request.contextPath}/accounting/returns?id=${item.id}"><c:out value="${item.number}"/></a></td><td><c:out value="${item.dealer_name}"/></td><td><c:out value="${item.warehouse_name}"/></td><td><c:out value="${item.invoice_number}"/></td><td>${item.status=='DRAFT'?'Chờ nhận':item.status=='RECEIVED'?'Đã nhận':'Đã hủy'}</td></tr></c:forEach><c:if test="${empty returns}"><tr><td colspan="5">Chưa có phiếu trả trong phạm vi.</td></tr></c:if></tbody></table></div></section>
</main></body></html>
