        <mxCell id="p13-n11" value="Ghi audit ACCOUNT_LOCK&#10;Gắn cảnh báo bàn giao" style="rounded=1;arcSize=10;html=0;whiteSpace=wrap;overflow=hidden;fillColor=#FFFFFF;strokeColor=#CBD8E2;fontColor=#183247;fontFamily=Arial;fontSize=15;fontStyle=0;align=center;verticalAlign=middle;spacing=12;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="1097.0" y="260" width="304.0" height="104" as="geometry" />
        </mxCell>
        <mxCell id="p13-n12" value="Commit&#10;Chặn login/request mới" style="rounded=1;arcSize=50;html=0;whiteSpace=wrap;overflow=hidden;fillColor=#E8F6F1;strokeColor=#087F8C;fontColor=#183247;fontFamily=Arial;fontSize=15;fontStyle=0;align=center;verticalAlign=middle;spacing=12;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="1446.0" y="260" width="304.0" height="104" as="geometry" />
        </mxCell>
        <mxCell id="p13-n17" value="Từ chối / lỗi&#10;Thiếu lý do / thiếu quyền&#10;Bảo vệ admin cuối" style="rounded=1;arcSize=50;html=0;whiteSpace=wrap;overflow=hidden;fillColor=#FFF0EC;strokeColor=#087F8C;fontColor=#183247;fontFamily=Arial;fontSize=16;fontStyle=0;align=center;verticalAlign=middle;spacing=12;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="365" y="430" width="370" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p13-n19" value="TÍNH NGUYÊN TỬ&#10;Kiểm tra admin cuối và cập nhật trong transaction để tránh race. Lỗi status/history/revoke/audit -&gt; rollback. Cảnh báo bàn giao được suy ra từ trạng thái đã commit; không báo khóa thành công khi revoke thất bại." style="rounded=1;arcSize=8;html=0;whiteSpace=wrap;overflow=hidden;fillColor=#FFF7E5;strokeColor=#CBD8E2;fontColor=#183247;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=12;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="810" y="425" width="940" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p13-n20" value="MỞ KHÓA / POST /admin/users/unlock [TK]" style="text;html=0;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;fontColor=#087F8C;fontFamily=Arial;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=1.2;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="50" y="600" width="1450" height="32" as="geometry" />
        </mxCell>
        <mxCell id="p13-n21" value="Kiểm ACCOUNT_UNLOCK&#10;Xác nhận đúng tài khoản" style="rounded=1;arcSize=10;html=0;whiteSpace=wrap;overflow=hidden;fillColor=#FFFFFF;strokeColor=#CBD8E2;fontColor=#183247;fontFamily=Arial;fontSize=15;fontStyle=0;align=center;verticalAlign=middle;spacing=12;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="50.0" y="655" width="391.25" height="104" as="geometry" />
        </mxCell>
        <mxCell id="p13-n22" value="TX: chuyển ACTIVE&#10;History + audit ACCOUNT_UNLOCK" style="rounded=1;arcSize=10;html=0;whiteSpace=wrap;overflow=hidden;fillColor=#FFFFFF;strokeColor=#CBD8E2;fontColor=#183247;fontFamily=Arial;fontSize=15;fontStyle=0;align=center;verticalAlign=middle;spacing=12;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="486.25" y="655" width="391.25" height="104" as="geometry" />
        </mxCell>
        <mxCell id="p13-n23" value="Commit&#10;Phiên cũ vẫn revoked" style="rounded=1;arcSize=10;html=0;whiteSpace=wrap;overflow=hidden;fillColor=#FFFFFF;strokeColor=#CBD8E2;fontColor=#183247;fontFamily=Arial;fontSize=15;fontStyle=0;align=center;verticalAlign=middle;spacing=12;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="922.5" y="655" width="391.25" height="104" as="geometry" />
        </mxCell>
        <mxCell id="p13-n24" value="Người dùng đăng nhập lại&#10;Tạo phiên mới" style="rounded=1;arcSize=50;html=0;whiteSpace=wrap;overflow=hidden;fillColor=#E8F6F1;strokeColor=#087F8C;fontColor=#183247;fontFamily=Arial;fontSize=15;fontStyle=0;align=center;verticalAlign=middle;spacing=12;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="1358.75" y="655" width="391.25" height="104" as="geometry" />
        </mxCell>
        <mxCell id="p13-n28" value="PHỤ THUỘC MODULE ĐẠI LÝ&#10;Khi có dữ liệu đại lý phụ trách: cảnh báo danh sách cần bàn giao cho quản trị viên. Hiện chưa có schema/module đại lý: ghi nhận điểm tích hợp và thể hiện “Chưa có dữ liệu bàn giao”, không giả vờ kiểm tra hoàn tất. Không xây toàn bộ module đại lý trong Sprint 1." style="rounded=1;arcSize=8;html=0;whiteSpace=wrap;overflow=hidden;fillColor=#F2F7FA;strokeColor=#CBD8E2;fontColor=#183247;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=12;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="50" y="875" width="1700" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p13-n29" value="PHÂN BIỆT&#10;Temporary lock: locked_until, tự hết thời hạn; admin lock: users.status=ADMIN_LOCKED, chỉ mở bằng thao tác được cấp quyền. Mở admin lock không khôi phục session đã thu hồi và không bỏ qua các kiểm tra đăng nhập khác." style="rounded=1;arcSize=8;html=0;whiteSpace=wrap;overflow=hidden;fillColor=#E8F6F1;strokeColor=#CBD8E2;fontColor=#183247;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=12;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="50" y="1020" width="1700" height="105" as="geometry" />
        </mxCell>
