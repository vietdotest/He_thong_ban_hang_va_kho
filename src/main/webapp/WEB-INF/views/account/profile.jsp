<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="vi"><head><meta name="viewport" content="width=device-width,initial-scale=1"><title>Hồ sơ cá nhân</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/app.css"></head><body class="app-page"><%@ include file="../fragments/sidebar.jspf" %><main class="page-body app-content"><h1>Hồ sơ cá nhân</h1><c:if test="${param.notice == 'saved'}"><div class="alert">Đã lưu hồ sơ.</div></c:if><section class="content-panel"><p>Tên đăng nhập: <c:out value="${profile.username}"/></p><p>Email: <c:out value="${profile.email}"/></p><p>Vai trò, kho và địa bàn do quản trị hệ thống phân công.</p><form method="post" class="account-form"><input type="hidden" name="_csrf" value="<c:out value='${csrfToken}'/>"><label class="field">Họ tên <input name="fullName" required maxlength="150" value="<c:out value='${profile.full_name}'/>"></label><label class="field">Số điện thoại <input type="tel" name="phone" required maxlength="20" value="<c:out value='${profile.phone}'/>"></label><button class="button button-primary">Lưu hồ sơ</button></form></section></main></body></html>
