<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %><fmt:setLocale value="vi_VN"/>
<!doctype html><html lang="vi"><head><meta name="viewport" content="width=device-width,initial-scale=1"><title>Đơn hàng</title><%@ include file="../fragments/assets.jspf" %></head><body class="app-page"><%@ include file="../fragments/sidebar.jspf" %><%@ include file="../fragments/topbar.jspf" %>
<main class="page-body app-content catalog-page"><div class="page-heading"><div><h1>Đơn hàng</h1><p>Nháp → gửi tiếp nhận. Chưa duyệt đơn, xuất kho hoặc ghi công nợ.</p></div><c:if test="${access.allows('ORDER_WRITE')}"><a class="button button-primary" href="${pageContext.request.contextPath}/orders?action=new">Tạo đơn nháp</a></c:if></div>
<form method="get" class="filter-form"><label class="filter-search">Tìm số đơn / mã / tên đại lý <input name="q" maxlength="150" value="<c:out value='${param.q}'/>"></label><label>Trạng thái <select name="status"><option value="">Tất cả</option><option value="DRAFT" ${param.status=='DRAFT'?'selected':''}>Nháp</option><option value="SUBMITTED" ${param.status=='SUBMITTED'?'selected':''}>Đã gửi tiếp nhận</option></select></label><c:if test="${not empty param.dealer}"><input type="hidden" name="dealer" value="<c:out value='${param.dealer}'/>"></c:if><input type="hidden" name="pageSize" value="${pagination.pageSize}"><button class="button button-primary">Tìm kiếm</button><a class="button button-secondary" href="${pageContext.request.contextPath}/orders">Bỏ lọc</a></form>
<div class="table-wrap"><table><thead><tr><th>Số đơn</th><th>Đại lý</th><th>Ngày giao mong muốn</th><th>Trạng thái</th><th>Phải thu (đ)</th><th>Chi tiết</th></tr></thead><tbody><c:forEach items="${orders}" var="o"><tr><td>ĐH-${o.id}</td><td><c:out value="${o.dealer_code}"/><br><c:out value="${o.dealer_name}"/><c:if test="${o.transaction_locked}"><br><span class="field-error">Đại lý hiện bị khóa</span></c:if></td><td>${o.desired_delivery}</td><td>${o.status=='DRAFT'?'Nháp':'Đã gửi tiếp nhận'}</td><td><c:choose><c:when test="${o.status=='DRAFT'}">Tính lại khi mở / gửi</c:when><c:otherwise><fmt:formatNumber value="${o.net_total}" pattern="#,##0.####"/></c:otherwise></c:choose></td><td><c:url var="detail" value="/orders"><c:param name="id" value="${o.id}"/><c:param name="q" value="${param.q}"/><c:param name="status" value="${param.status}"/><c:param name="page" value="${pagination.page}"/><c:param name="pageSize" value="${pagination.pageSize}"/><c:param name="dealer" value="${param.dealer}"/></c:url><a class="button button-secondary" href="<c:out value='${detail}'/>">Mở đơn</a></td></tr></c:forEach><c:if test="${empty orders}"><tr><td colspan="6" class="empty-state">Không có đơn phù hợp trong phạm vi của bạn.</td></tr></c:if></tbody></table></div><%@ include file="../fragments/pagination.jspf" %></main></body></html>
