<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<layout:page title="Hồ sơ đại lý" view="dealers/list" bodyClass="app-page" css="dealers" bare="false">
<jsp:body>
<main class="page-body app-content catalog-page dealers-page"><div class="page-heading"><div><h1>Đại lý</h1><p>Danh sách khách hàng chuẩn, nhóm bảng giá và phụ trách chính.</p></div><c:if test="${access.allows('DEALER_MANAGE')}"><a class="button button-primary" href="?new=1#editor" data-editor="editor"><ui:icon name="plus"/> Thêm đại lý</a></c:if></div>
<c:if test="${param.notice == 'saved' and empty errors}"><p class="alert alert-success" role="status">Đã lưu thay đổi.</p></c:if>
<c:if test="${not empty errors.form}"><p class="alert alert-error" role="alert"><c:out value="${errors.form}"/></p></c:if>
<form method="get" class="filter-form"><label class="filter-search">Tìm mã, tên, mã số thuế, điện thoại <input name="q" maxlength="150" value="<c:out value='${dealerFilter.q}'/>"></label><input type="hidden" name="pageSize" value="${pagination.pageSize}"><details class="filter-choice"><summary class="button button-secondary">Khu vực <ui:icon name="chevron-down"/><c:if test="${not empty dealerFilter.territory}"><span class="filter-indicator" aria-label="Đang lọc">•</span></c:if></summary><label>Khu vực <select name="territory"><option value="">Tất cả khu vực</option><c:forEach items="${filterTerritories}" var="o"><option value="${o.id}" ${dealerFilter.territory == o.id.toString() ? 'selected' : ''}><c:out value="${o.name}"/></option></c:forEach></select></label></details><details class="filter-choice"><summary class="button button-secondary">Nhóm khách <ui:icon name="chevron-down"/><c:if test="${not empty dealerFilter.group}"><span class="filter-indicator" aria-label="Đang lọc">•</span></c:if></summary><label>Nhóm khách <select name="group"><option value="">Tất cả nhóm</option><c:forEach items="${filterGroups}" var="o"><option value="${o.id}" ${dealerFilter.group == o.id.toString() ? 'selected' : ''}><c:out value="${o.name}"/></option></c:forEach></select></label></details><details class="filter-choice"><summary class="button button-secondary">Phụ trách <ui:icon name="chevron-down"/><c:if test="${not empty dealerFilter.staff}"><span class="filter-indicator" aria-label="Đang lọc">•</span></c:if></summary><label>Phụ trách <select name="staff"><option value="">Tất cả phụ trách</option><c:forEach items="${filterStaff}" var="o"><option value="${o.id}" ${dealerFilter.staff == o.id.toString() ? 'selected' : ''}><c:out value="${o.name}"/></option></c:forEach></select></label></details><details class="filter-choice"><summary class="button button-secondary">Trạng thái <ui:icon name="chevron-down"/><c:if test="${not empty dealerFilter.status}"><span class="filter-indicator" aria-label="Đang lọc">•</span></c:if></summary><label>Trạng thái <select name="status"><option value="">Tất cả trạng thái</option><option value="ACTIVE" ${dealerFilter.status == 'ACTIVE' ? 'selected' : ''}>Đang giao dịch</option><option value="LOCKED" ${dealerFilter.status == 'LOCKED' ? 'selected' : ''}>Bị khóa giao dịch</option><option value="DISCONTINUED" ${dealerFilter.status == 'DISCONTINUED' ? 'selected' : ''}>Ngừng giao dịch</option></select></label></details><ui:button variant="primary">Tìm</ui:button><a class="button button-secondary" href="${pageContext.request.contextPath}/dealers">Bỏ bộ lọc</a></form>
<c:if test="${access.allows('DEALER_MANAGE')}"><details id="editor" class="content-panel disclosure editor" ${not empty edit.id or not empty errors or param['new']=='1' ? 'open' : ''}><summary>${empty edit.id ? 'Thêm đại lý' : 'Sửa hồ sơ đại lý'}</summary>
<form method="post" class="account-form dealer-profile-form"><input type="hidden" name="_csrf" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="id" value="<c:out value='${edit.id}'/>"><input type="hidden" name="version" value="<c:out value='${edit.version}'/>"><input type="hidden" name="q" value="<c:out value='${param.q}'/>"><input type="hidden" name="page" value="${pagination.page}"><input type="hidden" name="pageSize" value="${pagination.pageSize}">
<c:forEach var="key" items="${['group','territory','staff','status']}"><input type="hidden" name="filter${key.substring(0,1).toUpperCase()}${key.substring(1)}" value="<c:out value='${dealerFilter[key]}'/>"></c:forEach>
<label class="field">Mã đại lý <input name="code" required maxlength="50" value="<c:out value='${edit.code}'/>" aria-invalid="${not empty errors.code}" aria-describedby="code-error"><span id="code-error" class="field-error"><c:out value="${errors.code}"/></span></label>
<label class="field">Tên đại lý <input name="name" required maxlength="200" value="<c:out value='${edit.name}'/>" aria-invalid="${not empty errors.name}" aria-describedby="name-error"><span id="name-error" class="field-error"><c:out value="${errors.name}"/></span></label>
<label class="field">Mã số thuế <input name="taxCode" maxlength="14" value="<c:out value='${edit.tax_code}'/>" aria-invalid="${not empty errors.taxCode}" aria-describedby="taxCode-error"><span id="taxCode-error" class="field-error"><c:out value="${errors.taxCode}"/></span></label>
<label class="field">Điện thoại <input name="phone" type="tel" required maxlength="30" value="<c:out value='${edit.phone}'/>" aria-invalid="${not empty errors.phone}" aria-describedby="phone-error"><span id="phone-error" class="field-error"><c:out value="${errors.phone}"/></span></label>
<label class="field">Nhóm bảng giá <select name="group" required aria-invalid="${not empty errors.group}"><option value="">Chọn nhóm</option><c:forEach items="${groups}" var="g"><option value="${g.id}" ${edit.group_id == g.id.toString() ? 'selected' : ''}><c:out value="${g.name}"/></option></c:forEach></select><span class="field-error"><c:out value="${errors.group}"/></span></label>
<label class="field">Khu vực <select name="territory" required aria-invalid="${not empty errors.territory}"><option value="">Chọn khu vực</option><c:forEach items="${territories}" var="t"><option value="${t.id}" ${edit.territory_id == t.id.toString() ? 'selected' : ''}><c:out value="${t.code}"/> — <c:out value="${t.name}"/></option></c:forEach></select><span class="field-error"><c:out value="${errors.territory}"/></span></label>
<label class="field">Phụ trách chính <select name="staff" required aria-invalid="${not empty errors.staff}"><option value="">Chọn nhân viên kinh doanh</option><c:forEach items="${staff}" var="u"><option value="${u.id}" ${edit.primary_staff_id == u.id.toString() ? 'selected' : ''}><c:out value="${u.code}"/> — <c:out value="${u.name}"/></option></c:forEach></select><span class="field-error"><c:out value="${errors.staff}"/></span><c:if test="${not empty edit.id}"><small>Đổi phụ trách qua chức năng bàn giao.</small></c:if></label>
<label class="field">Kho phục vụ <select name="warehouse" aria-invalid="${not empty errors.warehouse}"><option value="">Chưa chọn kho</option><c:forEach items="${warehouses}" var="w"><option value="${w.id}" ${edit.warehouse_id == w.id.toString() ? 'selected' : ''}><c:out value="${w.name}"/> — <c:out value="${w.address}"/></option></c:forEach></select><span class="field-error"><c:out value="${errors.warehouse}"/></span><small>Chưa có kho vẫn lưu nháp; không thể gửi đơn.</small></label>
<label class="field">Trạng thái hồ sơ <select name="status"><option value="ACTIVE">Đang giao dịch</option><option value="DISCONTINUED" ${edit.status == 'DISCONTINUED' ? 'selected' : ''}>Ngừng giao dịch</option></select><span class="field-error"><c:out value="${errors.status}"/></span></label>
<div class="form-actions"><ui:button variant="primary">Lưu hồ sơ</ui:button><a class="button button-secondary" href="${pageContext.request.contextPath}/dealers">Hủy</a></div></form></details></c:if>
<c:if test="${not empty edit.id}">
<c:if test="${not access.allows('DEALER_MANAGE')}"><section id="editor" class="content-panel padded-panel dealer-readonly"><h2>Xem hồ sơ đại lý</h2><dl><dt>Mã / tên</dt><dd><c:out value="${edit.code}"/> — <c:out value="${edit.name}"/></dd><dt>Điện thoại</dt><dd><c:out value="${edit.phone}"/></dd><dt>Mã số thuế</dt><dd><c:out value="${edit.tax_code}"/></dd><dt>Nhóm bảng giá</dt><dd><c:out value="${edit.group_name}"/></dd><dt>Khu vực</dt><dd><c:out value="${edit.territory_name}"/></dd><dt>Phụ trách / kho</dt><dd><c:out value="${edit.staff_name}"/> / <c:out value="${edit.warehouse_name}" default="Chưa chọn kho"/></dd></dl></section></c:if>
<section class="content-panel padded-panel"><h2>Phần việc liên quan</h2><nav class="dealer-related-links" aria-label="Phần việc đại lý"><a class="button button-secondary" href="${pageContext.request.contextPath}/dealers/addresses?dealer=${edit.id}">Điểm giao hàng</a><a class="button button-secondary" href="${pageContext.request.contextPath}/dealers/credit?dealer=${edit.id}">Hạn mức công nợ</a><a class="button button-secondary" href="${pageContext.request.contextPath}/dealers/status?dealer=${edit.id}">Khóa / mở giao dịch</a><c:if test="${access.allows('DEALER_HANDOVER')}"><a class="button button-secondary" href="${pageContext.request.contextPath}/dealers/handover?fromStaff=${edit.primary_staff_id}&amp;dealerId=${edit.id}">Bàn giao đại lý</a></c:if></nav></section></c:if>
<div class="table-wrap dealer-list-wrap"><table class="dealer-table"><thead><tr><th>Đại lý</th><th>Thao tác</th></tr></thead><tbody><c:forEach items="${dealers}" var="d"><tr><td><strong class="dealer-cell-name"><c:out value="${d.code}"/> · <c:out value="${d.name}"/></strong><span class="dealer-cell-value dealer-meta dealer-meta-desktop"><c:out value="${d.group_name}"/> · ${d.transaction_locked ? 'Bị khóa giao dịch' : d.status == 'ACTIVE' ? 'Đang giao dịch' : 'Ngừng giao dịch'}</span><span class="dealer-meta-mobile"><c:out value="${d.group_name.replace('Đại lý ','')}"/> · ${d.transaction_locked?'Bị khóa':d.status=='ACTIVE'?'Hoạt động':'Ngừng'}</span><div class="dealer-secondary-info"><span class="dealer-cell-value ${d.active_addresses==0?'text-warning':'muted'}">${d.total_addresses==0?'Chưa có điểm giao':d.active_addresses==0?'Chỉ có điểm đã ngừng sử dụng':''}<c:if test="${d.active_addresses>0}">${d.active_addresses} điểm giao đang sử dụng</c:if></span><details class="dealer-row-details"><summary>Thông tin liên hệ</summary><dl><dt>Điện thoại</dt><dd><c:out value="${d.phone}"/></dd><dt>Mã số thuế</dt><dd><c:out value="${d.tax_code}"/></dd><dt>Khu vực</dt><dd><c:out value="${d.territory_name}"/></dd><dt>Phụ trách</dt><dd><c:out value="${d.staff_name}"/></dd><dt>Kho</dt><dd><c:out value="${d.warehouse_name}" default="Chưa chọn kho"/></dd></dl></details></div></td><td><c:url var="editUrl" value="/dealers"><c:param name="id" value="${d.id}"/><c:param name="q" value="${param.q}"/><c:forEach var="key" items="${['group','territory','staff','status']}"><c:param name="${key}" value="${dealerFilter[key]}"/></c:forEach><c:param name="page" value="${pagination.page}"/><c:param name="pageSize" value="${pagination.pageSize}"/></c:url><div class="dealer-actions"><a class="button button-secondary dealer-point-link" href="${pageContext.request.contextPath}/dealers/addresses?dealer=${d.id}">Điểm giao (${d.active_addresses})</a><div class="dealer-edit-actions"><a class="button button-secondary" href="${editUrl}#editor">${access.allows('DEALER_MANAGE')?'Sửa hồ sơ':'Xem hồ sơ'}</a><c:if test="${d.canDelete}"><ui:confirm title="Xóa"><p class="confirm-fallback-note">Xóa hồ sơ chưa phát sinh giao dịch?</p><form method="post" data-confirm="Xóa hồ sơ chưa phát sinh giao dịch?"><input type="hidden" name="_csrf" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="id" value="${d.id}"><input type="hidden" name="version" value="${d.version}"><c:forEach var="key" items="${['group','territory','staff','status']}"><input type="hidden" name="filter${key.substring(0,1).toUpperCase()}${key.substring(1)}" value="<c:out value='${dealerFilter[key]}'/>"></c:forEach><input type="hidden" name="q" value="<c:out value='${dealerFilter.q}'/>"><input type="hidden" name="page" value="${pagination.page}"><input type="hidden" name="pageSize" value="${pagination.pageSize}"><input type="hidden" name="action" value="delete"><ui:button variant="secondary">Xóa</ui:button></form></ui:confirm></c:if><c:if test="${not d.canDelete and access.allows('DEALER_MANAGE')}"><span class="helper-text"><c:out value="${d.deleteBlockReason}"/></span><c:if test="${access.allows('DEALER_STATUS_MANAGE')}"><a class="button button-secondary" href="${pageContext.request.contextPath}/dealers/status?dealer=${d.id}">Quản lý giao dịch</a></c:if></c:if></div></div></td></tr></c:forEach><c:if test="${empty dealers}"><tr><td colspan="2" class="empty-state">Không có đại lý phù hợp trong phạm vi của bạn.</td></tr></c:if></tbody></table></div><ui:pagination page="${pagination}" path="${paginationPath}" pageParameter="${paginationPageParameter}" sizeParameter="${paginationSizeParameter}" filterValues="${paginationFilterValues}" extraParameters="${paginationExtraParameters}"/>
</main>
</jsp:body>
</layout:page>
