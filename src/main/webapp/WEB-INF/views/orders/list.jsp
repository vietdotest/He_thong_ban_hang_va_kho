<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %><fmt:setLocale value="vi_VN"/>
<layout:page title="Đơn hàng" view="orders/list" bodyClass="app-page" css="" bare="false">
<jsp:body>
<main class="page-body app-content catalog-page"><div class="page-heading"><div><h1>Đơn hàng</h1><p>Nháp → xác nhận hoặc duyệt ngoại lệ → giữ hàng → xuất/giao từng phần → hóa đơn. Đơn cổng chỉ giữ sau người tiếp nhận cuối cùng.</p></div><c:if test="${access.allows(portalMode?'PORTAL_ORDER_WRITE':'ORDER_WRITE')}"><a class="button button-primary" href="${pageContext.request.contextPath}${orderPath}?action=new">Tạo đơn nháp</a></c:if></div>
<form method="get" class="filter-form"><label class="filter-search">Tìm số đơn / mã / tên đại lý <input name="q" maxlength="150" value="<c:out value='${param.q}'/>"></label><label>Trạng thái <select name="status"><option value="">Tất cả</option><option value="DRAFT" ${param.status=='DRAFT'?'selected':''}>Nháp</option><option value="SUBMITTED" ${param.status=='SUBMITTED'?'selected':''}>Đã gửi tiếp nhận</option><option value="PENDING_APPROVAL" ${param.status=='PENDING_APPROVAL'?'selected':''}>Chờ xác nhận / duyệt ngoại lệ</option><option value="CANCELLED" ${param.status=='CANCELLED'?'selected':''}>Đã hủy</option><option value="REJECTED" ${param.status=='REJECTED'?'selected':''}>Bị từ chối</option></select></label><c:if test="${not portalMode}"><label>Đại lý <select name="dealer"><option value="">Tất cả trong phạm vi</option><c:forEach items="${orderFilterOptions.dealers}" var="d"><option value="${d.id}" ${param.dealer==d.id.toString()?'selected':''}><c:out value="${d.code}"/> — <c:out value="${d.name}"/></option></c:forEach></select></label><label>Nhân viên phụ trách hiện tại <select name="staff"><option value="">Tất cả trong phạm vi</option><c:forEach items="${orderFilterOptions.staff}" var="s"><option value="${s.id}" ${param.staff==s.id.toString()?'selected':''}><c:out value="${s.name}"/></option></c:forEach></select></label><label>Khu vực <select name="territory"><option value="">Tất cả trong phạm vi</option><c:forEach items="${orderFilterOptions.territories}" var="t"><option value="${t.id}" ${param.territory==t.id.toString()?'selected':''}><c:out value="${t.name}"/></option></c:forEach></select></label></c:if><label>Ngày tạo từ <input type="date" name="from" value="<c:out value='${param.from}'/>"></label><label>Ngày tạo đến <input type="date" name="to" value="<c:out value='${param.to}'/>"></label><input type="hidden" name="pageSize" value="${pagination.pageSize}"><ui:button variant="primary">Tìm kiếm</ui:button><a class="button button-secondary" href="${pageContext.request.contextPath}${orderPath}">Bỏ lọc</a></form>
<p role="status">Kết quả: <c:out value="${pagination.totalItems}"/> đơn · Tổng giá trị: <strong><c:out value="${filteredAmount}"/> đ</strong> (không gồm nháp, hủy, từ chối; không phải doanh thu).</p><div class="table-wrap"><table><thead><tr><th>Số đơn</th><th>Đại lý</th><th>Ngày giao mong muốn</th><th>Trạng thái</th><th>Phải thu (đ)</th><th>Chi tiết</th></tr></thead><tbody><c:forEach items="${orders}" var="o"><tr><td><c:choose><c:when test="${not empty o.number}"><c:out value="${o.number}"/></c:when><c:otherwise>Nháp #${o.id}</c:otherwise></c:choose><br>${o.source=='PORTAL'?'Cổng đại lý':'Nội bộ'}</td><td><c:out value="${o.dealer_code}"/><br><c:out value="${o.dealer_name}"/><c:if test="${o.transaction_locked}"><br><span class="field-error">Đại lý hiện bị khóa</span></c:if></td><td>${o.desired_delivery}</td><td>${o.status=='DRAFT'?'Nháp':o.status=='CANCELLED'?'Đã hủy':o.status=='PENDING_APPROVAL'?(o.pending_reason=='STAFF_CONFIRMATION'?'Chờ NVKD xác nhận':'Chờ duyệt ngoại lệ'):o.status=='REJECTED'?'Bị từ chối':'Đã tiếp nhận'}</td><td><c:choose><c:when test="${o.status=='DRAFT'}">Tính lại khi mở / gửi</c:when><c:otherwise><c:out value="${o.net_formatted}"/></c:otherwise></c:choose></td><td><c:url var="detail" value="${orderPath}"><c:param name="id" value="${o.id}"/><c:param name="q" value="${param.q}"/><c:param name="status" value="${param.status}"/><c:param name="page" value="${pagination.page}"/><c:param name="pageSize" value="${pagination.pageSize}"/><c:param name="dealer" value="${param.dealer}"/><c:forEach var="key" items="${['staff','territory','from','to']}"><c:param name="${key}" value="${param[key]}"/></c:forEach></c:url><a class="button button-secondary" href="<c:out value='${detail}'/>">Mở đơn</a></td></tr></c:forEach><c:if test="${empty orders}"><tr><td colspan="6" class="empty-state">Không có đơn phù hợp trong phạm vi của bạn.</td></tr></c:if></tbody></table></div><ui:pagination page="${pagination}" path="${paginationPath}" pageParameter="${paginationPageParameter}" sizeParameter="${paginationSizeParameter}" filterValues="${paginationFilterValues}" extraParameters="${paginationExtraParameters}"/></main>
</jsp:body>
</layout:page>
