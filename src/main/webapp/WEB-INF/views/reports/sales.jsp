<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %><fmt:setLocale value="vi_VN"/>
<layout:page title="Doanh số và giảm trừ" view="reports/sales" bodyClass="app-page" css="mvp" bare="false">
<jsp:body>
<main class="page-body app-content catalog-page">
<div class="page-heading"><div><h1>Doanh số và giảm trừ</h1><p>Doanh số từ hóa đơn và giảm trừ theo ngày nghiệp vụ. Thu tiền không làm tăng doanh số.</p></div><a class="button button-secondary" href="${pageContext.request.contextPath}/accounting/debt">Công nợ hiện tại</a></div><form method="get" class="content-panel padded-panel"><label class="field">Từ ngày <input name="from" type="date" required value="<c:out value='${from}'/>"></label><label class="field">Đến ngày <input name="to" type="date" required value="<c:out value='${to}'/>"></label><label class="field">Mã / tên đại lý <input name="q" maxlength="150" value="<c:out value='${param.q}'/>"></label><c:if test="${not empty param.dealer}"><input type="hidden" name="dealer" value="<c:out value='${param.dealer}'/>"></c:if><ui:button variant="primary">Xem doanh số</ui:button></form><c:forEach items="${errors}" var="error"><p class="alert alert-error" role="alert"><c:out value="${error.value}"/></p></c:forEach>
<c:if test="${not empty totals}"><section class="content-panel padded-panel"><h2>Tổng trong khoảng ngày và phạm vi</h2><p>Hóa đơn: <fmt:formatNumber value="${totals.invoiced}" pattern="#,##0.####"/> đ · Giảm trừ: <fmt:formatNumber value="${totals.credited}" pattern="#,##0.####"/> đ · Doanh số thuần: <strong><fmt:formatNumber value="${totals.net_sales}" pattern="#,##0.####"/> đ</strong></p><p>Số dư công nợ hiện tại nằm ở màn hình công nợ, được tính từ toàn bộ chứng từ.</p></section></c:if>
<section class="content-panel padded-panel"><h2>Doanh số theo đại lý</h2><div class="table-wrap"><table><thead><tr><th>Đại lý</th><th>Hóa đơn</th><th>Giảm trừ</th><th>Thuần</th></tr></thead><tbody><c:forEach items="${rows}" var="row"><tr><td><c:out value="${row.code}"/> — <c:out value="${row.name}"/></td><td><fmt:formatNumber value="${row.invoiced}" pattern="#,##0.####"/></td><td><fmt:formatNumber value="${row.credited}" pattern="#,##0.####"/></td><td><fmt:formatNumber value="${row.net_sales}" pattern="#,##0.####"/></td></tr></c:forEach><c:if test="${empty rows}"><tr><td colspan="4">Không có đại lý phù hợp trong phạm vi.</td></tr></c:if></tbody></table></div></section>
<section class="content-panel padded-panel"><h2>Chứng từ cấu thành doanh số</h2><div class="table-wrap"><table><thead><tr><th>Ngày</th><th>Loại</th><th>Chứng từ</th><th>Đại lý</th><th>Tiền</th></tr></thead><tbody><c:forEach items="${documents}" var="doc"><tr><td>${doc.document_date}</td><td>${doc.type=='INVOICE'?'Hóa đơn':'Giảm trừ'}</td><td><c:choose><c:when test="${doc.type=='INVOICE' and access.allows('INVOICE_READ')}"><a href="${pageContext.request.contextPath}/accounting/invoices?id=${doc.id}"><c:out value="${doc.number}"/></a></c:when><c:when test="${doc.type=='CREDIT' and access.allows('RETURN_READ')}"><a href="${pageContext.request.contextPath}/accounting/returns?id=${doc.return_id}"><c:out value="${doc.number}"/></a></c:when><c:otherwise><c:out value="${doc.number}"/></c:otherwise></c:choose></td><td><c:out value="${doc.dealer_name}"/></td><td>${doc.type=='CREDIT'?'−':''}<fmt:formatNumber value="${doc.amount}" pattern="#,##0.####"/> đ</td></tr></c:forEach><c:if test="${empty documents}"><tr><td colspan="5">Không có hóa đơn hoặc giảm trừ trong khoảng ngày.</td></tr></c:if></tbody></table></div></section>
</main>
</jsp:body>
</layout:page>
