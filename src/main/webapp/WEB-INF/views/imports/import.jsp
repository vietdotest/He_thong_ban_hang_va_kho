<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="vi"><head><meta name="viewport" content="width=device-width,initial-scale=1"><title><c:out value="${title}"/></title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/app.css"></head><body class="app-page"><%@ include file="../fragments/sidebar.jspf" %><main class="page-body app-content"><h1><c:out value="${title}"/></h1><section class="content-panel"><p>XLSX tối đa 10MB và 10.000 dòng. Vai trò, kho và địa bàn dùng mã, ngăn cách bằng dấu phẩy. Hãy tạo kho/địa bàn trước nếu cần.</p><a class="button" href="?template=1">Tải tệp mẫu</a><form method="post" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<c:out value='${csrfToken}'/>"><label>Tệp XLSX <input type="file" name="file" accept=".xlsx" required></label><button class="button button-primary">Xem trước</button></form></section><c:if test="${not empty report}"><div class="alert">Thành công: <c:out value="${successCount}"/>. Thất bại: <c:out value="${failureCount}"/>.</div></c:if><c:if test="${not empty preview}"><h2>Xem trước</h2><p>Chỉ nhập các dòng hợp lệ. Dữ liệu và quyền sẽ được kiểm tra lại khi xác nhận.</p></c:if><c:if test="${not empty preview or not empty report}"><div class="table-wrap"><table><thead><tr><th>Dòng</th><th>Thao tác</th><c:forEach items="${headers}" var="h"><th><c:out value="${h}"/></th></c:forEach><th>Kết quả</th></tr></thead><tbody><c:forEach items="${not empty preview ? preview.lines : report}" var="line"><tr><td><c:out value="${line.number}"/></td><td><c:out value="${line.operation}"/></td><c:forEach items="${headers}" var="h" varStatus="i"><td><c:out value="${line.cells[i.index]}"/></td></c:forEach><td><c:out value="${empty line.error ? 'Hợp lệ' : line.error}"/></td></tr></c:forEach></tbody></table></div></c:if><c:if test="${not empty preview}"><form method="post"><input type="hidden" name="_csrf" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="action" value="confirm"><input type="hidden" name="token" value="<c:out value='${preview.token}'/>"><button class="button button-primary">Xác nhận nhập dòng hợp lệ</button></form></c:if></main></body></html>
