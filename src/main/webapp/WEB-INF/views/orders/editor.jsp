<%@ taglib prefix="display" uri="urn:codegym:display" %>
<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %><fmt:setLocale value="vi_VN"/>
<layout:page title="Đơn nháp / tiếp nhận" view="orders/editor" bodyClass="app-page" css="orders">
<jsp:attribute name="head"><script defer src="${pageContext.request.contextPath}/assets/js/orders.js?v=${applicationScope.assetVersion}"></script></jsp:attribute>
<jsp:body>
<main class="page-body app-content catalog-page"><div class="page-heading"><div><h1>${empty order ? 'Tạo đơn nháp' : order.status=='DRAFT'?'Đơn nháp':order.status=='PENDING_APPROVAL'?'Đơn chờ duyệt':order.status=='REJECTED'?'Đơn bị từ chối':order.status=='CANCELLED'?'Đơn đã hủy':'Đơn đã gửi tiếp nhận'} <c:if test="${not empty order}"><c:choose><c:when test="${not empty order.number}"><c:out value="${order.number}"/></c:when><c:otherwise>#${order.id}</c:otherwise></c:choose></c:if></h1><p>Giá theo ngày gửi tại Việt Nam · tiền theo đơn vị cơ sở · chưa thuế / vận chuyển.</p></div><c:url var="back" value="${orderPath}"><c:param name="q" value="${param.q}"/><c:param name="status" value="${param.status}"/><c:param name="page" value="${param.page}"/><c:param name="pageSize" value="${param.pageSize}"/><c:param name="dealer" value="${param.dealer}"/><c:forEach var="key" items="${['staff','territory','from','to']}"><c:param name="${key}" value="${param[key]}"/></c:forEach></c:url><a class="button button-secondary" href="<c:out value='${back}'/>">Danh sách đơn</a></div>
<c:if test="${param.notice=='saved' and empty errors}"><p class="alert alert-success" role="status">Đã lưu nháp. Kiểm tra báo giá trước khi gửi.</p></c:if><c:if test="${param.notice=='submitted' and empty errors}"><p class="alert alert-success" role="status">Đã gửi tiếp nhận. Đơn chỉ được xem, chưa xuất kho.</p></c:if>
<c:if test="${param.notice=='pending' and empty errors}"><p class="alert alert-success" role="status">Đã gửi đơn. Đơn chưa giữ hàng; đang chờ NVKD phụ trách xác nhận hoặc quản lý duyệt ngoại lệ.</p></c:if><c:if test="${param.notice=='approved' and empty errors}"><p class="alert alert-success" role="status">Đã chấp thuận giá và gửi tiếp nhận.</p></c:if><c:if test="${param.notice=='rejected' and empty errors}"><p class="alert alert-warning" role="status">Đã từ chối đơn. Đơn chỉ đọc; tạo đơn mới nếu cần tiếp tục.</p></c:if>
<c:if test="${not empty errors}"><div class="alert alert-error" role="alert"><c:forEach items="${errors}" var="e"><p><c:out value="${e.value}"/></p></c:forEach></div></c:if><c:if test="${order.transaction_locked}"><p class="alert" role="note">Đại lý hiện bị khóa. Đây là đơn đã tồn tại; không thể tạo đơn mới.</p></c:if>
<c:choose><c:when test="${editing}">
<form id="order-editor" method="post" action="${pageContext.request.contextPath}${orderPath}" data-context="${pageContext.request.contextPath}" data-options-path="${optionsPath}" class="order-form" data-can-manage-address="${not portalMode and access.allows('DEALER_ADDRESS_MANAGE')}"><ui:orderFilters/><noscript><p class="alert alert-warning" role="alert">Tạo đơn cần JavaScript. Bật JavaScript rồi tải lại trang; bạn vẫn có thể xem danh sách đơn.</p></noscript><fieldset class="order-js-fields" disabled data-order-controls><input type="hidden" name="_csrf" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="action" value="save"><input type="hidden" name="id" value="<c:out value='${form.id}'/>"><input type="hidden" name="version" value="<c:out value='${form.version}'/>"><input type="hidden" name="creationKey" value="<c:out value='${form.creationKey}'/>">

<section class="content-panel padded-panel"><h2>Thông tin giao hàng</h2><div class="dealer-profile-form order-header-fields"><label class="field">Đại lý<c:choose><c:when test="${empty order and not portalMode}"><select name="dealer" data-lookup="dealers" required><option value="">Gõ mã hoặc tên đại lý</option><c:if test="${not empty selectedDealer}"><option value="${selectedDealer.id}" selected><c:out value="${selectedDealer.code}"/> — <c:out value="${selectedDealer.name}"/></option></c:if></select></c:when><c:otherwise><input type="hidden" name="dealer" value="${form.dealer}"><input readonly value="<c:out value='${selectedDealer.code}'/> — <c:out value='${selectedDealer.name}'/>"></c:otherwise></c:choose><span class="field-error"><c:out value="${errors.dealer}"/></span></label>
<label class="field">Điểm giao <select name="address" required><option value="">Chọn điểm giao thuộc đại lý</option><c:forEach items="${addresses}" var="a"><option value="${a.id}" ${form.address.toString()==a.id.toString()?'selected':''}><c:out value="${a.address}"/> — <c:out value="${a.recipient}"/></option></c:forEach></select><span class="field-error"><c:out value="${errors.address}"/></span></label><div class="order-address-state" data-address-state role="status" ${empty selectedDealer or not empty addresses?'hidden':''}><p>Đại lý chưa có điểm giao đang sử dụng. Chưa thể lưu hoặc gửi đơn.</p><c:choose><c:when test="${not portalMode and access.allows('DEALER_ADDRESS_MANAGE')}"><a class="button button-secondary" data-add-address href="${pageContext.request.contextPath}/dealers/addresses?dealer=${selectedDealer.id}&amp;new=1#editor" target="_blank" rel="noopener">Thêm điểm giao hàng</a></c:when><c:otherwise><p>Liên hệ nhân viên phụ trách để thêm điểm giao.</p></c:otherwise></c:choose></div><button class="button button-secondary" type="button" data-retry-options hidden>Thử tải lại tùy chọn</button><label class="field">Ngày giao mong muốn <input name="delivery" min="${deliveryToday}" type="date" required value="<c:out value='${form.delivery}'/>"><span class="field-error"><c:out value="${errors.delivery}"/></span></label></div></section>
<section class="content-panel padded-panel"><h2>Dòng hàng</h2><p class="helper-text">Gõ ít nhất 2 ký tự để tìm SKU ngoài trang đầu. Các dòng cùng SKU cộng sản lượng cơ sở để xét bậc.</p><div data-order-lines>
<c:forEach items="${lineForms}" var="line" varStatus="idx"><div class="order-line" data-order-line><p class="order-line-title">Dòng <span data-line-number>${idx.index+1}</span></p><label class="field">SKU / tên sản phẩm <select name="product" required data-lookup="products" data-lookup-endpoint="${portalMode?'/api/portal/products':'/api/lookups/products'}"><option value="">Chọn sản phẩm</option><c:if test="${not empty line.product_id}"><option value="<c:out value='${line.product_id}'/>" selected><c:out value="${line.sku}"/> — <c:out value="${line.name}" default="SKU đã chọn"/></option></c:if><c:forEach items="${products}" var="p"><option value="${p.id}"><c:out value="${p.sku}"/> — <c:out value="${p.name}"/></option></c:forEach></select></label><label class="field">Đơn vị <select name="unit" required><option value="">Chọn SKU và kho phục vụ</option><c:if test="${not empty line.unit_id}"><option value="<c:out value='${line.unit_id}'/>" selected><c:out value="${line.unit_name}" default="Đơn vị đã chọn"/></option></c:if></select></label><label class="field">Số lượng <input name="quantity" type="number" required min="0.000001" step="0.000001" value="<c:out value='${display:plain(line.quantity)}'/>"></label><button type="button" class="button button-secondary" data-remove-line>Xóa dòng</button><p class="field-error order-line-error" data-line-error><c:out value="${errors['line'.concat(idx.index)]}"/><c:out value="${errors['quantity'.concat(idx.index)]}"/></p><p class="helper-text order-line-money" data-line-money></p></div></c:forEach></div><button type="button" class="button button-secondary" data-add-line>Thêm dòng hàng</button></section>
<div class="form-actions"><button class="button button-primary" data-save-order disabled>Lưu nháp và tính lại</button><button class="button button-secondary" type="button" data-refresh-quote>Tính lại báo giá</button><span class="helper-text" data-save-reminder>Phải lưu các thay đổi trước khi gửi.</span></div></fieldset></form>
<template id="order-line-template"><div class="order-line" data-order-line><p class="order-line-title">Dòng <span data-line-number></span></p><label class="field">SKU / tên sản phẩm <select name="product" required data-lookup="products" data-lookup-endpoint="${portalMode?'/api/portal/products':'/api/lookups/products'}"><option value="">Chọn sản phẩm</option></select></label><label class="field">Đơn vị <select name="unit" required><option value="">Chọn SKU và kho phục vụ</option></select></label><label class="field">Số lượng <input name="quantity" type="number" required min="0.000001" step="0.000001" value="1"></label><button type="button" class="button button-secondary" data-remove-line>Xóa dòng</button><p class="field-error order-line-error" data-line-error></p><p class="helper-text order-line-money" data-line-money></p></div></template>
<section class="content-panel padded-panel order-totals" aria-live="polite"><h2>Báo giá</h2><p data-credit-state>Còn nợ: <c:out value="${quote.controls.credit.formatted.outstanding}"/> đ · Dư có: <c:out value="${quote.controls.credit.formatted.credit}"/> đ · Cam kết: <c:out value="${quote.controls.credit.formatted.commitment}"/> đ · Hạn mức: <c:out value="${quote.controls.credit.formatted.limit}"/> đ · Hạn mức còn lại trước đơn: <c:out value="${quote.controls.credit.formatted.remaining}"/> đ</p><p>${portalMode?'Đơn cổng chưa giữ hàng khi gửi. NVKD phụ trách xác nhận đơn thường; quản lý duyệt thay nếu có ngoại lệ.':'Đơn thường được kiểm lại giá, nợ và tồn rồi giữ hàng khi gửi thành công. Ngoại lệ chờ quản lý duyệt.'}</p><p data-quote-status>Giá sẽ được kiểm tra lại ngay khi gửi.</p><p data-quote-warning><c:out value="${quote.warning}"/></p><dl><dt>Tiền hàng</dt><dd data-total="gross"><c:out value="${quote.formatted.gross}"/> đ</dd><dt>Chiết khấu</dt><dd data-total="discount"><c:out value="${quote.formatted.discount}"/> đ</dd><dt>Tổng phải thu</dt><dd data-total="net"><c:out value="${quote.formatted.net}"/> đ</dd></dl>
<c:if test="${quote.needsApproval}"><p class="alert alert-warning">Đơn cần duyệt giá hoặc hạn mức trước khi tiếp nhận.</p></c:if><c:if test="${not empty quote.errors}"><div class="alert alert-error" role="alert"><c:forEach items="${quote.errors}" var="e"><p><c:out value="${e.value}"/></p></c:forEach></div></c:if>
<c:if test="${not empty order and order.can_edit}"><ui:confirm title="${quote.needsApproval?'Gửi chờ duyệt':portalMode?'Gửi chờ NVKD xác nhận':'Gửi tiếp nhận'}"><p class="confirm-fallback-note">Gửi đơn để tiếp nhận? Đơn gửi thành công sẽ chỉ được xem.</p><form id="order-submit" method="post" action="${pageContext.request.contextPath}${orderPath}" data-confirm="Gửi đơn để tiếp nhận? Đơn gửi thành công sẽ chỉ được xem."><ui:orderFilters/><input type="hidden" name="_csrf" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="action" value="submit"><input type="hidden" name="id" value="${order.id}"><input type="hidden" name="version" value="${form.version}"><input type="hidden" name="quoteToken" value="<c:out value='${quote.token}'/>"><input type="hidden" name="submitKey" value="${submitKey}"><c:if test="${quote.confirmation}"><p class="alert" role="alert">Giá hoặc điều kiện đã thay đổi / báo giá đã hết hạn. Kiểm tra số tiền mới trước khi xác nhận.</p><label class="checkbox-field"><input name="confirmed" value="true" type="checkbox" required>Tôi đồng ý với báo giá và điều kiện vừa hiển thị.</label></c:if><button class="button button-primary" disabled data-submit-eligible="${not empty quote.token and empty quote.errors and not unsaved}">${quote.needsApproval?'Gửi chờ duyệt':portalMode?'Gửi chờ NVKD xác nhận':'Gửi tiếp nhận'}</button></form></ui:confirm></c:if></section>
</c:when><c:otherwise><section class="content-panel padded-panel"><h2>Thông tin đơn</h2><p>Đại lý: <c:out value="${order.status!='DRAFT'?order.dealer_name_snapshot:order.dealer_name}"/></p><p>Ngày giao mong muốn: ${order.desired_delivery}</p><c:if test="${order.status!='DRAFT'}"><p>Điểm giao: <c:out value="${order.address_snapshot}"/> — <c:out value="${order.recipient_snapshot}"/> · <c:out value="${order.phone_snapshot}"/></p><p>Ghi chú: <c:out value="${order.directions_snapshot}"/></p><p>Nhóm giá: <c:out value="${order.group_name_snapshot}"/> · Kho: <c:out value="${order.warehouse_name_snapshot}"/> · Ngày giá: ${order.pricing_date}</p><p>Tiền hàng: <c:out value="${order.formatted.gross}"/> đ · Giảm: <c:out value="${order.formatted.discount}"/> đ</p><p>Tổng phải thu: <strong><c:out value="${order.formatted.net}"/> đ</strong></p></c:if></section><div class="order-read-lines"><c:forEach items="${order.lines}" var="l"><section class="content-panel padded-panel"><h2><c:out value="${order.status!='DRAFT'?l.sku_snapshot:l.sku}"/> — <c:out value="${order.status!='DRAFT'?l.name_snapshot:l.name}"/></h2><p><fmt:formatNumber value="${l.quantity}" pattern="#,##0.######"/> <c:out value="${order.status!='DRAFT'?l.unit_name_snapshot:l.unit_name}"/></p><c:if test="${order.status!='DRAFT'}"><p>Hệ số ${display:quantity(l.factor_snapshot)} · giá cơ sở <c:out value="${l.formatted.selling}"/> đ</p><p>Phải thu dòng: <c:out value="${l.formatted.net}"/> đ · <c:out value="${l.policy_name_snapshot}" default="Không chiết khấu"/></p></c:if></section></c:forEach></div><c:if test="${order.can_takeover}"><form method="post" class="content-panel padded-panel"><ui:orderFilters/><input type="hidden" name="_csrf" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="action" value="takeover"><input type="hidden" name="id" value="${order.id}"><input type="hidden" name="version" value="${order.version}"><label class="field">Lý do tiếp quản nháp <input name="reason" required maxlength="1000"></label><ui:button variant="primary">Tiếp quản có audit</ui:button></form></c:if></c:otherwise></c:choose>
<c:if test="${not editing and order.status=='DRAFT'}"><section class="content-panel padded-panel"><h2>Thông tin nháp chỉ đọc</h2><p>Điểm giao: <c:out value="${order.delivery_address.address}"/> — <c:out value="${order.delivery_address.recipient}"/> · <c:out value="${order.delivery_address.phone}"/></p><p>Báo giá tham khảo ngày <c:out value="${readQuote.date}"/>: <c:out value="${readQuote.formatted.net}"/> đ. Tính lại trước khi chủ nháp gửi.</p><c:forEach items="${readQuote.errors}" var="e"><p class="field-error"><c:out value="${e.value}"/></p></c:forEach></section></c:if>

<c:if test="${not empty order.approval}"><section class="content-panel padded-panel"><h2>${order.approval.status=='RETURNED'?'Đã trả lại sửa':order.approval.status=='REJECTED'?'Đã từ chối':order.approval.status=='CANCELLED'?'Đã hủy yêu cầu':order.approval.status=='APPROVED'?'Đã chấp thuận':order.pending_reason=='STAFF_CONFIRMATION'?'Chờ NVKD phụ trách xác nhận':'Chờ duyệt ngoại lệ'}</h2><p>Yêu cầu: <c:out value="${order.approval.request_reason}"/></p><p>Người gửi: <c:out value="${order.approval.requested_name}"/> · ${display:time(order.approval.requested_at)}</p><c:if test="${not empty order.approval.decided_name}"><p>Người quyết định: <c:out value="${order.approval.decided_name}"/> · ${display:time(order.approval.decided_at)}</p></c:if><p>Báo giá lúc gửi: tiền hàng <c:out value="${order.approval.requested_gross}"/> đ · chiết khấu <c:out value="${order.approval.requested_discount}"/> đ · phải thu <c:out value="${order.approval.requested_net}"/> đ.</p><c:if test="${not empty order.approval.decision_reason}"><p>Lý do quyết định: <c:out value="${order.approval.decision_reason}"/></p></c:if><c:if test="${order.status=='REJECTED'}"><p>Đơn bị từ chối chỉ được xem. Tạo đơn mới nếu cần tiếp tục.</p></c:if></section></c:if>
<c:if test="${order.can_review}"><section class="content-panel padded-panel"><h2>Quyết định duyệt ngoại lệ</h2><p class="alert ${approvalQuote.creditReview.exceeds?'alert-warning':''}">Công nợ ròng: <c:out value="${approvalQuote.creditReview.netDebt}"/> đ · Cam kết: <c:out value="${approvalQuote.controls.credit.formatted.commitment}"/> đ · Đơn này: <c:out value="${approvalQuote.formatted.net}"/> đ · Hạn mức: <c:out value="${approvalQuote.controls.credit.formatted.limit}"/> đ · Vượt hạn mức: <strong><c:out value="${approvalQuote.creditReview.excess}"/> đ</strong>.</p><p>${approvalQuote.priceException?'Có dòng dưới giá sàn.':'Các dòng đạt điều kiện giá sàn.'} ${approvalQuote.creditReview.exceeds?'Đơn vẫn cần duyệt do vượt hạn mức.':'Không vượt hạn mức hiện tại.'}</p><p>Nhóm giá hiện tại: <strong><c:out value="${selectedDealer.group_name}"/></strong> · Kho hiện tại: <c:out value="${selectedDealer.warehouse_name}"/>.</p><p>Báo giá hiện tại ngày <c:out value="${approvalQuote.date}"/>: tiền hàng <c:out value="${approvalQuote.formatted.gross}"/> đ · chiết khấu <c:out value="${approvalQuote.formatted.discount}"/> đ · phải thu <strong><c:out value="${approvalQuote.formatted.net}"/> đ</strong>.</p><p class="helper-text">Tiền hiển thị đã làm tròn đến đồng; điều kiện giá sàn được kiểm tra theo số liệu chính xác.</p><div class="table-wrap"><table><thead><tr><th>SKU</th><th>Giá bán / đơn vị cơ sở</th><th>Giá sàn / đơn vị cơ sở</th><th>Chính sách hiện tại</th><th>Phải thu dòng</th><th>Điều kiện</th></tr></thead><tbody><c:forEach items="${approvalQuote.lines}" var="line"><tr><td><c:out value="${line.sku}"/></td><td><c:out value="${line.formatted.selling}"/> đ</td><td><c:out value="${line.floorFormatted}"/> đ</td><td><c:out value="${empty line.policy ? 'Không chiết khấu' : line.policy}"/></td><td><c:out value="${line.formatted.net}"/> đ</td><td>${line.needsApproval?'Cần duyệt giá':'Đạt điều kiện giá'}</td></tr></c:forEach></tbody></table></div><c:forEach items="${approvalQuote.errors}" var="problem"><p class="field-error"><c:out value="${problem.value}"/></p></c:forEach>
<ui:confirm title="Chấp thuận giá"><p class="confirm-fallback-note">Xác nhận quyết định duyệt giá?</p><form id="order-approval" method="post" action="${pageContext.request.contextPath}/orders" data-confirm="Xác nhận quyết định duyệt giá?"><ui:orderFilters/><input type="hidden" name="_csrf" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="id" value="${order.id}"><input type="hidden" name="version" value="${order.version}"><input type="hidden" name="quoteToken" value="<c:out value='${approvalQuote.token}'/>"><input type="hidden" name="decisionKey" value="${decisionKey}"><c:if test="${approvalQuote.confirmation}"><p class="alert alert-warning">Giá hoặc điều kiện đã thay đổi. Kiểm tra báo giá mới trước khi quyết định.</p><label class="checkbox-field"><input name="confirmed" value="true" type="checkbox" required>Tôi xác nhận đã xem báo giá và điều kiện mới.</label></c:if><label class="field">Lý do quyết định <textarea name="reason" maxlength="1000" required></textarea></label><div class="form-actions"><button name="action" value="approve" class="button button-primary" ${empty approvalQuote.token or not empty approvalQuote.errors?'disabled':''}>Chấp thuận giá</button><button name="action" value="reject" class="button button-secondary">Từ chối đơn</button></div></form></ui:confirm></section></c:if>

<c:if test="${order.can_confirm_portal}"><section class="content-panel padded-panel"><h2>Xác nhận đơn cổng đại lý</h2><p>Đơn chưa giữ tồn. Xác nhận thành công mới giữ hàng trong 24 giờ; điều kiện ngoại lệ chuyển quản lý duyệt.</p><p>Báo giá hiện tại: <strong><c:out value="${confirmationQuote.formatted.net}"/> đ</strong>. Công nợ: <c:out value="${confirmationQuote.controls.credit.formatted.outstanding}"/>; cam kết: <c:out value="${confirmationQuote.controls.credit.formatted.commitment}"/>; hạn mức: <c:out value="${confirmationQuote.controls.credit.formatted.limit}"/>.</p><c:forEach items="${confirmationQuote.errors}" var="problem"><p class="field-error"><c:out value="${problem.value}"/></p></c:forEach><form method="post" action="${pageContext.request.contextPath}/orders"><ui:orderFilters/><input type="hidden" name="_csrf" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="action" value="confirmPortal"><input type="hidden" name="id" value="${order.id}"><input type="hidden" name="version" value="${order.version}"><input type="hidden" name="quoteToken" value="<c:out value='${confirmationQuote.token}'/>"><input type="hidden" name="decisionKey" value="${decisionKey}"><c:if test="${confirmationQuote.confirmation}"><p class="alert alert-warning">Giá hoặc điều kiện đã thay đổi. Kiểm tra lại trước khi xác nhận.</p><label class="checkbox-field"><input name="confirmed" value="true" type="checkbox" required>Tôi đồng ý với điều kiện vừa hiển thị.</label></c:if><button class="button button-primary" ${empty confirmationQuote.token or not empty confirmationQuote.errors?'disabled':''}>${confirmationQuote.needsApproval?'Chuyển quản lý duyệt':'Xác nhận và giữ hàng'}</button></form></section></c:if>
<c:if test="${order.can_review or order.can_confirm_portal}"><section class="content-panel padded-panel"><h2>Trả lại sửa</h2><form method="post" action="${pageContext.request.contextPath}/orders"><ui:orderFilters/><input type="hidden" name="_csrf" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="action" value="${order.can_confirm_portal?'returnPortal':'returnEdit'}"><input type="hidden" name="id" value="${order.id}"><input type="hidden" name="version" value="${order.version}"><input type="hidden" name="decisionKey" value="${decisionKey}"><label class="field">Ý kiến yêu cầu sửa <textarea name="reason" required maxlength="1000"></textarea></label><ui:button variant="secondary">Trả về người tạo sửa nháp</ui:button></form></section></c:if>
<c:if test="${not empty order.history}"><section class="content-panel padded-panel"><h2>Lịch sử tiếp nhận và quyết định</h2><c:forEach items="${order.history}" var="decision"><p><c:out value="${display:time(decision.occurred_at)}"/> · <c:out value="${decision.label}"/> · <c:out value="${decision.actor_name}"/> · <c:out value="${decision.reason}"/></p></c:forEach></section></c:if>
<c:if test="${order.can_cancel}"><section class="content-panel padded-panel"><h2>Hủy đơn trước xuất</h2><ui:confirm title="Hủy đơn"><p>Xác nhận hủy đơn và nhả phần giữ hàng? Không thể khôi phục đơn bằng thao tác này.</p><form method="post" data-confirm="Hủy đơn này và nhả giữ hàng? Thao tác không thể hoàn tác." action="${pageContext.request.contextPath}/orders"><ui:orderFilters/><input type="hidden" name="_csrf" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="action" value="cancel"><input type="hidden" name="id" value="${order.id}"><input type="hidden" name="version" value="${order.version}"><input type="hidden" name="decisionKey" value="${decisionKey}"><label class="field">Lý do hủy <textarea name="reason" required maxlength="1000"></textarea></label><ui:button variant="secondary">Hủy đơn và nhả giữ hàng</ui:button></form></ui:confirm></section></c:if>
<c:if test="${order.status=='CANCELLED'}"><section class="content-panel padded-panel"><h2>Đơn đã hủy</h2><p><c:out value="${order.cancel_reason}"/></p></section></c:if>
<c:if test="${order.status=='SUBMITTED'}"><section class="content-panel padded-panel"><h2>Giữ chỗ hàng</h2><p><strong><c:out value="${order.fulfillment_state=='COMPLETE'?'Đã hoàn tất giao hàng':order.holds.status}"/></strong></p><p>Còn giữ: ${order.holds.active} · Chưa được giữ: ${order.holds.missing} đơn vị cơ sở.</p><c:if test="${not empty order.holds.nextExpiry}"><p>Hết hạn giữ chỗ tiếp theo: <c:out value="${order.holds.nextExpiry}"/> (giờ Việt Nam).</p></c:if><c:if test="${not order.holds.hasActive and not empty order.holds.lastExpiry}"><p>Hạn giữ chỗ trước: <c:out value="${order.holds.lastExpiry}"/>.</p></c:if></section></c:if><c:if test="${order.can_renew_holds or order.can_approve_renewal}"><section class="content-panel padded-panel"><h2>Giữ lại phần đơn chưa giao</h2><p>Dùng khi giữ chỗ hết hạn hoặc hàng giao thất bại đã quay về. Hệ thống kiểm lại tồn, nợ quá hạn và hạn mức; giữ đủ phần còn thiếu trong 24 giờ theo giá đã xác nhận của đơn.</p><form method="post" action="${pageContext.request.contextPath}/orders"><ui:orderFilters/><input type="hidden" name="_csrf" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="id" value="${order.id}"><input type="hidden" name="version" value="${order.version}"><input type="hidden" name="decisionKey" value="${decisionKey}"><c:if test="${order.can_renew_holds}"><button name="action" value="${order.source=='PORTAL'?'renewPortal':'renew'}" class="button button-primary">Kiểm tra và giữ phần còn thiếu</button></c:if><c:if test="${order.can_approve_renewal}"><label class="field">Lý do duyệt ngoại lệ khi giữ lại <textarea name="reason" maxlength="1000"></textarea></label><button name="action" value="approveRenewal" class="button button-secondary">Duyệt ngoại lệ và giữ phần còn thiếu</button></c:if></form></section></c:if>
<c:if test="${not empty order.invoices}"><section class="content-panel padded-panel"><h2>Hóa đơn từ các lần giao</h2><c:forEach items="${order.invoices}" var="invoice"><p><a href="${pageContext.request.contextPath}/accounting/invoices?id=${invoice.id}"><c:out value="${invoice.number}"/></a> · <c:out value="${invoice.invoice_date}"/></p></c:forEach></section></c:if>
<c:if test="${not empty order and order.status != 'DRAFT'}"><p class="no-print"><a class="button button-secondary" href="${pageContext.request.contextPath}${orderPath}?action=print&amp;id=${order.id}">In đơn hàng</a></p></c:if></main>
</jsp:body>
</layout:page>
