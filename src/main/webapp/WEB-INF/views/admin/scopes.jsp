<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="vi"><head><meta name="viewport" content="width=device-width,initial-scale=1"><title>Kho và địa bàn</title><%@ include file="../fragments/assets.jspf" %></head><body class="app-page"><%@ include file="../fragments/sidebar.jspf" %>
<%@ include file="../fragments/topbar.jspf" %><main class="page-body app-content"><div class="page-heading"><div><h1>Kho và địa bàn</h1><p>Quản lý phạm vi phụ trách để phân công cho người dùng.</p></div><a class="button button-primary" href="?new=1#scope-editor" data-editor="scope-editor">＋ Thêm phạm vi</a></div>
<c:if test="${param.notice == 'saved'}"><div class="alert alert-success" role="status">Đã tạo phạm vi.</div></c:if>
<c:if test="${not empty formError}"><div class="alert alert-error" role="alert"><c:out value="${formError}"/></div></c:if>
<details class="content-panel disclosure editor" id="scope-editor" ${not empty formError or param['new'] == '1' ? 'open' : ''}><summary>Thêm kho / địa bàn</summary><form class="account-form form-grid" method="post"><input type="hidden" name="_csrf" value="<c:out value='${csrfToken}'/>"><label class="field">Loại <select name="kind"><option value="warehouse">Kho</option><option value="territory" ${form.kind == 'territory' ? 'selected' : ''}>Địa bàn</option></select></label><label class="field">Mã <input name="code" required maxlength="50" value="<c:out value='${form.code}'/>"></label><label class="field">Tên <input name="name" required maxlength="150" value="<c:out value='${form.name}'/>"></label><div class="form-actions"><button class="button button-primary">Lưu phạm vi</button><a class="button button-secondary" href="${pageContext.request.contextPath}/admin/scopes">Hủy</a></div></form></details><div class="form-grid"><section class="content-panel"><div class="panel-heading"><h2>Kho</h2></div><div class="table-wrap"><table class="data-table"><thead><tr><th>Mã</th><th>Tên kho</th></tr></thead><tbody><c:forEach var="w" items="${warehouses}"><tr><td><c:out value="${w.code}"/></td><td><c:out value="${w.name}"/></td></tr></c:forEach><c:if test="${empty warehouses}"><tr><td colspan="2" class="empty-state">Chưa có kho.</td></tr></c:if></tbody></table></div></section><section class="content-panel"><div class="panel-heading"><h2>Địa bàn</h2></div><div class="table-wrap"><table class="data-table"><thead><tr><th>Mã</th><th>Tên địa bàn</th></tr></thead><tbody><c:forEach var="w" items="${territories}"><tr><td><c:out value="${w.code}"/></td><td><c:out value="${w.name}"/></td></tr></c:forEach><c:if test="${empty territories}"><tr><td colspan="2" class="empty-state">Chưa có địa bàn.</td></tr></c:if></tbody></table></div></section></div><a href="${pageContext.request.contextPath}/admin/users">Về người dùng</a></main></body></html>
