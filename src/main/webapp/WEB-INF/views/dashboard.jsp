<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Tổng quan công việc</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/app.css"></head><body class="app-page"><%@ include file="fragments/sidebar.jspf" %><div class="app-content"><header class="app-topbar"><h1><c:out value="${heading}"/></h1><form method="post" action="${pageContext.request.contextPath}/logout"><input type="hidden" name="_csrf" value="<c:out value='${csrfToken}'/>"><button class="button button-secondary">Đăng xuất</button></form></header><main class="page-body"><p>Xin chào <c:out value="${currentUser.fullName()}"/>. Chọn phần việc bên dưới để bắt đầu.</p><section class="summary-grid"><c:forEach var="area" items="${workAreas}"><article class="content-panel"><h2><c:out value="${area.label()}"/></h2><p><c:out value="${area.description()}"/></p><a class="button button-primary" href="${pageContext.request.contextPath}${area.path()}">Mở chức năng</a></article></c:forEach></section><c:if test="${empty workAreas}"><p>Tài khoản chưa được cấp quyền nghiệp vụ. Vui lòng liên hệ quản trị hệ thống.</p></c:if></main></div></body></html>
