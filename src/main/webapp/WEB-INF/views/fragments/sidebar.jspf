<aside class="sidebar">
    <a class="sidebar-brand" href="${pageContext.request.contextPath}/dashboard"><span class="wordmark-symbol" aria-hidden="true">BH</span><span>Quản lý bán hàng</span></a>
    <nav class="sidebar-nav" aria-label="Điều hướng chính">
        <a class="nav-item" href="${pageContext.request.contextPath}/dashboard">Tổng quan</a>
        <c:if test="${access.allows('USER_MANAGE')}"><a class="nav-item" href="${pageContext.request.contextPath}/admin/users">Người dùng</a><a class="nav-item" href="${pageContext.request.contextPath}/admin/scopes">Kho và địa bàn</a><a class="nav-item" href="${pageContext.request.contextPath}/admin/users/import">Nhập người dùng từ Excel</a></c:if>
        <c:if test="${access.allows('ROLE_MANAGE')}"><a class="nav-item" href="${pageContext.request.contextPath}/admin/roles">Phân quyền</a></c:if>
        <c:if test="${access.allows('AUDIT_READ')}"><a class="nav-item" href="${pageContext.request.contextPath}/admin/audit">Nhật ký thao tác</a></c:if>
        <c:if test="${access.allows('CATALOG_READ')}"><a class="nav-item" href="${pageContext.request.contextPath}/catalog/products">Sản phẩm</a><a class="nav-item" href="${pageContext.request.contextPath}/catalog/categories">Nhóm hàng</a><a class="nav-item" href="${pageContext.request.contextPath}/catalog/units">Đơn vị quy đổi</a><a class="nav-item" href="${pageContext.request.contextPath}/catalog/suppliers">Nhà cung cấp</a></c:if>
        <c:if test="${access.allows('PRODUCT_MANAGE')}"><a class="nav-item" href="${pageContext.request.contextPath}/catalog/products/import">Nhập sản phẩm từ Excel</a></c:if>
        <c:if test="${access.allows('PRICE_READ')}"><a class="nav-item" href="${pageContext.request.contextPath}/pricing/lists">Bảng giá</a></c:if>
        <a class="nav-item" href="${pageContext.request.contextPath}/account/profile">Hồ sơ cá nhân</a>
        <a class="nav-item" href="${pageContext.request.contextPath}/account/change-password">Đổi mật khẩu</a>
    </nav>
    <div class="sidebar-user"><span class="sidebar-user-name"><strong><c:out value="${currentUser.fullName()}"/></strong>
        <c:forEach var="role" items="${access.roleNames()}"><small><c:out value="${role.name}"/></small></c:forEach>
        <c:forEach var="w" items="${access.warehouses()}"><small>Kho: <c:out value="${w.name}"/></small></c:forEach>
        <c:forEach var="t" items="${access.territories()}"><small>Địa bàn: <c:out value="${t.name}"/></small></c:forEach>
    </span></div>
</aside>
