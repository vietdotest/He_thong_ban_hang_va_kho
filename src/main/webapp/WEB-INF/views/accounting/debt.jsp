<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %><fmt:setLocale value="vi_VN"/>
<layout:page title="Công nợ hiện tại" view="accounting/debt" bodyClass="app-page" css="mvp" bare="false">
<jsp:body>
<main class="page-body app-content catalog-page">
<div class="page-heading"><div><h1>Công nợ hiện tại</h1><p>Hóa đơn trừ thu hợp lệ và giảm trừ. Dư có được giữ riêng từng đại lý; hàng chờ quay về vẫn thuộc cam kết.</p></div></div><form method="get" class="content-panel padded-panel"><label class="field">Tìm mã / tên đại lý <input name="q" maxlength="150" value="<c:out value='${param.q}'/>"></label><c:if test="${not empty param.dealer}"><input type="hidden" name="dealer" value="<c:out value='${param.dealer}'/>"></c:if><ui:button variant="secondary">Tìm công nợ</ui:button><button class="button button-secondary" name="action" value="export">Xuất Excel</button><a class="button button-secondary" href="${pageContext.request.contextPath}/accounting/debt">Bỏ lọc</a></form>
<section class="content-panel padded-panel"><h2>Tổng trong phạm vi đang xem</h2><p>Hóa đơn: <fmt:formatNumber value="${totals.invoiced}" pattern="#,##0.####"/> đ · Thu hợp lệ: <fmt:formatNumber value="${totals.collected}" pattern="#,##0.####"/> đ · Giảm trừ: <fmt:formatNumber value="${totals.credited}" pattern="#,##0.####"/> đ</p><p>Còn phải thu: <strong><fmt:formatNumber value="${totals.outstanding}" pattern="#,##0.####"/> đ</strong> · Dư có: <fmt:formatNumber value="${totals.credit}" pattern="#,##0.####"/> đ · Quá hạn: <fmt:formatNumber value="${totals.overdue_amount}" pattern="#,##0.####"/> đ · Cam kết: <fmt:formatNumber value="${totals.commitment}" pattern="#,##0.####"/> đ</p></section>
<section class="content-panel padded-panel"><h2>Tuổi nợ theo ngày đến hạn</h2><p>Tại ngày ${agingDate}. Dư có và cam kết được giữ riêng, không đưa vào tuổi nợ.</p><dl><c:forEach items="${agingLabels}" var="bucket"><dt><c:out value="${bucket.value}"/></dt><dd><c:out value="${display:money(totals[bucket.key])}"/> đ</dd></c:forEach></dl></section><section class="content-panel padded-panel"><h2>Đại lý trong phạm vi</h2><div class="table-wrap"><table><thead><tr><th>Đại lý</th><th>Hóa đơn</th><th>Đã thu</th><th>Giảm trừ</th><th>Còn nợ</th><th>Dư có</th><th>Cam kết</th><th>Quá hạn</th><c:forEach items="${agingLabels}" var="bucket"><th><c:out value="${bucket.value}"/></th></c:forEach></tr></thead><tbody><c:forEach items="${rows}" var="row"><tr><td><a href="${pageContext.request.contextPath}/accounting/debt?dealer=${row.id}"><c:out value="${row.code}"/> — <c:out value="${row.name}"/></a></td><td><fmt:formatNumber value="${row.invoiced}" pattern="#,##0.####"/></td><td><fmt:formatNumber value="${row.collected}" pattern="#,##0.####"/></td><td><fmt:formatNumber value="${row.credited}" pattern="#,##0.####"/></td><td><fmt:formatNumber value="${row.outstanding}" pattern="#,##0.####"/></td><td><fmt:formatNumber value="${row.credit}" pattern="#,##0.####"/></td><td><fmt:formatNumber value="${row.commitment}" pattern="#,##0.####"/></td><td><fmt:formatNumber value="${row.overdue_amount}" pattern="#,##0.####"/></td><c:forEach items="${agingLabels}" var="bucket"><td><c:url var="bucketUrl" value="/accounting/debt"><c:param name="dealer" value="${row.id}"/><c:param name="q" value="${param.q}"/></c:url><a href="<c:out value='${bucketUrl}'/>#aging-${bucket.key}"><c:out value="${display:money(row[bucket.key])}"/></a></td></c:forEach></tr></c:forEach><c:if test="${empty rows}"><tr><td colspan="14">Không có đại lý phù hợp trong phạm vi.</td></tr></c:if></tbody></table></div></section>
<c:if test="${not empty dealer}"><section class="content-panel padded-panel"><h2>Chứng từ của <c:out value="${dealer.name}"/></h2><p>Hạn mức: <fmt:formatNumber value="${dealer.limit}" pattern="#,##0.####"/> đ · Phần hạn mức còn lại: <fmt:formatNumber value="${dealer.remaining}" pattern="#,##0.####"/> đ</p><h3>Hóa đơn và hạn thanh toán</h3><div class="table-wrap"><table><thead><tr><th>Hóa đơn</th><th>Ngày / hạn</th><th>Tiền</th><th>Giảm trừ</th><th>Phân bổ thu</th><th>Còn phải thu</th><th>Quá hạn</th></tr></thead><tbody><c:forEach items="${dealer.invoices}" var="invoice"><tr><td><c:choose><c:when test="${access.allows('INVOICE_READ')}"><a href="${pageContext.request.contextPath}/accounting/invoices?id=${invoice.id}"><c:out value="${invoice.number}"/></a></c:when><c:otherwise><c:out value="${invoice.number}"/></c:otherwise></c:choose></td><td>${invoice.invoice_date} / ${invoice.due_date}</td><td><fmt:formatNumber value="${invoice.net_amount}" pattern="#,##0.####"/></td><td><fmt:formatNumber value="${invoice.credited}" pattern="#,##0.####"/></td><td><fmt:formatNumber value="${invoice.allocated}" pattern="#,##0.####"/></td><td><fmt:formatNumber value="${invoice.outstanding}" pattern="#,##0.####"/></td><td>${invoice.overdue?'Có':'Không'}</td></tr></c:forEach></tbody></table></div>
<h3>Hóa đơn còn nợ theo nhóm tuổi</h3><c:forEach items="${agingLabels}" var="bucket"><details id="aging-${bucket.key}"><summary><c:out value="${bucket.value}"/> · <c:out value="${display:money(dealer[bucket.key])}"/> đ</summary><c:forEach items="${dealer.invoices}" var="invoice"><c:if test="${invoice.age_key==bucket.key and invoice.outstanding>0}"><p><c:out value="${invoice.number}"/> · Hạn ${invoice.due_date} · Còn phải thu <c:out value="${display:money(invoice.outstanding)}"/> đ</p></c:if></c:forEach></details></c:forEach><h3>Thu và đảo thu</h3><c:forEach items="${dealer.payments}" var="payment"><p><c:choose><c:when test="${access.allows('INVOICE_READ')}"><a href="${pageContext.request.contextPath}/accounting/payments?id=${payment.id}"><c:out value="${payment.number}"/></a></c:when><c:otherwise><c:out value="${payment.number}"/></c:otherwise></c:choose> · ${payment.paid_date} · <fmt:formatNumber value="${payment.amount}" pattern="#,##0.####"/> đ · ${empty payment.reversal_id?'Hợp lệ':'Đã đảo'} <c:out value="${payment.reversal_number}"/></p></c:forEach>
<h3>Giảm trừ</h3><c:forEach items="${dealer.credits}" var="credit"><p><c:choose><c:when test="${access.allows('RETURN_READ')}"><a href="${pageContext.request.contextPath}/accounting/returns?id=${credit.return_id}"><c:out value="${credit.number}"/></a></c:when><c:otherwise><c:out value="${credit.number}"/></c:otherwise></c:choose> · ${credit.credit_date} · <fmt:formatNumber value="${credit.amount}" pattern="#,##0.####"/> đ</p></c:forEach></section></c:if>
</main>
</jsp:body>
</layout:page>
