<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>404 — Trang không tồn tại</title><%@ include file="../fragments/assets.jspf" %></head><body class="app-page"><c:set var="currentUser" value="${sessionScope['auth.currentUser']}"/><c:if test="${not empty currentUser}"><%@ include file="../fragments/sidebar.jspf" %>
<%@ include file="../fragments/topbar.jspf" %></c:if><main class="page-body ${not empty currentUser ? 'app-content' : 'guest-page'}"><section class="content-panel message-panel"><p class="breadcrumb">Thông báo 404</p><h1>Trang không tồn tại</h1><p>Đường dẫn không tồn tại hoặc dữ liệu đã được chuyển sang vị trí khác.</p><c:choose><c:when test="${not empty currentUser}"><a class="button button-primary" href="${pageContext.request.contextPath}/dashboard">Về phần việc của tôi</a></c:when><c:otherwise><a class="button button-primary" href="${pageContext.request.contextPath}/login">Đăng nhập</a></c:otherwise></c:choose></section></main></body></html>
