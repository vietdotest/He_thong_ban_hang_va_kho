<%@ page pageEncoding="UTF-8" %>
<aside class="sidebar" id="nvdo-menu" aria-label="Menu chức năng">
<div class="sidebar-heading"><a class="sidebar-brand" href="${pageContext.request.contextPath}/dashboard"><span class="wordmark-symbol" aria-hidden="true">BH</span><span>Quản lý bán hàng</span></a><button class="icon-button mobile-menu-close" type="button" data-menu-close aria-label="Đóng menu"><img class="icon" src="${pageContext.request.contextPath}/assets/icons/close.svg" alt=""></button></div>
<nav class="sidebar-nav" aria-label="Điều hướng chính">
<a class="nav-item" href="${pageContext.request.contextPath}/dashboard"><img class="icon" src="${pageContext.request.contextPath}/assets/icons/home.svg" alt="">Tổng quan</a>
<c:if test="${access.allows('USER_MANAGE') or access.allows('ROLE_MANAGE') or access.allows('AUDIT_READ')}"><p class="nav-group">Quản trị</p></c:if>
<c:if test="${access.allows('USER_MANAGE')}"><a class="nav-item" href="${pageContext.request.contextPath}/admin/users"><img class="icon" src="${pageContext.request.contextPath}/assets/icons/users.svg" alt="">Người dùng</a><a class="nav-item" href="${pageContext.request.contextPath}/admin/scopes"><img class="icon" src="${pageContext.request.contextPath}/assets/icons/pin.svg" alt="">Kho và địa bàn</a></c:if>
<c:if test="${access.allows('ROLE_MANAGE')}"><a class="nav-item" href="${pageContext.request.contextPath}/admin/roles"><img class="icon" src="${pageContext.request.contextPath}/assets/icons/shield.svg" alt="">Phân quyền</a></c:if>
<c:if test="${access.allows('AUDIT_READ')}"><a class="nav-item" href="${pageContext.request.contextPath}/admin/audit"><img class="icon" src="${pageContext.request.contextPath}/assets/icons/clock.svg" alt="">Nhật ký thao tác</a></c:if>
<c:if test="${access.allows('CATALOG_READ') or access.allows('PRICE_READ')}"><p class="nav-group">Danh mục và giá</p></c:if>
<c:if test="${access.allows('CATALOG_READ')}"><a class="nav-item" href="${pageContext.request.contextPath}/catalog/products"><img class="icon" src="${pageContext.request.contextPath}/assets/icons/box.svg" alt="">Sản phẩm</a><a class="nav-item" href="${pageContext.request.contextPath}/catalog/categories"><img class="icon" src="${pageContext.request.contextPath}/assets/icons/folder.svg" alt="">Nhóm hàng</a><a class="nav-item" href="${pageContext.request.contextPath}/catalog/units"><img class="icon" src="${pageContext.request.contextPath}/assets/icons/unit.svg" alt="">Đơn vị quy đổi</a><a class="nav-item" href="${pageContext.request.contextPath}/catalog/suppliers"><img class="icon" src="${pageContext.request.contextPath}/assets/icons/truck.svg" alt="">Nhà cung cấp</a></c:if>
<c:if test="${access.allows('PRICE_READ')}"><a class="nav-item" href="${pageContext.request.contextPath}/pricing/lists"><img class="icon" src="${pageContext.request.contextPath}/assets/icons/tag.svg" alt="">Bảng giá</a></c:if>
</nav>
<div class="sidebar-user"><div class="sidebar-identity"><c:choose><c:when test="${not empty access.avatarKey()}"><img class="sidebar-avatar" alt="Ảnh đại diện của bạn" src="${pageContext.request.contextPath}/account/avatar?v=<c:out value='${access.avatarKey()}'/>"></c:when><c:otherwise><span class="account-mark" aria-hidden="true">BH</span></c:otherwise></c:choose><div class="sidebar-user-name"><strong><c:out value="${currentUser.fullName()}"/></strong><c:forEach var="role" items="${access.roleNames()}"><small><c:out value="${role.name}"/></small></c:forEach></div></div>
<div class="sidebar-scope"><c:choose><c:when test="${empty access.warehouses() and empty access.territories()}">Chưa gán kho / địa bàn</c:when><c:otherwise><c:forEach var="w" items="${access.warehouses()}"><span>Kho: <c:out value="${w.name}"/></span></c:forEach><c:forEach var="t" items="${access.territories()}"><span>Địa bàn: <c:out value="${t.name}"/></span></c:forEach></c:otherwise></c:choose></div>
<a class="button button-plain" href="${pageContext.request.contextPath}/account/profile">Hồ sơ cá nhân</a><a class="account-password-link" href="${pageContext.request.contextPath}/account/change-password">Đổi mật khẩu</a></div>
<form class="mobile-sidebar-logout" method="post" action="${pageContext.request.contextPath}/logout"><input type="hidden" name="_csrf" value="<c:out value='${csrfToken}'/>"><button class="button button-plain"><img class="icon" src="${pageContext.request.contextPath}/assets/icons/logout.svg" alt="">Đăng xuất</button></form>
</aside>
