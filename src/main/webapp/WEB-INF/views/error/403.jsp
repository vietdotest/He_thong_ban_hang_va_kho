<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>403 — Không đủ quyền truy cập</title><%@ include file="../fragments/assets.jspf" %></head><body class="app-page"><c:set var="currentUser" value="${sessionScope['auth.currentUser']}"/><c:if test="${not empty currentUser}"><%@ include file="../fragments/sidebar.jspf" %>
<%@ include file="../fragments/topbar.jspf" %></c:if><main class="page-body app-content"><section class="content-panel"><p class="breadcrumb">Thông báo 403</p><h1>Không đủ quyền truy cập</h1><p>Bạn chưa được cấp quyền cho thao tác này. Hãy quay lại phần việc của mình hoặc liên hệ quản trị hệ thống.</p><c:choose><c:when test="${not empty currentUser}"><a class="button button-primary" href="${pageContext.request.contextPath}/dashboard">Về phần việc của tôi</a></c:when><c:otherwise><a class="button button-primary" href="${pageContext.request.contextPath}/login">Đăng nhập</a></c:otherwise></c:choose></section></main></body></html>
