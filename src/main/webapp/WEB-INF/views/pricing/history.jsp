<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %><fmt:setLocale value="vi_VN"/>
<!doctype html><html lang="vi"><head><meta name="viewport" content="width=device-width,initial-scale=1"><title>Lịch sử giá</title><%@ include file="../fragments/assets.jspf" %></head><body class="app-page"><%@ include file="../fragments/sidebar.jspf" %><%@ include file="../fragments/topbar.jspf" %><main class="page-body app-content catalog-page"><div class="page-heading"><div><h1>Lịch sử thay đổi giá</h1><p>Phân biệt ngày áp dụng giá và thời điểm người dùng sửa dữ liệu.</p></div><a class="button button-secondary" href="${pageContext.request.contextPath}/pricing/lists">Bảng giá</a></div><p class="alert" role="note">Lịch sử chỉ đọc, không sửa/xóa qua hệ thống. Ghi nhận bắt đầu khi tính năng được bật; dữ liệu quá khứ thiếu bằng chứng không được gán người sửa hoặc thời điểm giả định.</p><c:if test="${not empty errors}"><p class="alert alert-error" role="alert"><c:forEach items="${errors}" var="e"><c:out value="${e.value}"/> </c:forEach></p></c:if>
<form method="get" class="filter-form"><label class="filter-search">Tìm SKU / tên <input name="q" maxlength="150" value="<c:out value='${param.q}'/>"></label><c:if test="${not empty param.product}"><input type="hidden" name="product" value="<c:out value='${param.product}'/>"></c:if><label>Nhóm khách <select name="group"><option value="">Tất cả nhóm</option><c:forEach items="${groups}" var="g"><option value="${g.id}" ${param.group==g.id.toString() ? 'selected' : ''}><c:out value="${g.name}"/></option></c:forEach></select></label><label>Sửa từ ngày (Việt Nam) <input name="from" type="date" value="<c:out value='${param.from}'/>"></label><label>Sửa đến ngày (Việt Nam) <input name="to" type="date" value="<c:out value='${param.to}'/>"></label><input type="hidden" name="pageSize" value="${pagination.pageSize}"><button class="button button-primary">Lọc</button><a class="button button-secondary" href="${pageContext.request.contextPath}/pricing/history">Bỏ bộ lọc</a></form>
<div class="table-wrap"><table><thead><tr><th>SKU / sản phẩm</th><th>Nhóm khách</th><th>Thao tác</th><th>Giá bán cũ → mới (cơ sở)</th><th>Giá sàn cũ → mới</th><th>Ngày áp dụng trước → sau</th><th>Người sửa</th><th>Thời điểm sửa (VN)</th></tr></thead><tbody><c:forEach items="${history}" var="h"><tr><td><c:out value="${h.sku_snapshot}"/><br><c:out value="${h.product_name_snapshot}"/></td><td><c:out value="${h.group_name_snapshot}"/></td><td><c:out value="${h.event_label}"/></td><td><c:choose><c:when test="${h.old_selling==null}">—</c:when><c:otherwise><fmt:formatNumber value="${h.old_selling}" pattern="#,##0.####"/></c:otherwise></c:choose> → <c:choose><c:when test="${h.new_selling==null}">—</c:when><c:otherwise><fmt:formatNumber value="${h.new_selling}" pattern="#,##0.####"/></c:otherwise></c:choose></td><td><c:choose><c:when test="${h.old_floor==null}">—</c:when><c:otherwise><fmt:formatNumber value="${h.old_floor}" pattern="#,##0.####"/></c:otherwise></c:choose> → <c:choose><c:when test="${h.new_floor==null}">—</c:when><c:otherwise><fmt:formatNumber value="${h.new_floor}" pattern="#,##0.####"/></c:otherwise></c:choose></td><td><c:out value="${h.old_from}" default="—"/> – <c:out value="${h.old_to}" default="—"/><br>→ ${h.new_from} – ${h.new_to}</td><td><c:out value="${h.actor_name_snapshot}"/></td><td><c:out value="${h.display_time}"/></td></tr></c:forEach><c:if test="${empty history}"><tr><td colspan="8" class="empty-state">Chưa có lịch sử giá phù hợp được ghi nhận.</td></tr></c:if></tbody></table></div><%@ include file="../fragments/pagination.jspf" %></main></body></html>
