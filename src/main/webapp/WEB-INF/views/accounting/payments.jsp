<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %><fmt:setLocale value="vi_VN"/>
<!doctype html><html lang="vi"><head><meta name="viewport" content="width=device-width,initial-scale=1"><title>Phiếu thu</title><%@ include file="../fragments/assets.jspf" %><script defer src="${pageContext.request.contextPath}/assets/js/mvp-receipts.js"></script></head><body class="app-page" data-view="accounting/payments" data-ui-css="mvp"><%@ include file="../fragments/sidebar.jspf" %><%@ include file="../fragments/topbar.jspf" %><main class="page-body app-content catalog-page">
<div class="page-heading no-print"><div><h1>Phiếu thu</h1><p>Thu phần còn phải thu, tự đối trừ hóa đơn cũ nhất trước. Phiếu đã ghi chỉ đọc.</p></div></div><c:if test="${param.notice=='recorded'}"><p class="alert alert-success no-print" role="status">Đã ghi thu và phân bổ vào hóa đơn.</p></c:if><c:forEach items="${errors}" var="error"><p class="alert alert-error no-print" role="alert"><c:out value="${error.value}"/></p></c:forEach>
<c:if test="${not empty payment}"><section class="content-panel padded-panel"><h2>Phiếu thu <c:out value="${payment.number}"/></h2><p>Đại lý: <c:out value="${payment.dealer_code_snapshot}"/> — <c:out value="${payment.dealer_name_snapshot}"/></p><p>Địa chỉ: <c:out value="${payment.address_snapshot}"/></p><p>Ngày thu: ${payment.paid_date} · ${payment.method=='CASH'?'Tiền mặt':'Chuyển khoản'}</p><p>Số tiền thu: <strong><fmt:formatNumber value="${payment.amount}" pattern="#,##0.####"/> đ</strong></p><p>Ghi chú: <c:out value="${payment.note}"/></p><c:if test="${not empty payment.reversal}"><p>Phiếu đã được đảo toàn bộ bằng chứng từ <c:out value="${payment.reversal.number}"/>. Lý do: <c:out value="${payment.reversal.reason}"/></p></c:if>
<div class="table-wrap"><table><thead><tr><th>Hóa đơn</th><th>Thời điểm phân bổ</th><th>Điều chỉnh tiền</th></tr></thead><tbody><c:forEach items="${payment.allocations}" var="allocation"><tr><td><a href="${pageContext.request.contextPath}/accounting/invoices?id=${allocation.invoice_id}"><c:out value="${allocation.invoice_number}"/></a></td><td><c:out value="${allocation.occurred_at}"/></td><td><fmt:formatNumber value="${allocation.signed_amount}" pattern="#,##0.####"/> đ</td></tr></c:forEach></tbody></table></div><button type="button" class="button button-secondary no-print" data-print>In phiếu thu</button></section></c:if>
<c:if test="${not empty selectedDealer and access.allows('PAYMENT_WRITE')}"><section class="content-panel padded-panel no-print"><h2>Ghi thu · <c:out value="${selectedDealer.name}"/></h2><p>Còn phải thu: <strong><fmt:formatNumber value="${selectedDealer.outstanding}" pattern="#,##0.####"/> đ</strong>. Không thu vượt số còn thiếu.</p><form method="post"><input type="hidden" name="_csrf" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="action" value="record"><input type="hidden" name="dealer" value="${selectedDealer.id}"><input type="hidden" name="version" value="${selectedDealer.version}"><input type="hidden" name="requestKey" value="${requestKey}"><label class="field">Số tiền <input name="amount" type="number" min="0.0001" step="0.0001" max="${selectedDealer.outstanding}" required value="<c:out value='${form.amount}'/>"></label><label class="field">Ngày thu <input name="date" type="date" required value="<c:out value='${form.date}'/>"></label><label class="field">Hình thức <select name="method"><option value="CASH" ${form.method=='CASH'?'selected':''}>Tiền mặt</option><option value="BANK_TRANSFER" ${form.method=='BANK_TRANSFER'?'selected':''}>Chuyển khoản</option></select></label><label class="field">Ghi chú <textarea name="note" maxlength="1000"><c:out value="${form.note}"/></textarea></label><button class="button button-primary">Ghi phiếu thu và đối trừ hóa đơn</button></form></section></c:if>
<c:if test="${access.allows('PAYMENT_WRITE')}"><section class="content-panel padded-panel no-print"><h2>Đại lý còn phải thu</h2><div class="table-wrap"><table><thead><tr><th>Đại lý</th><th>Còn phải thu</th><th>Thu tiền</th></tr></thead><tbody><c:forEach items="${debtors}" var="dealer"><tr><td><c:out value="${dealer.code}"/> — <c:out value="${dealer.name}"/></td><td><fmt:formatNumber value="${dealer.outstanding}" pattern="#,##0.####"/> đ</td><td><a href="${pageContext.request.contextPath}/accounting/payments?dealer=${dealer.id}">Ghi thu</a></td></tr></c:forEach><c:if test="${empty debtors}"><tr><td colspan="3">Không có đại lý còn phải thu.</td></tr></c:if></tbody></table></div></section></c:if>
<section class="content-panel padded-panel no-print"><h2>Phiếu thu trong phạm vi</h2><div class="table-wrap"><table><thead><tr><th>Phiếu</th><th>Đại lý</th><th>Ngày thu</th><th>Số tiền</th><th>Trạng thái</th></tr></thead><tbody><c:forEach items="${payments}" var="item"><tr><td><a href="${pageContext.request.contextPath}/accounting/payments?id=${item.id}"><c:out value="${item.number}"/></a></td><td><c:out value="${item.dealer_name_snapshot}"/></td><td>${item.paid_date}</td><td><fmt:formatNumber value="${item.amount}" pattern="#,##0.####"/> đ</td><td>${empty item.reversal_id?'Hợp lệ':'Đã đảo toàn phiếu'}</td></tr></c:forEach><c:if test="${empty payments}"><tr><td colspan="5">Chưa có phiếu thu trong phạm vi.</td></tr></c:if></tbody></table></div></section>
<c:if test="${not empty payment and empty payment.reversal and access.allows('PAYMENT_WRITE')}"><section class="content-panel padded-panel no-print"><h2>Đảo toàn phiếu thu</h2><p>Ghi chứng từ đảo mới cho toàn bộ <fmt:formatNumber value="${payment.amount}" pattern="#,##0.####"/> đ; giữ phiếu gốc và lịch sử phân bổ. Công nợ được tính lại.</p><form method="post"><input type="hidden" name="_csrf" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="action" value="reverse"><input type="hidden" name="id" value="${payment.id}"><input type="hidden" name="version" value="${payment.version}"><input type="hidden" name="requestKey" value="${requestKey}"><label class="field">Lý do đảo <textarea name="reason" required maxlength="1000"><c:out value="${reversalReason}"/></textarea></label><button class="button button-secondary">Ghi chứng từ đảo toàn phiếu</button></form></section></c:if>
<c:if test="${not empty payment.reversal}"><section class="content-panel padded-panel"><h2>Chứng từ đảo <c:out value="${payment.reversal.number}"/></h2><p>Đảo toàn phiếu <c:out value="${payment.number}"/> · <fmt:formatNumber value="${payment.amount}" pattern="#,##0.####"/> đ</p><p>Ngày ghi: <c:out value="${payment.reversal.recorded_at}"/> · Lý do: <c:out value="${payment.reversal.reason}"/></p></section></c:if>
</main></body></html>
